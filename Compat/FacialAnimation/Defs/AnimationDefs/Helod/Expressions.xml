<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <FacialAnimation.FaceAnimationDef>
    <defName>HD_FA_HelodNormal</defName>
    <raceName>Helod</raceName>
    <animationFrames>
      <li>
        <duration>1</duration>
        <headShapeDef>normal</headShapeDef>
        <browShapeDef>normal</browShapeDef>
        <lidShapeDef>normal</lidShapeDef>
        <lidOptionShapeDef>normal</lidOptionShapeDef>
        <eyeballShapeDef>normal</eyeballShapeDef>
        <mouthShapeDef>normal</mouthShapeDef>
        <emotionShapeDef>normal</emotionShapeDef>
      </li>
    </animationFrames>
    <priority>0</priority>
  </FacialAnimation.FaceAnimationDef>

  <!-- Constant idle animations. Without these, the face only changes when one
       of the mood, pain, thought, or job conditions below is active. -->
  <FacialAnimation.FaceAnimationDef>
    <defName>HD_FA_HelodEyeMoveLeft</defName>
    <raceName>Helod</raceName>
    <animationFrames>
      <li>
        <duration>15</duration>
        <eyeballOffset>(-0.01,0,0)</eyeballOffset>
      </li>
    </animationFrames>
    <roopIntervalMin>30</roopIntervalMin>
    <roopIntervalMax>500</roopIntervalMax>
    <priority>1002</priority>
  </FacialAnimation.FaceAnimationDef>

  <FacialAnimation.FaceAnimationDef>
    <defName>HD_FA_HelodEyeMoveRight</defName>
    <raceName>Helod</raceName>
    <animationFrames>
      <li>
        <duration>15</duration>
        <eyeballOffset>(0.01,0,0)</eyeballOffset>
      </li>
    </animationFrames>
    <roopIntervalMin>30</roopIntervalMin>
    <roopIntervalMax>500</roopIntervalMax>
    <priority>1001</priority>
  </FacialAnimation.FaceAnimationDef>

  <FacialAnimation.FaceAnimationDef>
    <defName>HD_FA_HelodBlink</defName>
    <raceName>Helod</raceName>
    <animationFrames>
      <li>
        <duration>3</duration>
        <browOffset>(0,0,-0.005)</browOffset>
        <lidOffset>(0,0,-0.005)</lidOffset>
      </li>
      <li>
        <duration>1</duration>
        <browOffset>(0,0,-0.0075)</browOffset>
        <lidShapeDef>half</lidShapeDef>
      </li>
      <li>
        <duration>9</duration>
        <browOffset>(0,0,-0.01)</browOffset>
        <lidShapeDef>close</lidShapeDef>
      </li>
      <li>
        <duration>2</duration>
        <browOffset>(0,0,-0.0075)</browOffset>
        <lidShapeDef>half</lidShapeDef>
      </li>
      <li>
        <duration>3</duration>
        <browOffset>(0,0,-0.005)</browOffset>
        <lidOffset>(0,0,-0.005)</lidOffset>
      </li>
    </animationFrames>
    <roopIntervalMin>30</roopIntervalMin>
    <roopIntervalMax>500</roopIntervalMax>
    <priority>1000</priority>
  </FacialAnimation.FaceAnimationDef>

