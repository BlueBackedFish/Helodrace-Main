{
  "CE": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<Patch>\n  <Operation Class=\"PatchOperationFindMod\">\n    <mods>\n      <li>Combat Extended</li>\n    </mods>\n    <match Class=\"PatchOperationSequence\">\n      <operations>\n\n        <!-- Helod race integration: CE hit profile, suppression, ammo and melee tools. -->\n        <li Class=\"PatchOperationAddModExtension\">\n          <xpath>/Defs/ThingDef[defName=\"Helod\"]</xpath>\n          <value>\n            <li Class=\"CombatExtended.RacePropertiesExtensionCE\">\n              <bodyShape>Humanoid</bodyShape>\n            </li>\n          </value>\n        </li>\n\n        <li Class=\"PatchOperationConditional\">\n          <xpath>/Defs/ThingDef[defName=\"Helod\"]/comps</xpath>\n          <nomatch Class=\"PatchOperationAdd\">\n            <xpath>/Defs/ThingDef[defName=\"Helod\"]</xpath>\n            <value>\n              <comps />\n            </value>\n          </nomatch>\n        </li>\n\n        <li Class=\"PatchOperationAdd\">\n          <xpath>/Defs/ThingDef[defName=\"Helod\"]/comps</xpath>\n          <value>\n            <li>\n              <compClass>CombatExtended.CompPawnGizmo</compClass>\n            </li>\n            <li Class=\"CombatExtended.CompProperties_Suppressable\" />\n            <li>\n              <compClass>CombatExtended.CompAmmoGiver</compClass>\n            </li>\n          </value>\n        </li>\n\n        <li Class=\"PatchOperationAdd\">\n          <xpath>/Defs/ThingDef[defName=\"Helod\"]/statBases</xpath>\n          <value>\n            <MeleeCritChance>1.0</MeleeCritChance>\n            <MeleeParryChance>1.0</MeleeParryChance>\n            <Suppressability>1.0</Suppressability>\n          </value>\n        </li>\n\n        <li Class=\"PatchOperationReplace\">\n          <xpath>/Defs/ThingDef[defName=\"Helod\"]/tools</xpath>\n          <value>\n            <tools>\n              <li Class=\"CombatExtended.ToolCE\">\n                <label>left fist</label>\n                <capacities>\n                  <li>Blunt</li>\n                </capacities>\n                <power>8.2</power>\n                <cooldownTime>2.0</cooldownTime>\n                <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>\n                <armorPenetrationBlunt>2.0</armorPenetrationBlunt>\n                <surpriseAttack>\n                  <extraMeleeDamages>\n                    <li>\n                      <def>Stun</def>\n                      <amount>14</amount>\n                    </li>\n                  </extraMeleeDamages>\n                </surpriseAttack>\n              </li>\n              <li Class=\"CombatExtended.ToolCE\">\n                <label>right fist</label>\n                <capacities>\n                  <li>Blunt</li>\n                </capacities>\n                <power>8.2</power>\n                <cooldownTime>2.0</cooldownTime>\n                <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>\n                <armorPenetrationBlunt>2.0</armorPenetrationBlunt>\n                <surpriseAttack>\n                  <extraMeleeDamages>\n                    <li>\n                      <def>Stun</def>\n                      <amount>14</amount>\n                    </li>\n                  </extraMeleeDamages>\n                </surpriseAttack>\n              </li>\n              <li Class=\"CombatExtended.ToolCE\">\n                <label>teeth</label>\n                <capacities>\n                  <li>Bite</li>\n                </capacities>\n                <power>12.0</power>\n                <cooldownTime>2.6</cooldownTime>\n                <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>\n                <armorPenetrationSharp>1.5</armorPenetrationSharp>\n                <armorPenetrationBlunt>2.5</armorPenetrationBlunt>\n                <chanceFactor>0.4</chanceFactor>\n                <surpriseAttack>\n                  <extraMeleeDamages>\n                    <li>\n                      <def>Bite</def>\n                      <amount>18</amount>\n                    </li>\n                  </extraMeleeDamages>\n                </surpriseAttack>\n              </li>\n            </tools>\n          </value>\n        </li>\n\n        <!-- Modern IOTV Gen4 assault configuration. -->\n        <li Class=\"PatchOperationAdd\">\n          <xpath>/Defs/ThingDef[defName=\"HD_Apparel_IBTVAssault\"]/statBases</xpath>\n          <value>\n            <Bulk>8.5</Bulk>\n            <WornBulk>3.5</WornBulk>\n          </value>\n        </li>\n        <li Class=\"PatchOperationReplace\">\n          <xpath>/Defs/ThingDef[defName=\"HD_Apparel_IBTVAssault\"]/statBases/ArmorRating_Sharp</xpath>\n          <value><ArmorRating_Sharp>14.5</ArmorRating_Sharp></value>\n        </li>\n        <li Class=\"PatchOperationReplace\">\n          <xpath>/Defs/ThingDef[defName=\"HD_Apparel_IBTVAssault\"]/statBases/ArmorRating_Blunt</xpath>\n          <value><ArmorRating_Blunt>26</ArmorRating_Blunt></value>\n        </li>\n        <li Class=\"PatchOperationReplace\">\n          <xpath>/Defs/ThingDef[defName=\"HD_Apparel_IBTVAssault\"]/statBases/ArmorRating_Heat</xpath>\n          <value><ArmorRating_Heat>0.36</ArmorRating_Heat></value>\n        </li>\n        <li Class=\"PatchOperationRemove\">\n          <xpath>/Defs/ThingDef[defName=\"HD_Apparel_IBTVAssault\"]/equippedStatOffsets/MoveSpeed</xpath>\n        </li>\n\n        <!-- Fixed-material steel M1 helmet. -->\n        <li Class=\"PatchOperationAdd\">\n          <xpath>/Defs/ThingDef[defName=\"HD_Apparel_GreatWarM1Helmet\"]/statBases</xpath>\n          <value>\n            <Bulk>3</Bulk>\n            <WornBulk>1</WornBulk>\n          </value>\n        </li>\n        <li Class=\"PatchOperationReplace\">\n          <xpath>/Defs/ThingDef[defName=\"HD_Apparel_GreatWarM1Helmet\"]/statBases/ArmorRating_Sharp</xpath>\n          <value><ArmorRating_Sharp>1.8</ArmorRating_Sharp></value>\n        </li>\n        <li Class=\"PatchOperationReplace\">\n          <xpath>/Defs/ThingDef[defName=\"HD_Apparel_GreatWarM1Helmet\"]/statBases/ArmorRating_Blunt</xpath>\n          <value><ArmorRating_Blunt>2.7</ArmorRating_Blunt></value>\n        </li>\n        <li Class=\"PatchOperationReplace\">\n          <xpath>/Defs/ThingDef[defName=\"HD_Apparel_GreatWarM1Helmet\"]/statBases/ArmorRating_Heat</xpath>\n          <value><ArmorRating_Heat>0.10</ArmorRating_Heat></value>\n        </li>\n\n        <!-- Reinforced trench coat, comparable to early fragmentation clothing. -->\n        <li Class=\"PatchOperationAdd\">\n          <xpath>/Defs/ThingDef[defName=\"HD_Apparel_GreatWarTrenchArmyOuter\"]/statBases</xpath>\n          <value>\n            <Bulk>5</Bulk>\n            <WornBulk>2.5</WornBulk>\n          </value>\n        </li>\n        <li Class=\"PatchOperationReplace\">\n          <xpath>/Defs/ThingDef[defName=\"HD_Apparel_GreatWarTrenchArmyOuter\"]/statBases/ArmorRating_Sharp</xpath>\n          <value><ArmorRating_Sharp>2.0</ArmorRating_Sharp></value>\n        </li>\n        <li Class=\"PatchOperationReplace\">\n          <xpath>/Defs/ThingDef[defName=\"HD_Apparel_GreatWarTrenchArmyOuter\"]/statBases/ArmorRating_Blunt</xpath>\n          <value><ArmorRating_Blunt>1.5</ArmorRating_Blunt></value>\n        </li>\n\n        <!-- Crude rolled-steel torso plate. -->\n        <li Class=\"PatchOperationAdd\">\n          <xpath>/Defs/ThingDef[defName=\"HD_WildWestMetalVest\"]/statBases</xpath>\n          <value>\n            <Bulk>5</Bulk>\n            <WornBulk>3</WornBulk>\n          </value>\n        </li>\n        <li Class=\"PatchOperationReplace\">\n          <xpath>/Defs/ThingDef[defName=\"HD_WildWestMetalVest\"]/statBases/ArmorRating_Sharp</xpath>\n          <value><ArmorRating_Sharp>4.0</ArmorRating_Sharp></value>\n        </li>\n        <li Class=\"PatchOperationReplace\">\n          <xpath>/Defs/ThingDef[defName=\"HD_WildWestMetalVest\"]/statBases/ArmorRating_Blunt</xpath>\n          <value><ArmorRating_Blunt>6.0</ArmorRating_Blunt></value>\n        </li>\n        <li Class=\"PatchOperationReplace\">\n          <xpath>/Defs/ThingDef[defName=\"HD_WildWestMetalVest\"]/statBases/ArmorRating_Heat</xpath>\n          <value><ArmorRating_Heat>0.10</ArmorRating_Heat></value>\n        </li>\n\n      </operations>\n    </match>\n  </Operation>\n</Patch>",
  "Facial": "<?xml version=\"1.0\" encoding=\"utf-8\" ?>\n<Patch>\n  <Operation Class=\"PatchOperationSequence\">\n    <success>Normal</success>\n    <operations>\n      <li Class=\"PatchOperationConditional\">\n        <xpath>/Defs/ThingDef[defName=\"Helod\"]/comps</xpath>\n        <nomatch Class=\"PatchOperationAdd\">\n          <xpath>/Defs/ThingDef[defName=\"Helod\"]</xpath>\n          <value>\n            <comps>\n              <li><compClass>FacialAnimation.DrawFaceGraphicsComp</compClass></li>\n              <li><compClass>FacialAnimation.HeadControllerComp</compClass></li>\n              <li><compClass>FacialAnimation.EyeballControllerComp</compClass></li>\n              <li><compClass>FacialAnimation.LidControllerComp</compClass></li>\n              <li><compClass>FacialAnimation.BrowControllerComp</compClass></li>\n              <li><compClass>FacialAnimation.MouthControllerComp</compClass></li>\n              <!-- SkinControllerComp remains disabled until Helod skin overlay defs and textures exist. -->\n              <!-- <li><compClass>FacialAnimation.SkinControllerComp</compClass></li> -->\n              <li><compClass>FacialAnimation.LidOptionControllerComp</compClass></li>\n              <li><compClass>FacialAnimation.EmotionControllerComp</compClass></li>\n              <li><compClass>FacialAnimation.FacialAnimationControllerComp</compClass></li>\n              <li Class=\"HelodraceFacial.Normal0PairCompProperties\">\n                <!-- 0.05 = 5% chance for the paired Lid Normal0 + Mouth Normal0 variant. -->\n                <chance>0.05</chance>\n              </li>\n            </comps>\n          </value>\n        </nomatch>\n        <match Class=\"PatchOperationAdd\">\n          <xpath>/Defs/ThingDef[defName=\"Helod\"]/comps</xpath>\n          <value>\n            <li><compClass>FacialAnimation.DrawFaceGraphicsComp</compClass></li>\n            <li><compClass>FacialAnimation.HeadControllerComp</compClass></li>\n            <li><compClass>FacialAnimation.EyeballControllerComp</compClass></li>\n            <li><compClass>FacialAnimation.LidControllerComp</compClass></li>\n            <li><compClass>FacialAnimation.BrowControllerComp</compClass></li>\n            <li><compClass>FacialAnimation.MouthControllerComp</compClass></li>\n            <!-- SkinControllerComp remains disabled until Helod skin overlay defs and textures exist. -->\n            <!-- <li><compClass>FacialAnimation.SkinControllerComp</compClass></li> -->\n            <li><compClass>FacialAnimation.LidOptionControllerComp</compClass></li>\n            <li><compClass>FacialAnimation.EmotionControllerComp</compClass></li>\n            <li><compClass>FacialAnimation.FacialAnimationControllerComp</compClass></li>\n            <li Class=\"HelodraceFacial.Normal0PairCompProperties\">\n              <!-- 0.05 = 5% chance for the paired Lid Normal0 + Mouth Normal0 variant. -->\n              <chance>0.05</chance>\n            </li>\n          </value>\n        </match>\n      </li>\n    </operations>\n  </Operation>\n</Patch>"
}
