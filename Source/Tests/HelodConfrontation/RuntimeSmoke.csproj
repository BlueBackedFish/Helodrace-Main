<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>HelodConfrontationSmoke</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <HelodAssembly Condition="'$(HelodAssembly)' == ''">../../../Assemblies/Helodrace.dll</HelodAssembly>
    <HelodUsesGame>true</HelodUsesGame>
    <HelodUsesHarmony>true</HelodUsesHarmony>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="RuntimeSmoke.cs" />
    <Reference Include="$(HelodAssembly)">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>