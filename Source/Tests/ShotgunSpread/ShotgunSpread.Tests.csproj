<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RimWorldPath Condition="'$(RimWorldPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldPath>
    <HelodUsesGame>true</HelodUsesGame>
    <HelodUsesHarmony>true</HelodUsesHarmony>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Helodrace/Core/Shotgun*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../Helodrace/Core/Projectile_ShotgunPellet.cs" Link="Projectile_ShotgunPellet.cs" />
    <Compile Include="../../Helodrace/Core/Verb_ShootShotgun.cs" Link="Verb_ShootShotgun.cs" />
  </ItemGroup>
</Project>