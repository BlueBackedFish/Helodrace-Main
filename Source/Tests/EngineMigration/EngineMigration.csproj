<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Helodrace.EngineMigrationChecks</AssemblyName>
    <HelodUsesGame>true</HelodUsesGame>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <BlancasRepository Condition="'$(BlancasRepository)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\Helodrace-blancasdrugs</BlancasRepository>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="HelodBlancasDrug"><HintPath>$(BlancasRepository)/1.7/Assemblies/HelodBlancasDrug.dll</HintPath><Private>false</Private></Reference>
    <Compile Include="$(BlancasRepository)/Tests/ExclusiveGroup/LegacyExclusiveGroup.cs" Link="BlancasLegacyExclusiveGroup.cs" />
  </ItemGroup>
</Project>
