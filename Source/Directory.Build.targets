<Project>
  <ItemGroup Condition="'$(HelodUsesGame)' == 'true'">
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldReferencePath)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(RimWorldReferencePath)\UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith"><HintPath>$(RimWorldReferencePath)\Waylith.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(HelodUsesHarmony)' == 'true'">
    <Reference Include="0Harmony"><HintPath>$(HarmonyAssemblyPath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(HelodUsesGame)' == 'true' Or '$(HelodUsesHarmony)' == 'true'">
    <AssemblyMetadata Include="Helodrace.GameRoot" Value="$(RimWorldPath)" />
    <AssemblyMetadata Include="Helodrace.HarmonyAssembly" Value="$(HarmonyAssemblyPath)" />
    <Compile Include="$(MSBuildThisFileDirectory)Tests\GameRuntime.cs" Link="GameRuntime.cs" Condition="'$(OutputType)' == 'Exe'" />
  </ItemGroup>
  <Target Name="RequireRimWorld17References" BeforeTargets="ResolveReferences" Condition="'$(HelodUsesGame)' == 'true'">
    <Error Condition="!Exists('$(RimWorldReferencePath)\Assembly-CSharp.dll') Or !Exists('$(RimWorldReferencePath)\UnityStubs.dll') Or !Exists('$(RimWorldReferencePath)\Waylith.dll')" Text="RimWorld 1.7 is required. Set RimWorldPath to the installed game or RimWorldReferencePath to the pinned $(RimWorldReferenceVersion) reference directory." />
    <Error Condition="'$(HelodUsesHarmony)' == 'true' And !Exists('$(HarmonyAssemblyPath)')" Text="Install Harmony for RimWorld 1.7 or set HarmonyAssemblyPath to its Harmony 3 assembly." />
  </Target>
</Project>
