<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <JoyKindDef>
    <defName>HD_TargetShooting</defName>
    <label>target shooting</label>
  </JoyKindDef>
  <JoyKindDef>
    <defName>HD_OutdoorHunting</defName>
    <label>outdoor hunting</label>
  </JoyKindDef>
  <ThingDef ParentName="BuildingBase">
    <defName>HD_ClayTrap</defName>
    <label>clay shooting trap</label>
    <description>A compact spring-powered clay-target launcher for outdoor shooting recreation. It supplies its own practice targets. Equip a single-shot bullet-firing gun and leave fourteen tiles clear in front of the launcher.</description>
    <thingClass>Helodrace.Building_ClayTrap</thingClass>
    <graphicData>
      <texPath>Buildings/HD_ClayTrap</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <color>(255,255,255)</color>
      <colorTwo>(105,105,105)</colorTwo>
      <drawSize>(1.5,1.5)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <rotatable>true</rotatable>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>40</pathCost>
    <fillPercent>0.4</fillPercent>
    <tickerType>Normal</tickerType>
    <designationCategory>Joy</designationCategory>
    <uiOrder>2520</uiOrder>
    <building>
      <joyKind>HD_TargetShooting</joyKind>
    </building>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>2200</WorkToBuild>
      <Mass>45</Mass>
      <Flammability>0.2</Flammability>
      <Beauty>1</Beauty>
    </statBases>
    <costList>
      <Steel>70</Steel>
      <HD_GeneralMachinePart>2</HD_GeneralMachinePart>
    </costList>
  </ThingDef>
  <ThingDef>
    <defName>HD_ClayPigeonFlying</defName>
    <label>flying clay pigeon</label>
    <thingClass>Helodrace.Thing_ClayPigeon</thingClass>
    <category>Item</category>
    <graphicData>
      <texPath>Items/HD_ClayPigeon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.4,0.4)</drawSize>
    </graphicData>
    <altitudeLayer>Projectile</altitudeLayer>
    <drawerType>RealtimeOnly</drawerType>
    <tickerType>Normal</tickerType>
    <selectable>false</selectable>
    <useHitPoints>true</useHitPoints>
    <rotatable>false</rotatable>
    <fillPercent>0.5</fillPercent>
    <statBases>
      <MaxHitPoints>1</MaxHitPoints>
      <Mass>0.1</Mass>
      <Flammability>0</Flammability>
    </statBases>
  </ThingDef>
  <JobDef>
    <defName>HD_ClayShooting</defName>
    <driverClass>Helodrace.JobDriver_ClayShooting</driverClass>
    <reportString>shooting clay pigeons.</reportString>
    <joyDuration>3000</joyDuration>
    <joyMaxParticipants>1</joyMaxParticipants>
    <joyKind>HD_TargetShooting</joyKind>
  </JobDef>
  <JobDef>
    <defName>HD_RecreationalHunt</defName>
    <driverClass>Helodrace.JobDriver_RecreationalHunt</driverClass>
    <reportString>tracking TargetA for recreation.</reportString>
    <joyDuration>24000</joyDuration>
    <joyMaxParticipants>1</joyMaxParticipants>
    <joyKind>HD_OutdoorHunting</joyKind>
  </JobDef>
  <JoyGiverDef>
    <defName>HD_ClayShooting</defName>
    <giverClass>Helodrace.JoyGiver_ClayShooting</giverClass>
    <baseChance>2</baseChance>
    <thingDefs>
      <li>HD_ClayTrap</li>
    </thingDefs>
    <jobDef>HD_ClayShooting</jobDef>
    <joyKind>HD_TargetShooting</joyKind>
    <requiresEnjoyOutdoors>true</requiresEnjoyOutdoors>
    <requiredCapacities>
      <li>Sight</li>
      <li>Manipulation</li>
      <li>Moving</li>
    </requiredCapacities>
  </JoyGiverDef>
  <JoyGiverDef>
    <defName>HD_RecreationalHunt</defName>
    <giverClass>Helodrace.JoyGiver_RecreationalHunt</giverClass>
    <baseChance>1</baseChance>
    <jobDef>HD_RecreationalHunt</jobDef>
    <joyKind>HD_OutdoorHunting</joyKind>
    <requiresEnjoyOutdoors>true</requiresEnjoyOutdoors>
    <requiredCapacities>
      <li>Sight</li>
      <li>Manipulation</li>
      <li>Moving</li>
    </requiredCapacities>
  </JoyGiverDef>
</Defs>