<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase" Name="HD_WallPanelBase" Abstract="True">
    <thingClass>Helodrace.Panels.Building_WallPanel</thingClass>
    <category>Building</category>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <passability>Standable</passability>
    <drawerType>RealtimeOnly</drawerType>
    <rotatable>true</rotatable>
    <!-- Selected and removed through the support's panel layer window. -->
    <selectable>false</selectable>
    <tickerType>Never</tickerType>
    <fillPercent>0</fillPercent>
    <designationCategory>Structure</designationCategory>
    <!-- Drag a run of linings along a wall; every cell keeps the chosen face. -->
    <drawStyleCategory>Walls</drawStyleCategory>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <drawPlaceWorkersWhileInstallBlueprintSelected>true</drawPlaceWorkersWhileInstallBlueprintSelected>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <useHitPoints>true</useHitPoints>
    <size>(1,1)</size>
    <statBases>
      <WorkToBuild>120</WorkToBuild>
      <Mass>4</Mass>
      <Beauty>0</Beauty>
    </statBases>
    <building>
      <isEdifice>false</isEdifice>
      <isInert>true</isInert>
      <canPlaceOverWall>true</canPlaceOverWall>
    </building>
    <placeWorkers>
      <li>Helodrace.Panels.PlaceWorker_WallPanel</li>
    </placeWorkers>
    <comps>
      <li Class="Helodrace.Panels.CompProperties_PanelAnchor" />
    </comps>
  </ThingDef>
  <ThingDef ParentName="HD_WallPanelBase">
    <defName>HD_Panel_MineralWool</defName>
    <label>mineral wool panel</label>
    <description>A mineral-fiber mat enclosed in a thin protective skin.</description>
    <uiIconPath>Buildings/WallPanels/HD_Panel_MineralWool_MenuIcon</uiIconPath>
    <uiOrder>2110</uiOrder>
    <graphicData>
      <texPath>Buildings/WallPanels/Overlay/HD_Panel_MineralWool_SandwichFull</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.5,1.5)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <costList>
      <BlocksGranite>3</BlocksGranite>
      <HD_AluminiumAlloy>1</HD_AluminiumAlloy>
    </costList>
    <modExtensions>
      <li Class="Helodrace.Panels.WallPanelProperties">
        <wallHostGraphic>
          <texPath>Buildings/WallPanels/Overlay/HD_Panel_MineralWool_Wall</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>(1.5,1.5)</drawSize>
        </wallHostGraphic>
        <doorHostGraphic>
          <texPath>Buildings/WallPanels/Overlay/HD_Panel_MineralWool_Door</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>(1.5,1.5)</drawSize>
        </doorHostGraphic>
        <slot>Insulation</slot>
        <thermalResistance>3</thermalResistance>
        <ignitionMultiplier>0.1</ignitionMultiplier>
        <flameMultiplier>0.35</flameMultiplier>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="HD_WallPanelBase">
    <defName>HD_Panel_Styrofoam</defName>
    <label>expanded foam panel</label>
    <description>A light slab of expanded polystyrene. Its combustible core releases toxic smoke when it burns.</description>
    <uiIconPath>Buildings/WallPanels/HD_Panel_Styrofoam_MenuIcon</uiIconPath>
    <uiOrder>2111</uiOrder>
    <graphicData>
      <texPath>Buildings/WallPanels/Overlay/HD_Panel_Styrofoam_SandwichFull</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.5,1.5)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>1.5</Flammability>
    </statBases>
    <costList>
      <HD_ExpandedPolystyrene>4</HD_ExpandedPolystyrene>
    </costList>
    <modExtensions>
      <li Class="Helodrace.Panels.WallPanelProperties">
        <wallHostGraphic>
          <texPath>Buildings/WallPanels/Overlay/HD_Panel_Styrofoam_Wall</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>(1.5,1.5)</drawSize>
        </wallHostGraphic>
        <doorHostGraphic>
          <texPath>Buildings/WallPanels/Overlay/HD_Panel_Styrofoam_Door</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>(1.5,1.5)</drawSize>
        </doorHostGraphic>
        <slot>Insulation</slot>
        <thermalResistance>5</thermalResistance>
        <ignitionMultiplier>1.5</ignitionMultiplier>
        <flameMultiplier>1</flameMultiplier>
      </li>
    </modExtensions>
    <tickerType>Rare</tickerType>
    <comps>
      <li Class="Helodrace.Panels.CompProperties_PolymerCore">
        <burnTicks>1800</burnTicks>
        <totalSmoke>24</totalSmoke>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="HD_WallPanelBase">
    <defName>HD_Panel_RHA</defName>
    <label>rolled armor panel</label>
    <description>A thick rolled steel facing held by anchor brackets.</description>
    <uiIconPath>Buildings/WallPanels/HD_Panel_RHA_MenuIcon</uiIconPath>
    <uiOrder>2112</uiOrder>
    <graphicData>
      <texPath>Buildings/WallPanels/Overlay/HD_Panel_RHA_SandwichFull</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.5,1.5)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>350</MaxHitPoints>
      <Flammability>0</Flammability>
      <Mass>63</Mass>
    </statBases>
    <costList>
      <HD_UniformRolledSteelPlate>21</HD_UniformRolledSteelPlate>
    </costList>
    <modExtensions>
      <li Class="Helodrace.Panels.WallPanelProperties">
        <wallHostGraphic>
          <texPath>Buildings/WallPanels/Overlay/HD_Panel_RHA_Wall</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>(1.5,1.5)</drawSize>
        </wallHostGraphic>
        <doorHostGraphic>
          <texPath>Buildings/WallPanels/Overlay/HD_Panel_RHA_Door</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>(1.5,1.5)</drawSize>
        </doorHostGraphic>
        <slot>Reinforcement</slot>
        <thermalResistance>0</thermalResistance>
        <ignitionMultiplier>0.25</ignitionMultiplier>
        <flameMultiplier>0.9</flameMultiplier>
        <armorMaterial>HD_Armor_RHA</armorMaterial>
        <armorThicknessMeters>.008</armorThicknessMeters>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="HD_WallPanelBase">
    <defName>HD_Panel_Aramid</defName>
    <label>aramid reinforcement panel</label>
    <description>Layers of golden aramid fabric bonded into a tough backing panel.</description>
    <uiIconPath>Buildings/WallPanels/HD_Panel_Aramid_MenuIcon</uiIconPath>
    <uiOrder>2113</uiOrder>
    <graphicData>
      <texPath>Buildings/WallPanels/Overlay/HD_Panel_Aramid_SandwichFull</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.5,1.5)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <Flammability>0.2</Flammability>
    </statBases>
    <costList>
      <HD_Aramid>12</HD_Aramid>
    </costList>
    <modExtensions>
      <li Class="Helodrace.Panels.WallPanelProperties">
        <wallHostGraphic>
          <texPath>Buildings/WallPanels/Overlay/HD_Panel_Aramid_Wall</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>(1.5,1.5)</drawSize>
        </wallHostGraphic>
        <doorHostGraphic>
          <texPath>Buildings/WallPanels/Overlay/HD_Panel_Aramid_Door</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>(1.5,1.5)</drawSize>
        </doorHostGraphic>
        <slot>Reinforcement</slot>
        <thermalResistance>0</thermalResistance>
        <aramid>true</aramid>
        <ignitionMultiplier>0.5</ignitionMultiplier>
        <flameMultiplier>0.75</flameMultiplier>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="HD_WallPanelBase">
    <defName>HD_Panel_EMI</defName>
    <label>electromagnetic shielding panel</label>
    <description>An unperforated aluminium lining with overlapping conductive joints.</description>
    <uiIconPath>Buildings/WallPanels/HD_Panel_EMI_MenuIcon</uiIconPath>
    <uiOrder>2114</uiOrder>
    <graphicData>
      <texPath>Buildings/WallPanels/Overlay/HD_Panel_EMI_SandwichFull</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.5,1.5)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <costList>
      <HD_AluminiumAlloy>3</HD_AluminiumAlloy>
    </costList>
    <modExtensions>
      <li Class="Helodrace.Panels.WallPanelProperties">
        <wallHostGraphic>
          <texPath>Buildings/WallPanels/Overlay/HD_Panel_EMI_Wall</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>(1.5,1.5)</drawSize>
        </wallHostGraphic>
        <doorHostGraphic>
          <texPath>Buildings/WallPanels/Overlay/HD_Panel_EMI_Door</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>(1.5,1.5)</drawSize>
        </doorHostGraphic>
        <slot>Shielding</slot>
        <thermalResistance>0</thermalResistance>
        <electromagneticShielding>true</electromagneticShielding>
        <ignitionMultiplier>0.25</ignitionMultiplier>
        <flameMultiplier>0.9</flameMultiplier>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="Wall">
    <defName>HD_Building_StyrofoamSandwichWall</defName>
    <label>sandwich panel wall</label>
    <description>A lightweight wall assembled from metal-faced polystyrene panels. The foam core gives off dense toxic smoke when it burns.</description>
    <thingClass>Helodrace.Panels.Building_SandwichPanelWall</thingClass>
    <costStuffCount>0</costStuffCount>
    <useStuffTerrainAffordance>false</useStuffTerrainAffordance>
    <uiIconPath>Buildings/WallPanels/HD_SandwichWall_MenuIcon</uiIconPath>
    <uiOrder>2100</uiOrder>
    <stuffCategories Inherit="False" />
    <uiIconPathsStuff Inherit="False" />
    <graphicData Inherit="False">
      <texPath>Buildings/WallPanels/HD_SandwichWall_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>Basic</linkType>
      <linkFlags>
        <li>Wall</li>
        <li>Rock</li>
      </linkFlags>
    </graphicData>
    <statBases>
      <MaxHitPoints>220</MaxHitPoints>
      <WorkToBuild>33.75</WorkToBuild>
      <Flammability>1.5</Flammability>
      <Mass>8</Mass>
    </statBases>
    <costList>
      <HD_ExpandedPolystyrene>6</HD_ExpandedPolystyrene>
      <HD_AluminiumAlloy>2</HD_AluminiumAlloy>
    </costList>
    <building>
      <!-- Inherited from Wall, isStuffableAirtight reads the construction stuff,
           which this wall does not have; the info card then crashed. -->
      <isStuffableAirtight>false</isStuffableAirtight>
      <isAirtight>true</isAirtight>
    </building>
    <tickerType>Rare</tickerType>
    <comps>
      <li Class="Helodrace.Panels.CompProperties_PolymerCore">
        <burnTicks>3000</burnTicks>
        <totalSmoke>72</totalSmoke>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="ResourceBase">
    <defName>HD_ExpandedPolystyrene</defName>
    <label>expanded polystyrene</label>
    <description>Light rigid foam used as an insulating core. It produces toxic smoke when it burns.</description>
    <stackLimit>150</stackLimit>
    <burnableByRecipe>true</burnableByRecipe>
    <graphicData>
      <texPath>Items/HD_ExpandedPolystyrene</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <Mass>0.05</Mass>
      <MarketValue>1.8</MarketValue>
      <Flammability>1.5</Flammability>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <tickerType>Rare</tickerType>
    <comps>
      <li Class="Helodrace.Panels.CompProperties_PolymerCore">
        <burnTicks>1800</burnTicks>
        <totalSmoke>24</totalSmoke>
      </li>
    </comps>
  </ThingDef>
  <RecipeDef>
    <defName>HD_MakeExpandedPolystyrene</defName>
    <label>make expanded polystyrene</label>
    <description>Produce expanded polymer foam from refined petrochemical feedstock.</description>
    <jobString>Making expanded polystyrene.</jobString>
    <workAmount>1800</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <requiredGiverWorkType>Crafting</requiredGiverWorkType>
    <researchPrerequisite>HelodColdWarTech</researchPrerequisite>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>HD_AromaticBaseOil</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Chemfuel</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>HD_AromaticBaseOil</li>
        <li>Chemfuel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <HD_ExpandedPolystyrene>20</HD_ExpandedPolystyrene>
    </products>
    <recipeUsers>
      <li>HD_StirredTankReactor</li>
    </recipeUsers>
  </RecipeDef>
</Defs>
