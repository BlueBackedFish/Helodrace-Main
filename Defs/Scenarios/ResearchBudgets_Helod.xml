<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Base-game research budgets for Helod scenarios, which carry HD_ResearchTechBaseline.
       Each linked base-game project costs the Helod knowledge its link grants, so neither
       tree is a shortcut. Unlinked base-game projects keep their base-game cost.
       Generated by Source/Analysis/ResearchMedieval/research_rebalance.py.
       Other scenarios keep the costs loaded from the base game. -->
  <Helodrace.HelodScenarioResearchBudgetDef>
    <defName>HD_HelodScenarioResearchBudget</defName>
    <baseCosts>
      <AirConditioning>700</AirConditioning>
      <BlowbackOperation>1700</BlowbackOperation>
      <DeepDrilling>1700</DeepDrilling>
      <Electricity>8200</Electricity>
      <FlakArmor>7900</FlakArmor>
      <GasOperation>2100</GasOperation>
      <Gunsmithing>3200</Gunsmithing>
      <Machining>1800</Machining>
      <MedicineProduction>4000</MedicineProduction>
      <MicroelectronicsBasics>3200</MicroelectronicsBasics>
      <Mortars>7700</Mortars>
      <MultibarrelWeapons>17000</MultibarrelWeapons>
      <PrecisionRifling>9700</PrecisionRifling>
      <SterileMaterials>5100</SterileMaterials>
      <ToxGas MayRequire="Ludeon.RimWorld.Biotech">5200</ToxGas>
    </baseCosts>
  </Helodrace.HelodScenarioResearchBudgetDef>
</Defs>
