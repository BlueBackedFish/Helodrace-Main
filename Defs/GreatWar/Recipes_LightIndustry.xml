<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <RecipeDef>
    <defName>HD_ExtractAlumina</defName>
    <label>extract alumina from slate blocks</label>
    <description>Leach aluminous slate and calcine the recovered material into alumina.</description>
    <jobString>Processing industrial minerals.</jobString>
    <workAmount>4000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <requiredGiverWorkType>Crafting</requiredGiverWorkType>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <researchPrerequisite>HelodTotalSynthesisMedicine</researchPrerequisite>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>BlocksSlate</li>
          </thingDefs>
        </filter>
        <count>25</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Chemfuel</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>BlocksSlate</li>
        <li>Chemfuel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <HD_Alumina>20</HD_Alumina>
    </products>
    <recipeUsers>
      <li>HD_StirredTankReactor</li>
    </recipeUsers>
    <skillRequirements>
      <Crafting>8</Crafting>
    </skillRequirements>
  </RecipeDef>
  <RecipeDef>
    <defName>HD_SmeltSilicon</defName>
    <label>smelt silicon from sandstone blocks</label>
    <description>Process quartz-bearing sandstone blocks with charcoal in the vacuum induction furnace to produce silicon.</description>
    <jobString>Processing industrial minerals.</jobString>
    <workAmount>4000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <requiredGiverWorkType>Crafting</requiredGiverWorkType>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <researchPrerequisite>HelodColdWarTech</researchPrerequisite>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>BlocksSandstone</li>
          </thingDefs>
        </filter>
        <count>25</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>HD_Charcoal</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>BlocksSandstone</li>
        <li>HD_Charcoal</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <HD_Silicon>10</HD_Silicon>
    </products>
    <recipeUsers>
      <li>HD_VIMFurnace</li>
    </recipeUsers>
    <skillRequirements>
      <Crafting>8</Crafting>
    </skillRequirements>
  </RecipeDef>
  <RecipeDef>
    <defName>HD_RefineAluminiumAlloy</defName>
    <label>refine aluminium alloy</label>
    <description>Refine alumina and a small amount of plasteel in the vacuum induction furnace, then cast lightweight aluminium alloy billets.</description>
    <jobString>Processing industrial minerals.</jobString>
    <workAmount>5000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <requiredGiverWorkType>Crafting</requiredGiverWorkType>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <researchPrerequisite>HelodColdWarTech</researchPrerequisite>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>HD_Alumina</li>
          </thingDefs>
        </filter>
        <count>6</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Plasteel</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>HD_Alumina</li>
        <li>Plasteel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <HD_AluminiumAlloy>4</HD_AluminiumAlloy>
    </products>
    <recipeUsers>
      <li>HD_VIMFurnace</li>
    </recipeUsers>
    <skillRequirements>
      <Crafting>8</Crafting>
    </skillRequirements>
  </RecipeDef>
