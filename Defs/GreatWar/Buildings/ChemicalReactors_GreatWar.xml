<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>HD_HaberBoschHighPressureReactor</defName>
    <label>high-pressure reactor</label>
    <description>A reinforced catalytic reactor that fixes atmospheric nitrogen under extreme pressure. Supplied with a hydrogen-rich fuel feed, it produces ammonium nitrate for fertilizer and explosives.</description>
    <thingClass>Building_WorkTable_HeatPush</thingClass>
    <graphicData>
      <texPath>Buildings/HD_HaberBoschHighPressureReactor_north</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(4.5,4.5)</drawSize>
      <drawOffset>(0,0,0.35)</drawOffset>
      <shaderType>CutoutComplex</shaderType>
      <color>(255,255,255)</color>
      <shadowData>
        <volume>(2.4,0.9,2.4)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.85</fillPercent>
    <statBases>
      <MaxHitPoints>450</MaxHitPoints>
      <WorkToBuild>6000</WorkToBuild>
      <Flammability>0.25</Flammability>
      <Mass>420</Mass>
      <WorkTableWorkSpeedFactor>1.25</WorkTableWorkSpeedFactor>
    </statBases>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>180</costStuffCount>
    <costList>
      <HD_CarbonSteel>80</HD_CarbonSteel>
      <HD_UniformRolledSteelPlate>16</HD_UniformRolledSteelPlate>
      <HD_GeneralMachinePart>12</HD_GeneralMachinePart>
      <HD_BasicElectricalComponents>8</HD_BasicElectricalComponents>
    </costList>
    <size>(3,3)</size>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-2)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <rotatable>false</rotatable>
    <designationCategory>HD_HelodTechnology_Build</designationCategory>
    <uiOrder>2480</uiOrder>
    <constructionSkillPrerequisite>10</constructionSkillPrerequisite>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>HelodHaberBosch</li>
    </researchPrerequisites>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>3500</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
    </comps>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
      <heatPerTickWhileWorking>0.28</heatPerTickWhileWorking>
    </building>
  </ThingDef>

