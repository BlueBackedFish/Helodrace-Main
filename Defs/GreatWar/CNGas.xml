<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef>
    <defName>HD_CNGasExposure</defName>
    <label>CN irritation</label>
    <labelNoun>CN irritation</labelNoun>
    <description>Exposure to CN tear agent is gradually causing painful eye, skin, and airway irritation. Severe accumulated exposure can cause minor tissue damage. Symptoms fade slowly after leaving the gas.</description>
    <hediffClass>Helodrace.ModernWar.Hediff_CNGasExposure</hediffClass>
    <defaultLabelColor>(0.86,0.78,0.50)</defaultLabelColor>
    <maxSeverity>1.0</maxSeverity>
    <isBad>true</isBad>
    <stages>
      <li>
        <label>developing irritation</label>
        <minSeverity>0.08</minSeverity>
        <painOffset>0.08</painOffset>
        <capMods>
          <li><capacity>Sight</capacity><offset>-0.12</offset></li>
          <li><capacity>Manipulation</capacity><offset>-0.06</offset></li>
        </capMods>
      </li>
      <li>
        <label>coughing and blurred vision</label>
        <minSeverity>0.40</minSeverity>
        <painOffset>0.24</painOffset>
        <capMods>
          <li><capacity>Sight</capacity><offset>-0.42</offset></li>
          <li><capacity>Moving</capacity><offset>-0.18</offset></li>
          <li><capacity>Manipulation</capacity><offset>-0.25</offset></li>
          <li><capacity>Breathing</capacity><offset>-0.15</offset></li>
        </capMods>
      </li>
      <li>
        <label>severe CN poisoning</label>
        <minSeverity>0.75</minSeverity>
        <painOffset>0.42</painOffset>
        <capMods>
          <li><capacity>Sight</capacity><offset>-0.70</offset></li>
          <li><capacity>Moving</capacity><offset>-0.38</offset></li>
          <li><capacity>Manipulation</capacity><offset>-0.50</offset></li>
          <li><capacity>Breathing</capacity><offset>-0.32</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
