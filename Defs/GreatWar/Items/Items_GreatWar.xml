<Defs>

  <!-- Consumables -->

  <ThingDef ParentName="MealBase">
    <defName>HD_FLAM</defName>
    <label>FLAM</label>
    <description>A suspiciously long-lasting block of canned meat. FLAM is salty, filling, and compact enough to stockpile in truly unreasonable quantities.</description>
    <graphicData>
      <texPath>Items/HD_SPAM</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(0.8,0.8)</drawSize>
    </graphicData>
    <stackLimit>512</stackLimit>
    <statBases>
      <MarketValue>24</MarketValue>
      <Mass>0.3</Mass>
      <Nutrition>0.9</Nutrition>
    </statBases>
    <ingestible>
      <preferability>MealFine</preferability>
      <foodType>Meat, Processed, Meal</foodType>
      <ingestSound>RawMeat_Eat</ingestSound>
    </ingestible>
  </ThingDef>

