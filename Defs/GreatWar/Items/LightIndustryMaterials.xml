<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>HD_Alumina</defName>
    <label>alumina</label>
    <description>White aluminium oxide refined from aluminous stone. Used to produce aluminium alloys and ceramic armor.</description>
    <graphicData>
      <texPath>Items/HD_Alumina</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(0.8,0.8)</drawSize>
    </graphicData>
    <stackLimit>150</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <MarketValue>3</MarketValue>
      <Mass>0.5</Mass>
      <Flammability>0</Flammability>
      <DeteriorationRate>0.4</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>
  <ThingDef ParentName="ResourceBase">
    <defName>HD_AluminiumAlloy</defName>
    <label>aluminium alloy</label>
    <description>Light aluminium-silicon alloy billets for equipment frames and electronic housings.</description>
    <graphicData>
      <texPath>Items/HD_AluminiumAlloy</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(0.8,0.8)</drawSize>
    </graphicData>
    <stackLimit>150</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <MarketValue>8</MarketValue>
      <Mass>0.4</Mass>
      <Flammability>0</Flammability>
      <DeteriorationRate>0.4</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>
  <ThingDef ParentName="ResourceBase">
    <defName>HD_Silicon</defName>
    <label>silicon</label>
    <description>Refined silicon produced from quartz-bearing sandstone. Used in aluminium alloys and purified into semiconductor devices.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Plasteel</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(0.8,0.8)</drawSize>
      <color>(100,105,125)</color>
    </graphicData>
    <stackLimit>150</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <statBases>
