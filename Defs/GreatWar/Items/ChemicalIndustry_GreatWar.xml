<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="ResourceBase">
    <defName>HD_AmmoniumNitrate</defName>
    <label>ammonium nitrate</label>
    <description>A white crystalline nitrogen compound synthesized under high pressure. It is a powerful oxidizer used in fertilizer and as a precursor for industrial explosives.</description>
    <graphicData>
      <texPath>Items/HD_AmmoniumNitrate</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(0.8,0.8)</drawSize>
    </graphicData>
    <stackLimit>150</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <statBases>
      <MaxHitPoints>55</MaxHitPoints>
      <MarketValue>4</MarketValue>
      <Mass>1.0</Mass>
      <Flammability>0.4</Flammability>
      <DeteriorationRate>0.8</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>HD_TNT</defName>
    <label>TNT</label>
    <description>Trinitrotoluene cast into compact demolition blocks. Stable enough for transport but capable of a powerful detonation when used in munitions and blasting charges.</description>
    <graphicData>
      <texPath>Items/HD_TNT</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(0.8,0.8)</drawSize>
    </graphicData>
    <stackLimit>75</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <statBases>
      <MaxHitPoints>45</MaxHitPoints>
      <MarketValue>12</MarketValue>
      <Mass>0.12</Mass>
      <Flammability>2.5</Flammability>
      <DeteriorationRate>0.6</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>

</Defs>
