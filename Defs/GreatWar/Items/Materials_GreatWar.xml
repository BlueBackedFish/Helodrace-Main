      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(0.8,0.8)</drawSize>
    </graphicData>
    <stackLimit>75</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <statBases>
      <MaxHitPoints>45</MaxHitPoints>
      <MarketValue>12</MarketValue>
      <Mass>0.12</Mass>
      <Flammability>2.5</Flammability>
      <DeteriorationRate>0.6</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <comps>
      <li Class="Helodrace.CompProperties_InsensitiveExplosive">
        <explosiveRadius>1.1</explosiveRadius>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <damageAmountBase>60</damageAmountBase>
        <armorPenetrationBase>0.3</armorPenetrationBase>
        <damageFalloff>false</damageFalloff>
        <explosiveExpandPerStackcount>0.05</explosiveExpandPerStackcount>
        <chanceNeverExplodeFromDamage>1</chanceNeverExplodeFromDamage>
        <drawWick>false</drawWick>
        <preExplosionSpawnSingleThingDef>Filth_BlastMark</preExplosionSpawnSingleThingDef>
        <minimumExplosionDamage>30</minimumExplosionDamage>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>HD_RDX</defName>
    <label>RDX</label>
    <description>Crystalline cyclotrimethylenetrinitramine packed into sealed drums. More powerful than TNT and stable enough for transport, RDX is the principal explosive ingredient used to manufacture plastic explosives.</description>
    <graphicData>
