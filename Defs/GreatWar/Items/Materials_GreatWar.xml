<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="ResourceBase">
    <defName>HD_AmmoniumNitrate</defName>
    <label>ammonium nitrate</label>
    <description>A white crystalline nitrogen compound synthesized under high pressure. It is a powerful oxidizer used in fertilizer and as a precursor for industrial explosives. It is insensitive to bullets and fire, but a sufficiently powerful explosion can detonate it.</description>
    <graphicData>
      <texPath>Items/HD_AmmoniumNitrate</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(0.8,0.8)</drawSize>
    </graphicData>
    <stackLimit>150</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <statBases>
      <MaxHitPoints>55</MaxHitPoints>
      <MarketValue>4</MarketValue>
      <Mass>1.0</Mass>
      <Flammability>0.4</Flammability>
      <DeteriorationRate>0.8</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <comps>
      <li Class="Helodrace.CompProperties_InsensitiveExplosive">
        <explosiveRadius>1.4</explosiveRadius>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <damageAmountBase>55</damageAmountBase>
        <armorPenetrationBase>0.25</armorPenetrationBase>
        <damageFalloff>false</damageFalloff>
        <explosiveExpandPerStackcount>0.025</explosiveExpandPerStackcount>
        <chanceNeverExplodeFromDamage>1</chanceNeverExplodeFromDamage>
        <drawWick>false</drawWick>
        <preExplosionSpawnSingleThingDef>Filth_BlastMark</preExplosionSpawnSingleThingDef>
        <minimumExplosionDamage>50</minimumExplosionDamage>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>HD_TNT</defName>
