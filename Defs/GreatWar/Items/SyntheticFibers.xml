<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>HD_Nylon</defName>
    <label>nylon</label>
    <description>Light synthetic fabric spun from a fuel-based polymer feed. A versatile material for ordinary clothing and equipment covers.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Cloth</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(0.8,0.8)</drawSize>
      <shaderType>CutoutComplex</shaderType>
      <color>(215,220,215)</color>
      <shaderParameters>
        <_MaskTex>/Items/SyntheticFibers/ClothTintMask</_MaskTex>
      </shaderParameters>
    </graphicData>
    <stackLimit>150</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <burnableByRecipe>true</burnableByRecipe>
    <minRewardCount>20</minRewardCount>
    <statBases>
      <MarketValue>2.4</MarketValue>
      <Mass>0.018</Mass>
      <DeteriorationRate>2</DeteriorationRate>
      <StuffPower_Armor_Sharp>0.45</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.1</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>0.25</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>20</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>18</StuffPower_Insulation_Heat>
      <MaxHitPoints>110</MaxHitPoints>
      <Flammability>1.1</Flammability>
    </statBases>
    <stuffProps>
      <categories>
        <li>Fabric</li>
      </categories>
      <color>(215,220,215)</color>
      <commonality>.1</commonality>
      <statFactors>
        <MaxHitPoints>1.15</MaxHitPoints>
        <Flammability>1.1</Flammability>
        <Beauty>1.1</Beauty>
      </statFactors>
    </stuffProps>
    <thingCategories>
      <li>Textiles</li>
    </thingCategories>
  </ThingDef>
