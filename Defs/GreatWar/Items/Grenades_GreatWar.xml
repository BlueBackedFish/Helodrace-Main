<Defs>

  <ThingDef Name="HD_GreatWarGrenadeBase" ParentName="ResourceBase" Abstract="True">
    <tickerType>Normal</tickerType>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.78,0.78)</drawSize>
    </graphicData>
    <uiIconScale>1.2</uiIconScale>
    <stackLimit>25</stackLimit>
    <soundInteract>Interact_Grenade</soundInteract>
    <techLevel>Industrial</techLevel>
    <statBases>
      <Mass>0.65</Mass>
      <RangedWeapon_Cooldown>2.5</RangedWeapon_Cooldown>
      <WorkToMake>12000</WorkToMake>
      <MarketValue>260</MarketValue>
    </statBases>
    <costList>
      <Steel>16</Steel>
      <Chemfuel>45</Chemfuel>
    </costList>
    <recipeMaker>
      <researchPrerequisite>HelodLowGranade</researchPrerequisite>
      <skillRequirements><Crafting>5</Crafting></skillRequirements>
    </recipeMaker>
    <weaponTags><li>HD_GreatWarGrenade</li></weaponTags>
    <thingCategories><li>HD_InventoryGrenades</li></thingCategories>
    <smeltable>true</smeltable>
    <verbs />
  </ThingDef>

  <ThingDef ParentName="HD_GreatWarGrenadeBase">
    <defName>HD_Grenade_M8</defName>
    <projectileWhenLoaded>HD_Projectile_M8</projectileWhenLoaded>
    <label>M8 HC smoke grenade</label>
    <description>Metal canister grenades that burn a hexachloroethane mixture to rapidly create a thick white screening cloud.</description>
    <graphicData><texPath>Weapons/GreatWar/HD_M8</texPath></graphicData>
    <weaponTags><li>GrenadeSmoke</li></weaponTags>
    <verbs Inherit="False">
      <li>
        <label>throw M8 grenade</label>
        <verbClass>Verb_LaunchProjectile</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <range>13.9</range>
        <forcedMissRadius>1.6</forcedMissRadius>
        <warmupTime>1.35</warmupTime>
        <requireLineOfSight>true</requireLineOfSight>
        <noiseRadius>4</noiseRadius>
        <ai_IsBuildingDestroyer>false</ai_IsBuildingDestroyer>
        <soundCast>ThrowGrenade</soundCast>
        <targetParams><canTargetLocations>true</canTargetLocations></targetParams>
        <defaultProjectile>HD_Projectile_M8</defaultProjectile>
        <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
      </li>
    </verbs>
    <comps>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>3.5</explosiveRadius>
        <explosiveDamageType>Smoke</explosiveDamageType>
        <postExplosionGasType>BlindSmoke</postExplosionGasType>
        <requiredDamageTypeToExplode>Flame</requiredDamageTypeToExplode>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="HD_GreatWarGrenadeBase">
    <defName>HD_Grenade_M15</defName>
    <projectileWhenLoaded>HD_Projectile_M15</projectileWhenLoaded>
    <label>M15 white phosphorus grenade</label>
    <description>White phosphorus grenades that burst into burning material while producing a dense smoke screen. They are dangerous to exposed personnel and readily ignite the surroundings.</description>
    <graphicData><texPath>Weapons/GreatWar/HD_M15</texPath></graphicData>
    <statBases>
      <Mass>0.88</Mass>
      <WorkToMake>16000</WorkToMake>
      <MarketValue>380</MarketValue>
    </statBases>
    <costList>
      <Steel>18</Steel>
      <Chemfuel>70</Chemfuel>
    </costList>
    <weaponTags>
      <li>GrenadeFlame</li>
      <li>GrenadeSmoke</li>
    </weaponTags>
    <verbs Inherit="False">
      <li>
        <label>throw M15 grenade</label>
        <verbClass>Verb_LaunchProjectile</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <range>12.9</range>
        <forcedMissRadius>1.7</forcedMissRadius>
        <warmupTime>1.45</warmupTime>
        <requireLineOfSight>true</requireLineOfSight>
        <noiseRadius>5</noiseRadius>
        <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
        <soundCast>ThrowGrenade</soundCast>
        <targetParams><canTargetLocations>true</canTargetLocations></targetParams>
        <defaultProjectile>HD_Projectile_M15</defaultProjectile>
        <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
      </li>
    </verbs>
    <comps>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>3.0</explosiveRadius>
        <explosiveDamageType>Flame</explosiveDamageType>
        <postExplosionGasType>BlindSmoke</postExplosionGasType>
        <requiredDamageTypeToExplode>Flame</requiredDamageTypeToExplode>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="HD_GreatWarGrenadeBase">
    <defName>HD_Grenade_MKII</defName>
    <projectileWhenLoaded>HD_Projectile_MKII</projectileWhenLoaded>
    <label>MK II fragmentation grenade</label>
    <description>A cast-iron defensive grenade whose deeply grooved body bursts into deadly fragments. It is heavier and less powerful than later fragmentation grenades, but remains effective against exposed infantry.</description>
    <graphicData><texPath>Weapons/GreatWar/HD_MKII</texPath></graphicData>
    <statBases>
      <Mass>0.59</Mass>
      <WorkToMake>13000</WorkToMake>
      <MarketValue>280</MarketValue>
    </statBases>
    <weaponTags><li>GrenadeDestructive</li></weaponTags>
    <verbs Inherit="False">
      <li>
        <label>throw MK II grenade</label>
        <verbClass>Verb_LaunchProjectile</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <range>13.2</range>
        <forcedMissRadius>1.7</forcedMissRadius>
        <warmupTime>1.4</warmupTime>
        <requireLineOfSight>true</requireLineOfSight>
        <noiseRadius>4</noiseRadius>
        <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
        <soundCast>ThrowGrenade</soundCast>
        <targetParams><canTargetLocations>true</canTargetLocations></targetParams>
        <defaultProjectile>HD_Projectile_MKII</defaultProjectile>
        <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
      </li>
    </verbs>
    <comps>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>2.5</explosiveRadius>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <requiredDamageTypeToExplode>Flame</requiredDamageTypeToExplode>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="HD_GreatWarGrenadeBase">
    <defName>HD_Grenade_MKIII</defName>
    <projectileWhenLoaded>HD_Projectile_MKIII</projectileWhenLoaded>
    <label>MK III offensive grenade</label>
    <description>An offensive grenade with a thick fiberboard body packed with high explosive. It produces little dangerous fragmentation and incapacitates through powerful blast overpressure, making it especially lethal in confined spaces.</description>
    <graphicData><texPath>Weapons/GreatWar/HD_MKIII</texPath></graphicData>
    <statBases>
      <Mass>0.44</Mass>
      <WorkToMake>14500</WorkToMake>
      <MarketValue>320</MarketValue>
    </statBases>
    <costList>
      <Steel>8</Steel>
      <Chemfuel>65</Chemfuel>
    </costList>
    <weaponTags><li>GrenadeDestructive</li></weaponTags>
    <verbs Inherit="False">
      <li>
        <label>throw MK III grenade</label>
        <verbClass>Verb_LaunchProjectile</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <range>13.5</range>
        <forcedMissRadius>1.6</forcedMissRadius>
        <warmupTime>1.35</warmupTime>
        <requireLineOfSight>true</requireLineOfSight>
        <noiseRadius>4</noiseRadius>
        <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
        <soundCast>ThrowGrenade</soundCast>
        <targetParams><canTargetLocations>true</canTargetLocations></targetParams>
        <defaultProjectile>HD_Projectile_MKIII</defaultProjectile>
        <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
