  <ThingDef Name="HD_GreatWarGrenadeProjectileBase" ParentName="BaseGrenadeProjectile" Abstract="True">
    <thingClass>Helodrace.ModernWar.Projectile_ModernGrenade</thingClass>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.46,0.46)</drawSize>
    </graphicData>
    <projectile><explosionDelay>270</explosionDelay></projectile>
  </ThingDef>

  <ThingDef ParentName="HD_GreatWarGrenadeProjectileBase">
    <defName>HD_Projectile_M8</defName>
    <label>M8 HC smoke grenade</label>
    <graphicData><texPath>Weapons/GreatWar/Projectiles/HD_M8_proj</texPath></graphicData>
    <projectile>
      <damageDef>Smoke</damageDef>
      <explosionRadius>4.2</explosionRadius>
      <explosionDelay>90</explosionDelay>
      <doExplosionVFX>false</doExplosionVFX>
      <postExplosionGasType>BlindSmoke</postExplosionGasType>
      <screenShakeFactor>0.2</screenShakeFactor>
    </projectile>
    <modExtensions>
      <li Class="Helodrace.ModernWar.ModernGrenadeProjectileExtension">
        <clipDef>HD_M8_ClipEffect</clipDef>
        <pinDef>HD_M8_PinEffect</pinDef>
        <fuseTicks>90</fuseTicks>
        <fuseVarianceTicks>12</fuseVarianceTicks>
        <waitForGroundBeforeRelease>true</waitForGroundBeforeRelease>
        <smokeTrail>true</smokeTrail>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="HD_GreatWarGrenadeProjectileBase">
    <defName>HD_Projectile_M15</defName>
    <label>M15 white phosphorus grenade</label>
    <graphicData><texPath>Weapons/GreatWar/Projectiles/HD_M15_proj</texPath></graphicData>
    <projectile>
      <damageDef>Flame</damageDef>
      <damageAmountBase>22</damageAmountBase>
      <explosionRadius>3.0</explosionRadius>
      <preExplosionSpawnThingDef>Filth_Fuel</preExplosionSpawnThingDef>
      <preExplosionSpawnChance>0.8</preExplosionSpawnChance>
      <postExplosionGasType>BlindSmoke</postExplosionGasType>
      <ai_IsIncendiary>true</ai_IsIncendiary>
      <screenShakeFactor>0.6</screenShakeFactor>
    </projectile>
    <modExtensions>
      <li Class="Helodrace.ModernWar.ModernGrenadeProjectileExtension">
        <clipDef>HD_M15_ClipEffect</clipDef>
        <pinDef>HD_M15_PinEffect</pinDef>
        <smokeTrail>true</smokeTrail>
        <glowingTrail>true</glowingTrail>
        <trailSmokeScale>0.34</trailSmokeScale>
        <trailGlowScale>0.34</trailGlowScale>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="HD_GreatWarGrenadeProjectileBase">
    <defName>HD_Projectile_MKII</defName>
    <label>MK II fragmentation grenade</label>
    <thingClass>Helodrace.ModernWar.Projectile_ExplosiveGrenade</thingClass>
    <graphicData><texPath>Weapons/GreatWar/Projectiles/MKII/HD_MKII_proj</texPath></graphicData>
    <projectile>
      <damageDef>Bomb</damageDef>
      <damageAmountBase>40</damageAmountBase>
      <armorPenetrationBase>0.30</armorPenetrationBase>
      <explosionRadius>2.8</explosionRadius>
    </projectile>
    <modExtensions>
      <li Class="Helodrace.ModernWar.ModernGrenadeProjectileExtension">
        <clipDef>HD_MKII_ClipEffect</clipDef>
        <pinDef>HD_MKII_PinEffect</pinDef>
      </li>
      <li Class="Helodrace.ModernWar.ExplosiveGrenadeVisualExtension">
        <smokeCount>30</smokeCount>
        <initialRadius>0.28</initialRadius>
        <expansionSpeed>1.75</expansionSpeed>
        <smokeScale>0.9</smokeScale>
      </li>
      <li Class="Helodrace.ModernWar.FragmentationGrenadeExtension">
        <fragmentProjectile>HD_Projectile_MKIIFragment</fragmentProjectile>
        <fragmentCount>56</fragmentCount>
        <radius>11.25</radius>
        <minimumRangeFactor>0.50</minimumRangeFactor>
        <targetedFragmentFraction>0.60</targetedFragmentFraction>
        <closeAimMultiplier>1.80</closeAimMultiplier>
        <edgeAimMultiplier>0.42</edgeAimMultiplier>
        <minimumTargetedAimChance>0.40</minimumTargetedAimChance>
        <longRangeFragmentFraction>0.14</longRangeFragmentFraction>
        <longRangeRadius>16</longRangeRadius>
        <longRangeMinimumFactor>0.72</longRangeMinimumFactor>
      </li>
      <li Class="Helodrace.ModernWar.FlashbangProjectileExtension">
        <suppressionHediff>HD_FlashbangSuppression</suppressionHediff>
        <effectRadius>8</effectRadius>
        <indoorRadiusFactor>1.30</indoorRadiusFactor>
        <outdoorDistanceExponent>1.35</outdoorDistanceExponent>
        <indoorDistanceExponent>0.80</indoorDistanceExponent>
        <severityAtCenter>0.75</severityAtCenter>
        <severityAtEdge>0.06</severityAtEdge>
        <outdoorFactor>0.55</outdoorFactor>
        <smallRoomCellCount>16</smallRoomCellCount>
        <largeRoomCellCount>160</largeRoomCellCount>
        <smallRoomFactor>1.25</smallRoomFactor>
        <largeRoomFactor>0.70</largeRoomFactor>
        <differentRoomFactor>0.50</differentRoomFactor>
        <blockedPathFactor>0.10</blockedPathFactor>
        <stunThreshold>0.68</stunThreshold>
        <stunFullIntensity>0.92</stunFullIntensity>
        <stunTicksMin>75</stunTicksMin>
        <stunTicksMax>120</stunTicksMax>
      </li>
    </modExtensions>
  </ThingDef>

