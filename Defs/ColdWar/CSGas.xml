<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef>
    <defName>HD_CSGas</defName>
    <label>CS gas</label>
    <description>A dense tear-agent cloud that causes immediate eye, skin, and respiratory irritation. It disperses quickly and does not travel as far as persistent chemical agents. Gas protection and toxic-environment resistance reduce exposure.</description>
    <thingClass>Helodrace.ModernWar.Gas_CS</thingClass>
    <category>Ethereal</category>
    <tickerType>Never</tickerType>
    <useHitPoints>false</useHitPoints>
    <selectable>false</selectable>
    <drawerType>RealtimeOnly</drawerType>
    <altitudeLayer>Gas</altitudeLayer>
    <graphicData>
      <texPath>Icons/HD_Helod</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.01,0.01)</drawSize>
      <shaderType>Transparent</shaderType>
    </graphicData>
  </ThingDef>

  <HediffDef>
    <defName>HD_CSGasExposure</defName>
    <label>CS irritation</label>
    <labelNoun>CS irritation</labelNoun>
    <description>Exposure to CS tear agent is causing painful eye, skin, and airway irritation. Symptoms fade after leaving the gas.</description>
    <hediffClass>Helodrace.ModernWar.Hediff_CSGasExposure</hediffClass>
    <defaultLabelColor>(0.82,0.84,0.58)</defaultLabelColor>
    <maxSeverity>1.0</maxSeverity>
    <isBad>true</isBad>
    <stages>
      <li>
        <label>irritated</label>
        <minSeverity>0.01</minSeverity>
        <painOffset>0.12</painOffset>
        <capMods>
          <li><capacity>Sight</capacity><offset>-0.20</offset></li>
          <li><capacity>Manipulation</capacity><offset>-0.10</offset></li>
        </capMods>
      </li>
      <li>
        <label>coughing and blinded</label>
        <minSeverity>0.25</minSeverity>
        <painOffset>0.30</painOffset>
        <capMods>
          <li><capacity>Sight</capacity><offset>-0.55</offset></li>
          <li><capacity>Moving</capacity><offset>-0.25</offset></li>
          <li><capacity>Manipulation</capacity><offset>-0.35</offset></li>
          <li><capacity>Breathing</capacity><offset>-0.20</offset></li>
        </capMods>
      </li>
      <li>
        <label>incapacitating irritation</label>
        <minSeverity>0.60</minSeverity>
        <painOffset>0.55</painOffset>
        <capMods>
          <li><capacity>Sight</capacity><offset>-0.85</offset></li>
          <li><capacity>Moving</capacity><offset>-0.50</offset></li>
          <li><capacity>Manipulation</capacity><offset>-0.65</offset></li>
          <li><capacity>Breathing</capacity><offset>-0.40</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
