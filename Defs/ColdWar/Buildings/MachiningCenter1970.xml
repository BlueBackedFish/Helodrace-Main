<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>HD_MachiningCenter1970Bench</defName>
    <label>1970s machining center</label>
    <description>A vertical machining center with automatic tool changing, electric servo axes and a CRT control console. Repeats milling operations faster than early numerical-control machines and links to firearm workbenches as a milling facility. Requires electricity and an operator.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Buildings/HD_MachiningCenter1970</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <colorTwo>(105,105,105)</colorTwo>
      <color>(255,255,255)</color>
      <drawSize>(4.5,4.5)</drawSize>
      <drawOffset>(0,0,0)</drawOffset>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.65</fillPercent>
    <statBases>
      <MaxHitPoints>420</MaxHitPoints>
      <WorkToBuild>8000</WorkToBuild>
      <Flammability>0.2</Flammability>
      <Mass>390</Mass>
      <WorkTableWorkSpeedFactor>3.5</WorkTableWorkSpeedFactor>
    </statBases>
    <costList>
      <Steel>190</Steel>
      <HD_CarbonSteel>90</HD_CarbonSteel>
      <HD_GeneralMachinePart>10</HD_GeneralMachinePart>
      <HD_BasicElectricalComponents>12</HD_BasicElectricalComponents>
      <HD_BasicElectronicComponents>10</HD_BasicElectronicComponents>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <size>(3,3)</size>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-2)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <rotatable>true</rotatable>
    <tickerType>Rare</tickerType>
    <designationCategory>HD_HelodTechnology_Build</designationCategory>
    <uiOrder>2373</uiOrder>
    <constructionSkillPrerequisite>10</constructionSkillPrerequisite>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>3500</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Facility">
        <maxSimultaneous>1</maxSimultaneous>
        <maxDistance>6</maxDistance>
      </li>
      <li Class="Helodrace.CompProperties_OperatingHeatPusher">
        <heatPerSecond>6</heatPerSecond>
        <heatPushMaxTemperature>70</heatPushMaxTemperature>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <modExtensions>
      <li Class="Helodrace.MachineToolFacilityExtension">
        <millingTier>3</millingTier>
      </li>
    </modExtensions>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
    </building>
    <researchPrerequisites>
      <li>HelodIndustrialAutomation</li>
    </researchPrerequisites>
    <recipes>
      <li>HD_MillGeneralMachinePart</li>
      <li>HD_MillGeneralMachinePartBulk5</li>
      <li>HD_MillGeneralMachinePartBulk10</li>
      <li>HD_MakeWildWestBarrel</li>
    </recipes>
  </ThingDef>
</Defs>