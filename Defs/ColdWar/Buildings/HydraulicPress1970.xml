<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>HD_HydraulicPress1970Bench</defName>
    <label>1970s hydraulic press</label>
    <description>A straight-side production press with its own electric hydraulic unit, a large overhead cylinder and analog pressure controls. Forms steel components and pressed helmets faster than a line-shaft press. Requires electricity and an operator.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Buildings/HD_HydraulicPress1970</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <colorTwo>(105,105,105)</colorTwo>
      <color>(255,255,255)</color>
      <drawSize>(4.5,4.5)</drawSize>
      <drawOffset>(0,0,0.175944686)</drawOffset>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.65</fillPercent>
    <statBases>
      <MaxHitPoints>520</MaxHitPoints>
      <WorkToBuild>8500</WorkToBuild>
      <Flammability>0.2</Flammability>
      <Mass>520</Mass>
      <WorkTableWorkSpeedFactor>3</WorkTableWorkSpeedFactor>
    </statBases>
    <costList>
      <Steel>220</Steel>
      <HD_CarbonSteel>110</HD_CarbonSteel>
      <HD_GeneralMachinePart>12</HD_GeneralMachinePart>
      <HD_UniformRolledSteelPlate>16</HD_UniformRolledSteelPlate>
      <HD_BasicElectricalComponents>10</HD_BasicElectricalComponents>
      <HD_BasicElectronicComponents>6</HD_BasicElectronicComponents>
    </costList>
    <size>(3,3)</size>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-2)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <rotatable>true</rotatable>
    <tickerType>Rare</tickerType>
    <designationCategory>HD_HelodTechnology_Build</designationCategory>
    <uiOrder>2375</uiOrder>
    <constructionSkillPrerequisite>10</constructionSkillPrerequisite>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>4500</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="Helodrace.CompProperties_OperatingHeatPusher">
        <heatPerSecond>7</heatPerSecond>
        <heatPushMaxTemperature>70</heatPushMaxTemperature>
      </li>
    </comps>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
    </building>
    <researchPrerequisites>
      <li>HelodIndustrialAutomation</li>
    </researchPrerequisites>
    <recipes>
      <li>HD_MakePressComponent</li>
      <li>HD_MakePressComponentBulk5</li>
      <li>HD_MakePressComponentBulk10</li>
    </recipes>
  </ThingDef>
</Defs>