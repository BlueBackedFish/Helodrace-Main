<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>HD_NCLathe</defName>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories><li>BuildingsProduction</li></thingCategories>
    <label>NC lathe</label>
    <description>An open-bed electric lathe with servo feeds and a separate punched-tape numerical controller. This first-generation numerical-control machine uses analog instruments and relay electronics. Performs the turret lathe's turning jobs faster and serves as a powered lathe facility for firearm assembly. Still requires an operator.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Buildings/HD_NCLathe</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <colorTwo>(105,105,105)</colorTwo>
      <color>(255,255,255)</color>
      <drawSize>(4.5,4.5)</drawSize>
      <drawOffset>(0,0,0)</drawOffset>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.65</fillPercent>
    <statBases>
      <MaxHitPoints>340</MaxHitPoints>
      <WorkToBuild>6000</WorkToBuild>
      <Flammability>0.2</Flammability>
      <Mass>240</Mass>
      <WorkTableWorkSpeedFactor>2.5</WorkTableWorkSpeedFactor>
    </statBases>
    <costList>
      <Steel>120</Steel>
      <HD_CarbonSteel>60</HD_CarbonSteel>
      <HD_GeneralMachinePart>6</HD_GeneralMachinePart>
      <HD_BasicElectricalComponents>8</HD_BasicElectricalComponents>
      <HD_BasicElectronicComponents>6</HD_BasicElectronicComponents>
    </costList>
    <size>(3,2)</size>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <rotatable>true</rotatable>
    <tickerType>Rare</tickerType>
    <designationCategory>HD_HelodTechnology_Build</designationCategory>
    <uiOrder>2370</uiOrder>
    <constructionSkillPrerequisite>9</constructionSkillPrerequisite>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <researchPrerequisites><li>HelodNumericalControl</li></researchPrerequisites>
    <inspectorTabs><li>ITab_Bills</li></inspectorTabs>
    <recipes>
      <li>HD_MakeShaft</li>
      <li>HD_MillGeneralMachinePart</li>
      <li>HD_MillGeneralMachinePartBulk5</li>
      <li>HD_MillGeneralMachinePartBulk10</li>
      <li>HD_MakeShaftBulk5</li>
      <li>HD_MakeShaftBulk10</li>
    </recipes>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>900</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="Helodrace.CompProperties_IndustrialWorktablePower"/>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Facility"><maxSimultaneous>1</maxSimultaneous><maxDistance>6</maxDistance></li>
      <li Class="Helodrace.CompProperties_OperatingHeatPusher"><heatPerSecond>3</heatPerSecond><heatPushMaxTemperature>55</heatPushMaxTemperature></li>
    </comps>
    <placeWorkers><li>PlaceWorker_ShowFacilitiesConnections</li></placeWorkers>
    <modExtensions><li Class="Helodrace.FacilityCapabilityExtension"><capabilities><HD_Turning>3</HD_Turning></capabilities></li></modExtensions>
    <building><spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity></building>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>HD_NCMillingMachine</defName>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories><li>BuildingsProduction</li></thingCategories>
    <label>NC milling machine</label>
    <description>A heavy electric knee mill with servo-driven axes and a punched-tape numerical controller. Its exposed table, vertical spindle and separate control cabinet belong to the first generation of numerical machine tools. Performs the line-shaft mill's jobs faster and serves as a powered milling facility for firearm assembly. Still requires an operator.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Buildings/HD_NCMillingMachine</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <colorTwo>(105,105,105)</colorTwo>
      <color>(255,255,255)</color>
      <drawSize>(4.5,4.5)</drawSize>
      <drawOffset>(0,0,0)</drawOffset>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.65</fillPercent>
    <statBases>
      <MaxHitPoints>360</MaxHitPoints>
      <WorkToBuild>6500</WorkToBuild>
      <Flammability>0.2</Flammability>
      <Mass>290</Mass>
      <WorkTableWorkSpeedFactor>2.5</WorkTableWorkSpeedFactor>
    </statBases>
    <costList>
      <Steel>140</Steel>
      <HD_CarbonSteel>60</HD_CarbonSteel>
      <HD_GeneralMachinePart>6</HD_GeneralMachinePart>
      <HD_BasicElectricalComponents>8</HD_BasicElectricalComponents>
      <HD_BasicElectronicComponents>6</HD_BasicElectronicComponents>
    </costList>
    <size>(3,2)</size>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <rotatable>true</rotatable>
    <tickerType>Rare</tickerType>
    <designationCategory>HD_HelodTechnology_Build</designationCategory>
    <uiOrder>2371</uiOrder>
    <constructionSkillPrerequisite>9</constructionSkillPrerequisite>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <researchPrerequisites><li>HelodNumericalControl</li></researchPrerequisites>
    <inspectorTabs><li>ITab_Bills</li></inspectorTabs>
    <recipes>
      <li>HD_MillGeneralMachinePart</li>
      <li>HD_MillGeneralMachinePartBulk5</li>
      <li>HD_MillGeneralMachinePartBulk10</li>
    </recipes>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>1200</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="Helodrace.CompProperties_IndustrialWorktablePower"/>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Facility"><maxSimultaneous>1</maxSimultaneous><maxDistance>6</maxDistance></li>
      <li Class="Helodrace.CompProperties_OperatingHeatPusher"><heatPerSecond>4</heatPerSecond><heatPushMaxTemperature>60</heatPushMaxTemperature></li>
    </comps>
    <placeWorkers><li>PlaceWorker_ShowFacilitiesConnections</li></placeWorkers>
    <modExtensions><li Class="Helodrace.FacilityCapabilityExtension"><capabilities><HD_Milling>2</HD_Milling></capabilities></li></modExtensions>
    <building><spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity></building>
  </ThingDef>
</Defs>
