<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>HD_RollingMill1970Bench</defName>
    <label>1970s hydraulic rolling mill</label>
    <description>An electrically driven four-high plate mill with hydraulic roll-gap adjustment and entry and exit roller tables. Rolls uniform steel plate faster than a line-shaft mill. Requires electricity and an operator.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Buildings/HD_RollingMill1970</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <colorTwo>(105,105,105)</colorTwo>
      <color>(255,255,255)</color>
      <drawSize>(6,6)</drawSize>
      <drawOffset>(0,0,0)</drawOffset>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.65</fillPercent>
    <statBases>
      <MaxHitPoints>560</MaxHitPoints>
      <WorkToBuild>9500</WorkToBuild>
      <Flammability>0.2</Flammability>
      <Mass>620</Mass>
      <WorkTableWorkSpeedFactor>3</WorkTableWorkSpeedFactor>
    </statBases>
    <costList>
      <Steel>260</Steel>
      <HD_CarbonSteel>140</HD_CarbonSteel>
      <HD_GeneralMachinePart>14</HD_GeneralMachinePart>
      <HD_UniformRolledSteelPlate>20</HD_UniformRolledSteelPlate>
      <HD_BasicElectricalComponents>12</HD_BasicElectricalComponents>
      <HD_BasicElectronicComponents>6</HD_BasicElectronicComponents>
    </costList>
    <size>(4,3)</size>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-2)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <rotatable>true</rotatable>
    <tickerType>Rare</tickerType>
    <designationCategory>HD_HelodTechnology_Build</designationCategory>
    <uiOrder>2376</uiOrder>
    <constructionSkillPrerequisite>10</constructionSkillPrerequisite>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>6000</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="Helodrace.CompProperties_OperatingHeatPusher">
        <heatPerSecond>8</heatPerSecond>
        <heatPushMaxTemperature>70</heatPushMaxTemperature>
      </li>
    </comps>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
    </building>
    <researchPrerequisites>
      <li>HelodIndustrialAutomation</li>
    </researchPrerequisites>
    <recipes>
      <li>HD_RollUniformSteelPlate</li>
      <li>HD_RollUniformSteelPlateBulk5</li>
      <li>HD_RollUniformSteelPlateBulk10</li>
    </recipes>
  </ThingDef>
</Defs>