<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <RecipeDef>
    <defName>HD_FabricateSolidStateComponents</defName>
    <label>fabricate solid-state components</label>
    <description>Fabricate and package solid-state electronic components for transistor-era control systems. These are a higher tier than vacuum-tube basic electronic components and have the same market value as an industrial component.</description>
    <jobString>Fabricating solid-state components.</jobString>
    <workAmount>6000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <requiredGiverWorkType>Crafting</requiredGiverWorkType>
    <effectWorking>Sculpt</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <researchPrerequisite>HelodTransistor</researchPrerequisite>
    <ingredients>
      <li><filter><thingDefs><li>HD_Silicon</li></thingDefs></filter><count>2</count></li>
      <li><filter><thingDefs><li>HD_AluminiumAlloy</li></thingDefs></filter><count>4</count></li>
      <li><filter><thingDefs><li>Silver</li></thingDefs></filter><count>4</count></li>
      <li><filter><thingDefs><li>Chemfuel</li></thingDefs></filter><count>4</count></li>
      <li><filter><thingDefs><li>HD_BasicElectricalComponents</li></thingDefs></filter><count>2</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>HD_Silicon</li><li>HD_AluminiumAlloy</li><li>Silver</li><li>Chemfuel</li><li>HD_BasicElectricalComponents</li></thingDefs></fixedIngredientFilter>
    <products><HD_ElectronicComponent>1</HD_ElectronicComponent></products>
    <recipeUsers><li>HD_SemiconductorFab</li></recipeUsers>
    <skillRequirements><Crafting>10</Crafting></skillRequirements>
  </RecipeDef>
</Defs>
