        <nonPlayerWorkTicksByHitPoints>
          <points>
            <li>(1, 90)</li>
            <li>(100, 240)</li>
            <li>(300, 420)</li>
            <li>(600, 600)</li>
            <li>(1000, 780)</li>
            <li>(2000, 1080)</li>
            <li>(4000, 1440)</li>
            <li>(8000, 1840)</li>
            <li>(16000, 2320)</li>
          </points>
        </nonPlayerWorkTicksByHitPoints>
      </li>
    </comps>
    <tools>
      <li>
        <label>grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>1.8</cooldownTime>
      </li>
      <li>
        <label>cutting blade</label>
