    <uiIconScale>1.05</uiIconScale>
    <equippedAngleOffset>0</equippedAngleOffset>
    <weaponTags>
      <li>HD_ColdWarMelee</li>
    </weaponTags>
    <statBases>
      <WorkToMake>32000</WorkToMake>
      <Mass>5.2</Mass>
      <MarketValue>900</MarketValue>
      <MaxHitPoints>110</MaxHitPoints>
    </statBases>
    <equippedStatOffsets>
      <ConstructionSpeed>0.25</ConstructionSpeed>
    </equippedStatOffsets>
    <costList>
      <Steel>55</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <HD_GeneralMachinePart>2</HD_GeneralMachinePart>
    </costList>
    <recipeMaker>
      <recipeUsers Inherit="False">
        <li>HD_Tier2Workbench</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
      <researchPrerequisite>HelodMiniMotor</researchPrerequisite>
    </recipeMaker>
    <comps Inherit="False">
      <li><compClass>CompEquippable</compClass></li>
      <li Class="CompProperties_Styleable" />
      <li Class="Helodrace.CompProperties_PowerCutterBreach">
        <playerDeconstructSpeedFactor>1.5</playerDeconstructSpeedFactor>
        <!-- 30 emissions/second so several spark flecks remain visible at all times. -->
        <effectIntervalTicks>2</effectIntervalTicks>
        <sparksPerEmission>4</sparksPerEmission>
        <sparkOriginRadius>0.04</sparkOriginRadius>
        <sparkBrightness>2</sparkBrightness>
        <sparkOriginScreenUpOffset>0.44</sparkOriginScreenUpOffset>
        <sparkUpwardBias>0.18</sparkUpwardBias>
        <smokeIntervalTicks>4</smokeIntervalTicks>
        <smokePerEmission>2</smokePerEmission>
        <smokeScale>0.30</smokeScale>
        <dustIntervalTicks>3</dustIntervalTicks>
        <dustPerEmission>4</dustPerEmission>
        <dustOriginRadius>0.22</dustOriginRadius>
        <dustScale>0.34</dustScale>
        <metalFlashIntervalTicks>3</metalFlashIntervalTicks>
        <metalFlashScale>0.24</metalFlashScale>
        <breachContactCenterOffset>0.30</breachContactCenterOffset>
        <cuttingGraphicRightReach>0.386</cuttingGraphicRightReach>
