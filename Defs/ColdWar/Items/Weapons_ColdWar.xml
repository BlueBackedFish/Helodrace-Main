        <capacities>
          <li>Cut</li>
        </capacities>
        <power>18</power>
        <armorPenetration>0.25</armorPenetration>
        <cooldownTime>2.0</cooldownTime>
        <soundMeleeHit>MeleeHit_Metal_Sharp</soundMeleeHit>
      </li>
    </tools>
  </ThingDef>

