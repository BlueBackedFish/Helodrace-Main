<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingCategoryDef>
    <defName>HD_TOWMunitions</defName>
    <label>TOW missiles</label>
    <parent>Manufactured</parent>
    <modExtensions><li Class="Helodrace.AmmoCaliberExtension"><caliber>152mm</caliber></li></modExtensions>
  </ThingCategoryDef>

  <ThingCategoryDef>
    <defName>HD_20x102mmAmmunition</defName>
    <label>20x102mm ammunition</label>
    <parent>Manufactured</parent>
    <modExtensions><li Class="Helodrace.AmmoCaliberExtension"><caliber>20×102mm</caliber></li></modExtensions>
  </ThingCategoryDef>

  <ThingDef ParentName="ResourceBase">
    <defName>HD_20x102mmMixedRound</defName>
    <label>20x102mm mixed ammunition</label>
    <description>A linked 20x102mm ammunition supply for the M167 VADS, assembled in its standard mixed feed of high-explosive incendiary, high-explosive incendiary tracer, and armor-piercing incendiary projectiles.</description>
    <graphicData>
      <texPath>Weapons/ColdWar/Ammo/20x102mm</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(0.8,0.8)</drawSize>
    </graphicData>
    <stackLimit>500</stackLimit>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <MarketValue>5</MarketValue>
      <Mass>0.25</Mass>
      <Flammability>0.45</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>HD_20x102mmAmmunition</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>HD_BGM71A_Round</defName>
    <label>BGM-71A missile</label>
    <description>An early wire-guided anti-tank missile for the M220 TOW launcher.</description>
    <projectileWhenLoaded>HD_BGM71A_Proj</projectileWhenLoaded>
    <graphicData>
      <texPath>Weapons/ColdWar/Ammo/BGM-71A/HD_BGM71A</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.9,0.9)</drawSize>
    </graphicData>
    <stackLimit>10</stackLimit>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <MarketValue>1250</MarketValue>
      <Mass>18.9</Mass>
      <Flammability>0.55</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>HD_TOWMunitions</li>
    </thingCategories>
    <modExtensions>
      <li Class="Helodrace.TowLoadedGraphicExtension">
        <loadedLineTexPath>Weapons/ColdWar/Ammo/BGM-71A/HD_BGM71A_LoadedLine</loadedLineTexPath>
        <loadedTexPath>Weapons/ColdWar/Ammo/BGM-71A/HD_BGM71A_Loaded</loadedTexPath>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
