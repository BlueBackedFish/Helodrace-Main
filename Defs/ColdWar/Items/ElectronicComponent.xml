    <stackLimit>50</stackLimit><healthAffectsPrice>false</healthAffectsPrice>
    <statBases><MaxHitPoints>70</MaxHitPoints><MarketValue>32</MarketValue><Mass>0.6</Mass><Flammability>0.4</Flammability><DeteriorationRate>1</DeteriorationRate></statBases>
    <intricate>true</intricate><thingCategories><li>Manufactured</li></thingCategories>
    <researchPrerequisites><li>HelodTransistor</li></researchPrerequisites>
  </ThingDef>
</Defs>
