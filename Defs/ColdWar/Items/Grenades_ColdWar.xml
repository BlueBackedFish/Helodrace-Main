<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="ResourceBase">
    <defName>HD_Grenade_M14</defName>
    <projectileWhenLoaded>HD_Projectile_M14</projectileWhenLoaded>
    <label>AN-M14 TH3 incendiary grenade</label>
    <description>Heavy thermate grenades designed to destroy equipment, weapons and vehicles with an intensely hot incendiary reaction that readily starts fires.</description>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Weapons/ColdWar/HD_M14</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.78,0.78)</drawSize>
    </graphicData>
    <uiIconScale>1.2</uiIconScale>
    <stackLimit>25</stackLimit>
    <soundInteract>Interact_Grenade</soundInteract>
    <techLevel>Industrial</techLevel>
    <statBases>
      <Mass>0.91</Mass>
      <RangedWeapon_Cooldown>2.8</RangedWeapon_Cooldown>
      <WorkToMake>18000</WorkToMake>
      <MarketValue>440</MarketValue>
    </statBases>
    <costList>
      <Steel>24</Steel>
      <Chemfuel>80</Chemfuel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <recipeMaker>
      <researchPrerequisite>HelodLowGranade</researchPrerequisite>
      <skillRequirements><Crafting>6</Crafting></skillRequirements>
    </recipeMaker>
    <weaponTags>
      <li>HD_ColdWarGrenade</li>
      <li>GrenadeFlame</li>
    </weaponTags>
    <thingCategories><li>HD_InventoryGrenades</li></thingCategories>
    <smeltable>true</smeltable>
    <verbs>
      <li>
        <label>throw AN-M14 grenade</label>
        <verbClass>Verb_LaunchProjectile</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <range>11.9</range>
        <forcedMissRadius>1.8</forcedMissRadius>
        <warmupTime>1.5</warmupTime>
        <requireLineOfSight>true</requireLineOfSight>
        <noiseRadius>4</noiseRadius>
        <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
        <soundCast>ThrowGrenade</soundCast>
        <targetParams><canTargetLocations>true</canTargetLocations></targetParams>
        <defaultProjectile>HD_Projectile_M14</defaultProjectile>
        <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
      </li>
    </verbs>
    <comps>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>0.1</explosiveRadius>
        <explosiveDamageType>Smoke</explosiveDamageType>
        <requiredDamageTypeToExplode>Flame</requiredDamageTypeToExplode>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BaseGrenadeProjectile">
    <defName>HD_Projectile_M14</defName>
    <label>AN-M14 TH3 incendiary grenade</label>
    <thingClass>Helodrace.ModernWar.Projectile_ThermiteGrenade</thingClass>
    <graphicData>
      <texPath>Weapons/ColdWar/Projectiles/M14/HD_M14_proj</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.46,0.46)</drawSize>
    </graphicData>
    <projectile>
      <damageDef>Smoke</damageDef>
      <explosionRadius>0.1</explosionRadius>
      <explosionDelay>90</explosionDelay>
      <doExplosionVFX>false</doExplosionVFX>
      <ai_IsIncendiary>true</ai_IsIncendiary>
      <screenShakeFactor>0.65</screenShakeFactor>
    </projectile>
    <modExtensions>
      <li Class="Helodrace.ModernWar.ModernGrenadeProjectileExtension">
        <clipDef>HD_M14_ClipEffect</clipDef>
        <pinDef>HD_M14_PinEffect</pinDef>
        <fuseTicks>90</fuseTicks>
        <fuseVarianceTicks>12</fuseVarianceTicks>
        <waitForGroundBeforeRelease>true</waitForGroundBeforeRelease>
        <smokeTrail>true</smokeTrail>
        <projectileBounceHeight>0.28</projectileBounceHeight>
      </li>
      <li Class="Helodrace.ModernWar.ThermiteGrenadeExtension">
        <emitterDef>HD_ThermiteGrenadeEmitter</emitterDef>
        <reactionDelayTicks>0</reactionDelayTicks>
        <reactionDurationTicks>420</reactionDurationTicks>
        <damageIntervalTicks>12</damageIntervalTicks>
        <pawnDamageIntervalTicks>30</pawnDamageIntervalTicks>
        <visualIntervalTicks>30</visualIntervalTicks>
        <crossRadius>1</crossRadius>
        <damage>18</damage>
        <pawnDamage>12</pawnDamage>
        <armorPenetration>0.75</armorPenetration>
        <minimumFlammabilityDamageFactor>0.30</minimumFlammabilityDamageFactor>
        <lowFlammabilityThreshold>0.75</lowFlammabilityThreshold>
        <fireSize>1.15</fireSize>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
