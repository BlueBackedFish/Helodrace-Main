<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ApparelNoQualityBase">
    <defName>HD_Apparel_ShieldIronHideRiot</defName>
    <label>Ironhide Riot shield</label>
    <techLevel>Industrial</techLevel>
    <description>A light transparent riot shield with an aluminium frame. It can block frontal melee blows but offers little protection against bullets. Side and rear attacks bypass it. Compatible with the expandable baton and listed pistols; shooting and movement remain awkward.</description>
    <graphicData>
      <texPath>Helod/Apparel/Shield/IronHideRiot/HD_ShieldIronHideRiot_south</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <drawSize>(1.15,1.15)</drawSize>
      <color>(255,255,255)</color>
    </graphicData>
    <statBases>
      <MaxHitPoints>220</MaxHitPoints>
      <WorkToMake>7000</WorkToMake>
      <MarketValue>240</MarketValue>
      <Mass>5</Mass>
      <Flammability>0.05</Flammability>
      <EquipDelay>2</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>-0.12</MoveSpeed>
      <AimingDelayFactor>0.20</AimingDelayFactor>
    </equippedStatOffsets>
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
      </bodyPartGroups>
      <wornGraphicPath>Helod/Apparel/Shield/IronHideRiot/HD_ShieldIronHideRiot</wornGraphicPath>
      <useWornGraphicMask>false</useWornGraphicMask>
      <parentTagDef>ApparelBody</parentTagDef>
      <drawData>
        <defaultData>
          <layer>99</layer>
        </defaultData>
        <dataNorth>
          <layer>-3</layer>
        </dataNorth>
      </drawData>
      <layers>
        <li>Belt</li>
      </layers>
      <tags>
        <li>HD_Apparel</li>
        <li>HD_Apparel_MW_Protective</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Machining</soundWorking>
      <defaultIngredientFilter>
        <thingDefs>
          <li>HD_AluminiumAlloy</li>
          <li>Steel</li>
          <li>Chemfuel</li>
        </thingDefs>
      </defaultIngredientFilter>
      <requiredGiverWorkType>Tailoring</requiredGiverWorkType>
      <workSkill>Crafting</workSkill>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
      <researchPrerequisite>HelodColdWarTech</researchPrerequisite>
      <recipeUsers Inherit="False"><li>HD_ClothingBench</li></recipeUsers>
    </recipeMaker>
    <costList>
      <HD_AluminiumAlloy>20</HD_AluminiumAlloy>
      <Steel>20</Steel>
      <Chemfuel>12</Chemfuel>
    </costList>
    <comps>
      <li Class="Helodrace.ModernWar.CompProperties_DirectionalBallisticShield">
        <frontalArcDegrees>100</frontalArcDegrees>
        <sharpArmorRating>0.18</sharpArmorRating>
        <guaranteedBlockPenetration>0</guaranteedBlockPenetration>
        <rangedAccuracyMultiplier>0.85</rangedAccuracyMultiplier>
        <minimumRangedAccuracyMultiplier>0.5</minimumRangedAccuracyMultiplier>
        <viewportHitChance>0.15</viewportHitChance>
        <viewportDamagePerHit>0.08</viewportDamagePerHit>
        <durabilityFailureThreshold>0.50</durabilityFailureThreshold>
        <durabilityDamageOnBlock>0.7</durabilityDamageOnBlock>
        <durabilityDamageOnPenetrate>1.2</durabilityDamageOnPenetrate>
        <sidewaysMovementSpeedMultiplier>0.9</sidewaysMovementSpeedMultiplier>
        <backwardMovementSpeedMultiplier>0.8</backwardMovementSpeedMultiplier>
        <stationaryAllyCoverBlockChance>0.15</stationaryAllyCoverBlockChance>
        <meleeSharpArmorRating>0.65</meleeSharpArmorRating>
        <meleeBluntArmorRating>1.15</meleeBluntArmorRating>
        <allowedWeaponDefs>
          <li>HD_ExpandableBaton</li>
          <li>Gun_Autopistol</li>
          <li>Gun_Revolver</li>
          <li>Gun_MachinePistol</li>
          <li>HD_Gun_Glock19Gen5_Weapon</li>
          <li>HD_Gun_M1911_Weapon</li>
          <li>HD_Gun_ColtSAA_Weapon</li>
          <li>HD_Gun_ColtArmyModel1860_Weapon</li>
          <li>HD_Gun_SWModelThree_Weapon</li>
          <li>HD_Gun_M8FlareGun_Weapon</li>
        </allowedWeaponDefs>
      </li>
    </comps>
    <modExtensions><li Class="Helodrace.ArmorProductionExtension"><requiresHydraulicPress>true</requiresHydraulicPress></li></modExtensions>
  </ThingDef>
</Defs>
