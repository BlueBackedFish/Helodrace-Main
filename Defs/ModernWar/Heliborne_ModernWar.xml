<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Kept at zero automatic weight until a raid strategy explicitly opts in. -->
  <PawnsArrivalModeDef>
    <defName>HD_MH60M_Heliborne</defName>
    <workerClass>Helodrace.Future.PawnsArrivalModeWorker_Mh60Heliborne</workerClass>
    <selectionWeightCurve>
      <points>
        <li>(0,0)</li>
      </points>
    </selectionWeightCurve>
    <minTechLevel>Industrial</minTechLevel>
    <textEnemy>A helicopter is inserting {0} from {1} by fast-rope!</textEnemy>
    <textFriendly>A friendly helicopter is inserting {0} from {1} by fast-rope.</textFriendly>
    <textWillArrive>{0_pawnsPluralDef} will arrive by helicopter.</textWillArrive>
    <layerWhitelist>
      <li>Surface</li>
    </layerWhitelist>
  </PawnsArrivalModeDef>

  <ThingDef>
    <defName>HD_MH60M_HeliborneAircraft</defName>
    <label>MH-60M helicopter</label>
    <thingClass>Helodrace.Future.Mh60HeliborneAircraft</thingClass>
    <category>Projectile</category>
    <drawerType>RealtimeOnly</drawerType>
    <tickerType>Normal</tickerType>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <useHitPoints>false</useHitPoints>
    <selectable>false</selectable>
    <graphicData>
      <texPath>Effects/Aircraft/MH60M/HD_MH60M_UI</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(160,160)</drawSize>
    </graphicData>
  </ThingDef>

  <ThingDef>
    <defName>HD_SupportHelicopter</defName>
    <label>forward base helicopter</label>
    <thingClass>Helodrace.HelodSupportHelicopter</thingClass>
    <category>Projectile</category>
    <drawerType>RealtimeOnly</drawerType>
    <tickerType>Normal</tickerType>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <useHitPoints>false</useHitPoints>
    <selectable>true</selectable>
    <size>(4,3)</size>
    <passability>Standable</passability>
    <rotatable>false</rotatable>
    <graphicData>
      <texPath>Effects/Aircraft/MH60M/HD_MH60M_UI</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(8,8)</drawSize>
    </graphicData>
  </ThingDef>
  <JobDef>
    <defName>HD_HeliCarry</defName>
    <driverClass>Helodrace.JobDriver_HelodHeliCarry</driverClass>
    <reportString>transporting patient to destination.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>
  <JobDef>
    <defName>HD_HeliBoard</defName>
    <driverClass>Helodrace.JobDriver_HelodHeliBoard</driverClass>
    <reportString>boarding helicopter.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>
</Defs>
