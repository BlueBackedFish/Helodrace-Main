<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="ResourceBase">
    <defName>HD_ModularWeaponPartsBox</defName>
    <label>weapon-parts box</label>
    <description>A portable parts box inserted into a gunsmith table. Its stored modular parts are used for weapon modification.</description>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Items/HD_WeaponPartBox</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.9,0.9)</drawSize>
    </graphicData>
    <stackLimit>1</stackLimit>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToMake>3500</WorkToMake>
      <MarketValue>220</MarketValue>
      <Flammability>0.35</Flammability>
      <Mass>12</Mass>
    </statBases>
    <thingCategories><li>Manufactured</li></thingCategories>
    <costList><Steel>45</Steel><ComponentIndustrial>2</ComponentIndustrial></costList>
    <recipeMaker>
      <researchPrerequisite>HelodColdWarTech</researchPrerequisite>
      <workSkill>Crafting</workSkill>
      <skillRequirements><Crafting>4</Crafting></skillRequirements>
      <recipeUsers><li>HD_GunSmithTable</li></recipeUsers>
    </recipeMaker>
    <comps>
      <li Class="Helodrace.ModernWar.CompProperties_ModularWeaponPartsBox" />
    </comps>
  </ThingDef>

  <!-- A tradeable container of virtual part counts, never loose part Things. -->
  <ThingDef ParentName="ResourceBase">
    <defName>HD_ModularP320FluxPartsBox</defName>
    <label>P320 Flux Raider parts box</label>
    <description>A sealed box of P320 conversion parts. Insert it into a gunsmith table to use its contents.</description>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Items/HD_WeaponPartBox</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.9,0.9)</drawSize>
    </graphicData>
    <stackLimit>1</stackLimit>
    <tradeability>Buyable</tradeability>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <MarketValue>900</MarketValue>
      <Flammability>0.35</Flammability>
      <Mass>12</Mass>
    </statBases>
    <thingCategories><li>Manufactured</li></thingCategories>
    <comps>
      <li Class="Helodrace.ModernWar.CompProperties_ModularWeaponPartsBox">
        <initialVirtualParts>
          <HD_ModularPart_Receiver_FluxRaiderKit>1</HD_ModularPart_Receiver_FluxRaiderKit>
          <HD_ModularPart_Stock_FluxRaiderKit>1</HD_ModularPart_Stock_FluxRaiderKit>
          <HD_ModularPart_Mount_T2Low>1</HD_ModularPart_Mount_T2Low>
          <HD_ModularPart_Optic_PointSightT2_Part>1</HD_ModularPart_Optic_PointSightT2_Part>
          <HD_ModularPart_Laser_DBALPL>1</HD_ModularPart_Laser_DBALPL>
          <HD_ModularPart_Barrel_P32047Threaded>1</HD_ModularPart_Barrel_P32047Threaded>
          <HD_ModularPart_Suppressor_HelveticSRD9_Part>1</HD_ModularPart_Suppressor_HelveticSRD9_Part>
          <HD_ModularPart_Magazine_P32021_Part>1</HD_ModularPart_Magazine_P32021_Part>
        </initialVirtualParts>
      </li>
    </comps>
  </ThingDef>

</Defs>
