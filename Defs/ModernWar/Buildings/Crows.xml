<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>HD_CrowsComputer</defName>
    <label>computer</label>
    <description>A wired computer workstation with a monitor and input controls for operating a connected CROWS II weapon station.</description>
    <thingClass>Helodrace.Building_CrowsComputer</thingClass>
    <graphicData>
      <texPath>Buildings/ComputerDesk/HD_ComputerDesk</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>(3,3)</drawSize>
      <!-- Center the desktop surface, including the connected controller variant. -->
      <drawOffset>(0,0,-0.346313238)</drawOffset>
    </graphicData>
    <drawerType>RealtimeOnly</drawerType>
    <size>(2,1)</size>
    <rotatable>true</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <tickerType>Normal</tickerType>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <fillPercent>0.5</fillPercent>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <designationCategory>HD_HelodTechnology_Build</designationCategory>
    <uiOrder>2580</uiOrder>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites><li>HelodRemoteWeaponControl</li></researchPrerequisites>
    <statBases>
      <MaxHitPoints>160</MaxHitPoints>
      <WorkToBuild>4000</WorkToBuild>
      <Mass>55</Mass>
      <Flammability>0.7</Flammability>
    </statBases>
    <costList>
      <Steel>80</Steel>
      <WoodLog>60</WoodLog>
      <HD_BasicElectricalComponents>12</HD_BasicElectricalComponents>
      <HD_ElectronicComponent>4</HD_ElectronicComponent>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>200</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Forbiddable"/>
    </comps>
    <modExtensions><li Class="Helodrace.ContentUsageExtension"><helpKey>HD_ContentUsage_HD_CrowsComputer</helpKey></li></modExtensions>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>HD_Building_CrowsII</defName>
    <modExtensions>
      <li Class="Helodrace.ContentUsageExtension"><helpKey>HD_ContentUsage_HD_Building_CrowsII</helpKey></li>
      <li Class="Helodrace.HeavyMachineGunAccuracyExtension"><gunnerBaseAccuracy>0.5</gunnerBaseAccuracy></li>
    </modExtensions>
    <label>CROWS II emplacement</label>
    <description>An anchored CROWS II weapon station fitted with a weapon and ammunition feed, controlled by an operator at a connected computer.</description>
    <thingClass>Helodrace.Building_Crows</thingClass>
    <graphicData>
      <texPath>Buildings/Security/CROWSII/FixedMount/HD_CROWSII_FixedMount_top</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>(3.2,3.2)</drawSize>
    </graphicData>
    <uiIconPath>Buildings/Security/CROWSII/Unarmed/HD_CROWSII_Unarmed_UI</uiIconPath>
    <drawerType>MapMeshAndRealTime</drawerType>
    <drawHighlight>true</drawHighlight>
    <drawHighlightOnlyForHostile>true</drawHighlightOnlyForHostile>
    <size>(2,2)</size>
    <rotatable>true</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <tickerType>Normal</tickerType>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <designationCategory>HD_HelodTechnology_Build</designationCategory>
    <uiOrder>2581</uiOrder>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites><li>HelodRemoteWeaponControl</li></researchPrerequisites>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>4700</WorkToBuild>
      <Flammability>0.25</Flammability>
      <Mass>230</Mass>
      <ShootingAccuracyTurret>0.95</ShootingAccuracyTurret>
    </statBases>
    <costList>
      <HD_GeneralMachinePart>12</HD_GeneralMachinePart>
      <HD_CarbonSteel>110</HD_CarbonSteel>
      <HD_PressComponent>8</HD_PressComponent>
      <HD_UniformRolledSteelPlate>4</HD_UniformRolledSteelPlate>
      <HD_BasicElectricalComponents>16</HD_BasicElectricalComponents>
      <HD_ElectronicComponent>6</HD_ElectronicComponent>
    </costList>
    <building>
      <turretGunDef>HD_Gun_CrowsII_Empty</turretGunDef>
      <turretBurstWarmupTime>1.2</turretBurstWarmupTime>
      <turretBurstCooldownTime>0.2</turretBurstCooldownTime>
      <turretTopDrawSize>3.2</turretTopDrawSize>
    </building>
    <placeWorkers><li>PlaceWorker_TurretTop</li></placeWorkers>
    <comps>
      <li Class="Helodrace.CompProperties_CrowsAmmo">
        <fuelLabel>CROWS ammunition</fuelLabel>
        <fuelGizmoLabel>Ammunition</fuelGizmoLabel>
        <outOfFuelMessage>Needs ammunition</outOfFuelMessage>
        <fuelFilter><thingDefs><li>Steel</li></thingDefs></fuelFilter>
        <fuelCapacity>100</fuelCapacity>
        <initialFuelPercent>0</initialFuelPercent>
        <autoRefuelPercent>0.25</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <minimumFueledThreshold>1</minimumFueledThreshold>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>100</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="Helodrace.CompProperties_CrowsGraphic"/>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BaseWeaponTurret">
    <defName>HD_Gun_CrowsII</defName>
    <label>CROWS II M2HB QCB</label>
    <description>The remote station's belt-fed M2HB QCB.</description>
    <graphicData>
      <texPath>Buildings/Security/HD_Transparent</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <AccuracyTouch>0.48</AccuracyTouch>
      <AccuracyShort>0.72</AccuracyShort>
      <AccuracyMedium>0.82</AccuracyMedium>
      <AccuracyLong>0.74</AccuracyLong>
      <RangedWeapon_Cooldown>0.2</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>Helodrace.Verb_Crows</verbClass>
        <defaultProjectile>HD_Bullet_M2HB_Proj</defaultProjectile>
        <warmupTime>0</warmupTime>
        <range>42.9</range>
        <burstShotCount>10</burstShotCount>
        <ticksBetweenBurstShots>7</ticksBetweenBurstShots>
        <targetParams><canTargetLocations>true</canTargetLocations></targetParams>
        <soundCast>HD_M2Fire</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>14</muzzleFlashScale>
        <consumeFuelPerShot>1</consumeFuelPerShot>
      </li>
    </verbs>
    <modExtensions><li Class="Helodrace.MixedMagazineExtension"><projectileSequence>
      <li>HD_Bullet_M2HB_Proj</li><li>HD_Bullet_M2HB_Proj</li><li>HD_Bullet_M2HB_Proj</li><li>HD_Bullet_M2HB_Proj</li><li>HD_Bullet_M2HB_M20_Proj</li>
    </projectileSequence></li></modExtensions>
  </ThingDef>
</Defs>
