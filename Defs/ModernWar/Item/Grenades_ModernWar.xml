<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef Name="HD_ModernGrenadeBase" ParentName="ResourceBase" Abstract="True">
    <tickerType>Normal</tickerType>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.78,0.78)</drawSize>
    </graphicData>
    <uiIconScale>1.2</uiIconScale>
    <stackLimit>25</stackLimit>
    <soundInteract>Interact_Grenade</soundInteract>
    <techLevel>Industrial</techLevel>
    <statBases>
      <Mass>0.45</Mass>
      <RangedWeapon_Cooldown>2.4</RangedWeapon_Cooldown>
      <WorkToMake>14000</WorkToMake>
      <MarketValue>320</MarketValue>
    </statBases>
    <costList>
      <Steel>18</Steel>
      <Chemfuel>55</Chemfuel>
    </costList>
    <recipeMaker>
      <researchPrerequisite>HelodLowGranade</researchPrerequisite>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
    </recipeMaker>
    <weaponTags>
      <li>HD_ModernWarWeapon</li>
      <li>GrenadeDestructive</li>
    </weaponTags>
    <thingCategories>
      <li>HD_InventoryGrenades</li>
    </thingCategories>
    <smeltable>true</smeltable>
    <verbs />
  </ThingDef>

  <ThingDef ParentName="HD_ModernGrenadeBase">
    <defName>HD_Grenade_M67</defName>
    <projectileWhenLoaded>HD_Projectile_M67</projectileWhenLoaded>
    <label>M67 fragmentation grenade</label>
    <description>Modern defensive hand grenades whose steel bodies scatter lethal fragments across a broad area.</description>
    <graphicData>
      <texPath>Weapon/ModernWar/HD_M67</texPath>
    </graphicData>
    <verbs Inherit="False">
      <li>
        <label>throw M67 grenade</label>
        <verbClass>Verb_LaunchProjectile</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <range>13.9</range>
        <forcedMissRadius>1.6</forcedMissRadius>
        <warmupTime>1.35</warmupTime>
        <noiseRadius>4</noiseRadius>
        <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
        <soundCast>ThrowGrenade</soundCast>
        <targetParams><canTargetLocations>true</canTargetLocations></targetParams>
        <defaultProjectile>HD_Projectile_M67</defaultProjectile>
        <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
      </li>
    </verbs>
    <comps>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>2.66</explosiveRadius>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <requiredDamageTypeToExplode>Flame</requiredDamageTypeToExplode>
      </li>
    </comps>
  </ThingDef>

