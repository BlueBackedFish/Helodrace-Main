<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>HD_ZaperX26_Shock</defName>
    <label>ZAPER electroshock</label>
    <description>Two wired probes are delivering repeated electrical pulses, causing severe pain and disrupting voluntary movement.</description>
    <defaultLabelColor>(0.55,0.75,1.0)</defaultLabelColor>
    <isBad>true</isBad>
    <stages>
      <li>
        <painOffset>0.60</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.75</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.70</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>HD_ZaperX26_ContactShock</defName>
    <label>ZAPER contact shock</label>
    <description>A direct discharge from the weapon's contact electrodes is causing intense, short-lived pain.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55,0.75,1.0)</defaultLabelColor>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120~120</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <painOffset>0.85</painOffset>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>HD_FlashbangSuppression</defName>
    <label>flashbang suppression</label>
    <labelNoun>flashbang suppression</labelNoun>
    <description>Overwhelming light and sound from a flashbang are suppressing the senses and disrupting coordinated action. The effect fades progressively as vision and hearing recover.</description>
    <hediffClass>Helodrace.ModernWar.Hediff_FlashbangSuppression</hediffClass>
    <defaultLabelColor>(1.0,0.88,0.45)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <isBad>true</isBad>
    <tendable>false</tendable>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-36</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <label>disoriented</label>
        <minSeverity>0.01</minSeverity>
        <capMods>
          <li><capacity>Sight</capacity><offset>-0.35</offset></li>
          <li><capacity>Hearing</capacity><offset>-0.55</offset></li>
          <li><capacity>Manipulation</capacity><postFactor>0.75</postFactor></li>
        </capMods>
      </li>
      <li>
        <label>dazed</label>
        <minSeverity>0.25</minSeverity>
        <capMods>
          <li><capacity>Sight</capacity><offset>-0.70</offset></li>
          <li><capacity>Hearing</capacity><offset>-0.90</offset></li>
          <li><capacity>Manipulation</capacity><postFactor>0.50</postFactor></li>
        </capMods>
      </li>
      <li>
        <label>heavily suppressed</label>
        <minSeverity>0.50</minSeverity>
        <capMods>
          <li><capacity>Sight</capacity><offset>-0.95</offset></li>
          <li><capacity>Hearing</capacity><offset>-1.00</offset></li>
          <li><capacity>Manipulation</capacity><postFactor>0.20</postFactor></li>
        </capMods>
      </li>
      <li>
        <label>overwhelmed</label>
        <minSeverity>0.75</minSeverity>
        <capMods>
          <li><capacity>Sight</capacity><offset>-1.00</offset></li>
          <li><capacity>Hearing</capacity><offset>-1.00</offset></li>
          <li><capacity>Manipulation</capacity><postFactor>0.08</postFactor></li>
          <li><capacity>Moving</capacity><offset>-0.30</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
