  <Helodrace.ModernWar.ModularWeaponPresetDef>
    <defName>HD_WeaponPreset_ModularP320_FluxRaider</defName>
    <label>modular P320 Flux Raider configuration</label>
    <weaponDef>HD_Gun_P320_Weapon</weaponDef>
