  <ThingDef ParentName="HD_ModernGrenadeProjectileBase">
    <defName>HD_Projectile_M67</defName>
    <label>M67 fragmentation grenade</label>
    <thingClass>Helodrace.ModernWar.Projectile_ExplosiveGrenade</thingClass>
    <graphicData>
      <texPath>Weapons/ModernWar/Projectiles/HD_M67_proj</texPath>
    </graphicData>
    <projectile>
      <damageDef>Bomb</damageDef>
      <damageAmountBase>45</damageAmountBase>
      <armorPenetrationBase>0.35</armorPenetrationBase>
      <explosionRadius>3.1</explosionRadius>
    </projectile>
    <modExtensions>
      <li Class="Helodrace.ModernWar.ModernGrenadeProjectileExtension">
        <clipDef>HD_M67_ClipEffect</clipDef>
        <pinDef>HD_M67_PinEffect</pinDef>
      </li>
      <li Class="Helodrace.ModernWar.ExplosiveGrenadeVisualExtension">
        <smokeCount>32</smokeCount>
        <initialRadius>0.30</initialRadius>
        <expansionSpeed>1.9</expansionSpeed>
        <smokeScale>0.92</smokeScale>
      </li>
      <li Class="Helodrace.ModernWar.FragmentationGrenadeExtension">
        <fragmentProjectile>HD_Projectile_M67Fragment</fragmentProjectile>
        <fragmentCount>64</fragmentCount>
        <radius>12.75</radius>
        <minimumRangeFactor>0.50</minimumRangeFactor>
        <targetedFragmentFraction>0.55</targetedFragmentFraction>
        <closeAimMultiplier>1.65</closeAimMultiplier>
        <edgeAimMultiplier>0.25</edgeAimMultiplier>
        <longRangeFragmentFraction>0.16</longRangeFragmentFraction>
        <longRangeRadius>18</longRangeRadius>
        <longRangeMinimumFactor>0.72</longRangeMinimumFactor>
      </li>
      <li Class="Helodrace.ModernWar.FlashbangProjectileExtension">
        <suppressionHediff>HD_FlashbangSuppression</suppressionHediff>
        <effectRadius>9</effectRadius>
        <indoorRadiusFactor>1.35</indoorRadiusFactor>
        <outdoorDistanceExponent>1.30</outdoorDistanceExponent>
        <indoorDistanceExponent>0.75</indoorDistanceExponent>
        <severityAtCenter>0.82</severityAtCenter>
        <severityAtEdge>0.08</severityAtEdge>
        <outdoorFactor>0.60</outdoorFactor>
        <smallRoomCellCount>16</smallRoomCellCount>
        <largeRoomCellCount>160</largeRoomCellCount>
        <smallRoomFactor>1.30</smallRoomFactor>
        <largeRoomFactor>0.75</largeRoomFactor>
        <differentRoomFactor>0.55</differentRoomFactor>
        <blockedPathFactor>0.12</blockedPathFactor>
        <stunThreshold>0.65</stunThreshold>
        <stunFullIntensity>0.95</stunFullIntensity>
        <stunTicksMin>90</stunTicksMin>
        <stunTicksMax>150</stunTicksMax>
      </li>
    </modExtensions>
  </ThingDef>

