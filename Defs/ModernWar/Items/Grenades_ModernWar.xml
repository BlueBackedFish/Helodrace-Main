  <ThingDef ParentName="HD_ModernGrenadeBase">
    <defName>HD_Grenade_M67</defName>
    <projectileWhenLoaded>HD_Projectile_M67</projectileWhenLoaded>
    <label>M67 fragmentation grenade</label>
    <description>Modern defensive hand grenades whose steel bodies scatter lethal fragments across a broad area.</description>
    <graphicData>
      <texPath>Weapons/ModernWar/HD_M67</texPath>
    </graphicData>
    <verbs Inherit="False">
      <li>
        <label>throw M67 grenade</label>
        <verbClass>Verb_LaunchProjectile</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <range>13.9</range>
        <forcedMissRadius>1.6</forcedMissRadius>
        <warmupTime>1.35</warmupTime>
        <requireLineOfSight>true</requireLineOfSight>
        <noiseRadius>4</noiseRadius>
        <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
        <soundCast>ThrowGrenade</soundCast>
        <targetParams><canTargetLocations>true</canTargetLocations></targetParams>
        <defaultProjectile>HD_Projectile_M67</defaultProjectile>
        <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
      </li>
    </verbs>
    <comps>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>2.66</explosiveRadius>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <requiredDamageTypeToExplode>Flame</requiredDamageTypeToExplode>
      </li>
    </comps>
  </ThingDef>

