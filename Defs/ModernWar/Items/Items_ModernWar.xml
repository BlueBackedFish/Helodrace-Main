  <ThingDef ParentName="ApparelNoQualityBase">
    <defName>HD_Apparel_ShieldDefenTechIIIA</defName>
    <label>DefenTech IIIA light shield</label>
    <description>A lightweight class IIIA handheld ballistic shield inspired by the compact Intruder G2 profile. Its broad transparent viewport and reduced mass make it far more mobile than a full-size class IV shield, though its frontal protection, durability, and ability to shelter another pawn are correspondingly lower. It is intended to be paired with compact one-handed firearms. Attacks from the sides or rear bypass the shield entirely.</description>
    <graphicData>
      <texPath>Helod/Apparel/Shield/DefenTechIIIA/HD_ShieldDefenTechIIIA_south</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <drawSize>(1.0,1.0)</drawSize>
      <color>(255,255,255)</color>
    </graphicData>
    <statBases>
      <MaxHitPoints>260</MaxHitPoints>
      <WorkToMake>9000</WorkToMake>
      <MarketValue>680</MarketValue>
      <Mass>7.5</Mass>
      <Flammability>0.08</Flammability>
