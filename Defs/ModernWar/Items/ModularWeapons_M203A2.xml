<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The three 1024px sprites are authored on one canvas. The body replaces
       the HAC URX lower handguard; the barrel and trigger retain its alignment. -->
  <ThingDef ParentName="HD_ModularWeaponPartBase">
    <defName>HD_ModularPart_Underbarrel_M203A2_Part</defName><label>M203A2 underbarrel launcher</label>
    <description>An M203A2 assembly that replaces the HAC URX lower handguard and fires 40×46mm grenades from the operator's inventory.</description>
    <graphicData><texPath>Weapons/Modular/Tactical/HD_UB_M203A2</texPath></graphicData>
    <comps><li Class="Helodrace.ModernWar.CompProperties_ModularWeaponNode">
      <craftCost><Steel>8</Steel><ComponentIndustrial>2</ComponentIndustrial></craftCost><requiredResearch><li>HelodHighAutomaticRifle</li></requiredResearch>
      <graphicLayer>1</graphicLayer><internalStats><massKg>1.4</massKg><ergonomics>-10</ergonomics><momentOfInertia>0.015</momentOfInertia></internalStats>
      <mounts>
        <li><id>urx_lower_mount</id><socketTags><li>hac_urx_lower</li></socketTags><transform><position>(-0.013,0,-0.014)</position></transform></li>
        <li><id>urx_m4_lower_mount</id><socketTags><li>hac_urx_m4_lower</li></socketTags><transform><position>(-0.016,0,-0.014)</position></transform></li>
      </mounts>
      <sockets>
        <li><id>launcher_barrel</id><label>M203A2 barrel guide</label><tags><li>m203a2_barrel</li></tags><transform><position>(0.11,0,-0.05)</position></transform></li>
        <li><id>launcher_trigger</id><label>M203A2 trigger group</label><tags><li>m203a2_trigger</li></tags><transform><position>(-0.02,0,-0.07)</position></transform></li>
      </sockets>
      <defaultAttachments>
        <li><socketId>launcher_barrel</socketId><part>HD_ModularPart_UnderbarrelBarrel_M203A2_Part</part></li>
        <li><socketId>launcher_trigger</socketId><part>HD_ModularPart_UnderbarrelTrigger_M203A2_Part</part></li>
      </defaultAttachments>
    </li>
    <li Class="Helodrace.ModernWar.CompProperties_ModularUnderbarrelLauncher">
      <allowedAmmoDefs>
        <li>HD_40mmM381HE_Round</li><li>HD_40mmM433HEDP_Round</li><li>HD_40mmM576MP_Round</li><li>HD_40mmM651CS_Round</li><li>HD_40mmSponge_Round</li>
      </allowedAmmoDefs>
      <reloadTicks>90</reloadTicks>
    </li></comps>
  </ThingDef>
  <ThingDef ParentName="HD_ModularWeaponPartBase">
    <defName>HD_ModularPart_UnderbarrelBarrel_M203A2_Part</defName><label>M203A2 launcher barrel</label>
    <graphicData><texPath>Weapons/Modular/Barrels/HD_UB_M203A2_Barrel</texPath></graphicData>
    <comps><li Class="Helodrace.ModernWar.CompProperties_ModularWeaponNode"><craftCost><Steel>4</Steel></craftCost><requiredResearch><li>HelodHighAutomaticRifle</li></requiredResearch><graphicLayer>2</graphicLayer><mounts><li><id>barrel_mount</id><socketTags><li>m203a2_barrel</li></socketTags><transform><position>(0.11,0,-0.05)</position></transform></li></mounts></li></comps>
  </ThingDef>
  <ThingDef ParentName="HD_ModularWeaponPartBase">
    <defName>HD_ModularPart_UnderbarrelTrigger_M203A2_Part</defName><label>M203A2 launcher trigger</label>
    <graphicData><texPath>Weapons/Modular/Actions/HD_UB_M203A2_Trigger</texPath></graphicData>
    <comps><li Class="Helodrace.ModernWar.CompProperties_ModularWeaponNode"><craftCost><Steel>1</Steel></craftCost><requiredResearch><li>HelodHighAutomaticRifle</li></requiredResearch><graphicLayer>3</graphicLayer><mounts><li><id>trigger_mount</id><socketTags><li>m203a2_trigger</li></socketTags><transform><position>(-0.02,0,-0.07)</position></transform></li></mounts></li></comps>
  </ThingDef>
</Defs>
