  <ThingDef ParentName="BaseBullet">
    <defName>HD_Bullet_76251MK316_Proj</defName><label>7.62x51mm MK316 match bullet</label>
    <thingClass>Helodrace.Projectile_FragmentingBullet</thingClass>
    <graphicData><texPath>Things/Projectile/Bullet_Small</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <modExtensions>
      <li Class="Helodrace.BulletBallisticsExtension"><projectileMassGrams>11.3</projectileMassGrams><referenceVelocityMetersPerSecond>790</referenceVelocityMetersPerSecond><referenceBarrelInches>20</referenceBarrelInches><velocityHalfDistance>90</velocityHalfDistance></li>
      <li Class="Helodrace.BulletFragmentationExtension"><chance>0.7</chance><damageFraction>0.5</damageFraction><maxFragments>5</maxFragments></li>
    </modExtensions>
    <projectile><damageDef>Bullet</damageDef><damageAmountBase>17</damageAmountBase><armorPenetrationBase>0.26</armorPenetrationBase><stoppingPower>1</stoppingPower><speed>85</speed></projectile>
