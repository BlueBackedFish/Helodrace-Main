<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Game balance profiles, not a real-world performance table. Each cartridge
       has its own projectile. M198 launches two lower-damage ballistic bullets
       while consuming one round; AP/SLAP rounds do not fragment. -->

  <ThingDef ParentName="BaseBullet">
    <defName>HD_Bullet_76251M198_Proj</defName><label>7.62x51mm M198 duplex bullet</label>
    <thingClass>Helodrace.Projectile_DuplexBullet</thingClass>
    <graphicData><texPath>Things/Projectile/Bullet_Small</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <modExtensions>
      <li Class="Helodrace.BulletBallisticsExtension"><projectileMassGrams>5.44</projectileMassGrams><referenceVelocityMetersPerSecond>850</referenceVelocityMetersPerSecond><referenceBarrelInches>20</referenceBarrelInches><velocityHalfDistance>40</velocityHalfDistance><diameterMillimeters>7.8</diameterMillimeters><penetratorClass>Soft</penetratorClass></li>
      <li Class="Helodrace.DuplexProjectileExtension"><secondarySpreadDegrees>1.2</secondarySpreadDegrees></li>
    </modExtensions>
    <projectile><damageDef>Bullet</damageDef><damageAmountBase>8</damageAmountBase><armorPenetrationBase>0.14</armorPenetrationBase><stoppingPower>0.45</stoppingPower><speed>90</speed></projectile>
  </ThingDef>
  <ThingDef ParentName="BaseBullet">
    <defName>HD_Bullet_76251M948_Proj</defName><label>7.62x51mm M948 SLAP bullet</label>
    <thingClass>Helodrace.Projectile_BallisticBullet</thingClass>
    <graphicData><texPath>Things/Projectile/Bullet_Small</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <modExtensions><li Class="Helodrace.BulletBallisticsExtension"><projectileMassGrams>4</projectileMassGrams><referenceVelocityMetersPerSecond>1200</referenceVelocityMetersPerSecond><referenceBarrelInches>20</referenceBarrelInches><velocityHalfDistance>50</velocityHalfDistance><diameterMillimeters>5.6</diameterMillimeters><penetratorClass>Tungsten</penetratorClass></li></modExtensions>
    <projectile><damageDef>Bullet</damageDef><damageAmountBase>9</damageAmountBase><armorPenetrationBase>0.58</armorPenetrationBase><stoppingPower>0.35</stoppingPower><speed>110</speed></projectile>
  </ThingDef>
