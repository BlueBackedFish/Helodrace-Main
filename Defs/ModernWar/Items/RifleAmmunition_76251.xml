      <li Class="Helodrace.BulletFragmentationExtension"><chance>0.75</chance><armorResistanceFactor>0.4</armorResistanceFactor><damageFraction>0.55</damageFraction><maxFragments>6</maxFragments></li>
    </modExtensions>
    <projectile><damageDef>Bullet</damageDef><damageAmountBase>18</damageAmountBase><armorPenetrationBase>0.29</armorPenetrationBase><stoppingPower>1.1</stoppingPower><speed>95</speed></projectile>
  </ThingDef>

  <ThingDef ParentName="HD_RifleAmmunitionBase">
    <defName>HD_Ammunition_76251M198_Ammo</defName>
    <label>7.62x51mm M198 cartridge (DUPLEX)</label>
    <description>A 7.62x51mm duplex cartridge carrying two projectiles in one case.</description>
    <graphicData><texPath>Weapons/Modular/Ammunition/HD_Ammunition_76251M198</texPath></graphicData>
    <statBases><Mass>0.025</Mass><MarketValue>4</MarketValue></statBases>
    <comps><li Class="Helodrace.ModernWar.CompProperties_ModularWeaponNode">
      <requiredResearch><li>HelodHighAutomaticRifle</li></requiredResearch>
      <storageMode>Internal</storageMode><hideWhenAttached>true</hideWhenAttached>
      <ammunitionType>7.62 M198 (DUPLEX)</ammunitionType>
      <ammunitionCaliber>762x51</ammunitionCaliber><projectileDiameterMm>7.82</projectileDiameterMm>
      <projectileOverride>HD_Bullet_76251M198_Proj</projectileOverride>
      <casingMoteDef>HD_Mote_Shell76251_Mote</casingMoteDef>
      <feedingRoundTexPath>Weapons/Modular/Ammunition/HD_Bullet_76251M198</feedingRoundTexPath>
      <overridePriority>30</overridePriority>
      <mounts><li><id>ammunition_mount</id><socketTags><li>m14_ammunition</li></socketTags><transform><position>(-0.035,0,-0.088)</position></transform></li></mounts>
    </li></comps>
  </ThingDef>

