<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- MP5-family parts use their own socket tags. The common 1024px authoring
       canvas lets matching socket and mount coordinates preserve exact alignment. -->

  <ThingDef ParentName="HD_ModularWeaponPartBase">
    <defName>HD_ModularPart_CockingTube_MP5</defName>
    <label>MP5 cocking tube</label>
    <description>The forward receiver extension containing the MP5 cocking tube and charging-handle track.</description>
    <graphicData><texPath>Weapons/Modular/Receivers/HD_ReceiverExt_MP5CockingTube</texPath></graphicData>
    <comps>
      <li Class="Helodrace.ModernWar.CompProperties_ModularWeaponNode">
        <partCategory>Required</partCategory>
        <graphicLayer>0.5</graphicLayer>
        <mounts><li><id>cocking_tube_mount</id><socketTags><li>mp5_cocking_tube_standard</li></socketTags><transform><position>(-0.008,0,0.058)</position></transform></li></mounts>
        <sockets>
          <li><id>front_sight</id><label>MP5 cocking-tube front sight base</label><tags><li>mp5_front_sight_standard</li></tags><transform><position>(0.160,0,0.080)</position></transform></li>
        </sockets>
        <defaultAttachments><li><socketId>front_sight</socketId><part>HD_ModularPart_FrontSight_MP5</part></li></defaultAttachments>
      </li>
    </comps>
  </ThingDef>

