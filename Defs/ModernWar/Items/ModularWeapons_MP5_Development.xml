        <sockets>
          <li><id>muzzle</id><label>MP5 bare muzzle</label><tags><li>mp5_muzzle</li></tags><transform><position>(0.196,0,0.029)</position></transform></li>
          <li><id>handguard</id><label>standard MP5 handguard interface</label><tags><li>mp5_handguard_standard</li></tags><transform><position>(0,0,0.031)</position></transform></li>
        </sockets>
