    <graphicData><texPath>Weapons/Modular/Barrels/HD_Barrel_MP5</texPath></graphicData>
    <comps>
      <li Class="Helodrace.ModernWar.CompProperties_ModularWeaponNode">
        <partCategory>Required</partCategory>
        <graphicLayer>-4</graphicLayer>
        <chamberCaliber>9x19</chamberCaliber>
        <ceAmmoSetDefName>AmmoSet_9x19mmPara</ceAmmoSetDefName>
        <boreDiameterMm>9.03</boreDiameterMm>
