  <ThingDef Name="HD_MP5FamilyBase" ParentName="BaseHumanMakeableGun" Abstract="True">
    <thingClass>Helodrace.ModernWar.ModularWeaponThing</thingClass>
    <graphicData><texPath>Weapons/Modular/Receivers/HD_Receiver_MP5</texPath><graphicClass>Helodrace.ModernWar.Graphic_ModularWeaponAssembly</graphicClass><drawSize>(1,1)</drawSize></graphicData>
    <equippedAngleOffset>0</equippedAngleOffset><soundInteract>Interact_Rifle</soundInteract>
    <weaponClasses><li>RangedLight</li></weaponClasses>
    <weaponTags><li>HD_ModernWarWeapon</li><li>IndustrialGunAdvanced</li></weaponTags>
    <statBases><WorkToMake>34000</WorkToMake><Mass>2.9</Mass><MarketValue>1050</MarketValue><MaxHitPoints>100</MaxHitPoints><AccuracyTouch>0.78</AccuracyTouch><AccuracyShort>0.84</AccuracyShort><AccuracyMedium>0.65</AccuracyMedium><AccuracyLong>0.40</AccuracyLong><RangedWeapon_Cooldown>1.35</RangedWeapon_Cooldown></statBases>
    <costList><Steel>45</Steel><ComponentIndustrial>4</ComponentIndustrial><ComponentSpacer>1</ComponentSpacer></costList>
    <recipeMaker><skillRequirements><Crafting>8</Crafting></skillRequirements><researchPrerequisite>HelodHighAutomaticRifle</researchPrerequisite><recipeUsers Inherit="False"><li>HD_BasicWorkbench</li></recipeUsers></recipeMaker>
    <verbs>
      <li><verbClass>Verb_Shoot</verbClass><hasStandardCommand>true</hasStandardCommand><defaultProjectile>HD_Bullet_Glock19_Proj</defaultProjectile><warmupTime>0.55</warmupTime><range>23.9</range><burstShotCount>6</burstShotCount><ticksBetweenBurstShots>5</ticksBetweenBurstShots><soundCast>Shot_Autopistol</soundCast><soundCastTail>GunTail_Light</soundCastTail><muzzleFlashScale>5</muzzleFlashScale></li>
    </verbs>
    <tools><li><label>stock</label><capacities><li>Blunt</li></capacities><power>7</power><cooldownTime>1.7</cooldownTime></li></tools>
  </ThingDef>

  <ThingDef ParentName="HD_MP5FamilyBase">
    <defName>HD_Gun_ModularMP5_Test_Weapon</defName>
    <label>modular MP5 development submachine gun</label>
    <description>A roller-delayed 9x19mm submachine gun built from independently configurable MP5-family components.</description>
    <comps>
      <li Class="Helodrace.ModernWar.CompProperties_ModularWeaponNode">
        <isAssemblyRoot>true</isAssemblyRoot><partCategory>Required</partCategory><realisticRoundsPerMinute>800</realisticRoundsPerMinute><baseFireDelayFactor>1.2</baseFireDelayFactor><graphicLayer>0</graphicLayer><outlinePriority>100</outlinePriority>
        <casingPort><offset>(-0.064,0,0.046)</offset><ejectionAngleOffset>90</ejectionAngleOffset><speedMin>1.5</speedMin><speedMax>2.1</speedMax><scale>0.75</scale><ejectionCycleFraction>0.30</ejectionCycleFraction><feedStartCycleFraction>0.55</feedStartCycleFraction><feedEndCycleFraction>0.92</feedEndCycleFraction><feedStartOffset>(-0.034,0,0.012)</feedStartOffset><feedEndOffset>(-0.001,0,0.028)</feedEndOffset><feedingRoundDrawSize>0.075</feedingRoundDrawSize></casingPort>
        <internalStats><massKg>0.75</massKg><recoilImpulse>2.4</recoilImpulse><ergonomics>70</ergonomics><muzzleRise>2.1</muzzleRise><operatingReliability>0.98</operatingReliability><gasFlow>1</gasFlow><momentOfInertia>0.022</momentOfInertia><targetAcquisition>67</targetAcquisition><aimingPrecision>60</aimingPrecision><identificationDistanceMeters>180</identificationDistanceMeters></internalStats>
        <sockets>
          <li><id>cocking_tube</id><label>MP5 cocking-tube interface</label><tags><li>mp5_cocking_tube_standard</li><li>mp5_cocking_tube_sd</li></tags><required>true</required><transform><position>(-0.008,0,0.058)</position></transform></li>
          <li><id>barrel</id><label>MP5 receiver barrel trunnion</label><tags><li>mp5_barrel</li></tags><required>true</required><transform><position>(0,0,0.031)</position></transform></li>
          <li><id>bolt</id><label>MP5 bolt group</label><tags><li>mp5_bolt</li></tags><required>true</required><transform><position>(-0.056,0,0.047)</position></transform></li>
          <li><id>rear_sight</id><label>MP5 rear sight base</label><tags><li>mp5_rear_sight</li></tags><transform><position>(-0.155,0,0.080)</position></transform></li>
          <li><id>optic_mount</id><label>MP5 receiver claw mount</label><tags><li>mp5_claw_mount</li></tags><transform><position>(-0.067,0,0.064)</position></transform></li>
          <li><id>trigger_housing</id><label>MP5 trigger housing interface</label><tags><li>mp5_trigger_housing</li></tags><required>true</required><transform><position>(-0.106,0,-0.003)</position></transform></li>
          <li><id>magazine</id><label>MP5 magazine well</label><tags><li>mp5_magazine</li></tags><transform><position>(-0.012,0,0.012)</position></transform></li>
          <li><id>stock</id><label>MP5 stock interface</label><tags><li>mp5_stock</li></tags><transform><position>(-0.190,0,0.031)</position></transform></li>
          <li><id>trigger</id><label>MP5 trigger group</label><tags><li>mp5_trigger</li></tags><required>true</required><transform><position>(-0.103,0,-0.043)</position></transform></li>
        </sockets>
        <defaultAttachments>
          <li><socketId>cocking_tube</socketId><part>HD_ModularPart_CockingTube_MP5</part></li>
          <li><socketId>barrel</socketId><part>HD_ModularPart_Barrel_MP5</part></li>
          <li><socketId>bolt</socketId><part>HD_ModularPart_Bolt_MP5</part></li>
          <li><socketId>rear_sight</socketId><part>HD_ModularPart_RearSight_MP5</part></li>
          <li><socketId>trigger_housing</socketId><part>HD_ModularPart_TriggerHousing_MP5A3</part></li>
          <li><socketId>magazine</socketId><part>HD_ModularPart_Magazine_MP530</part></li>
          <li><socketId>stock</socketId><part>HD_ModularPart_Stock_MP5A3</part></li>
          <li><socketId>trigger</socketId><part>HD_ModularPart_Trigger_MP5</part></li>
        </defaultAttachments>
      </li>
    </comps>
  </ThingDef>

