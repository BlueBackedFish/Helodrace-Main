<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 방탄 참고 주석은 추후 개발용 추정/목표값이며 현재 게임 스탯이나 NIJ 인증을 뜻하지 않음.
       NIJ 0101.07이 참조하는 0123.00 위협등급: hg1, hg2, rf1, rf2, rf3; 미달: -hg1.
       플레이트 소재는 세라믹 / 아라미드 / UHMWPE 등 실제 재질로 구분; 백킹/혼합 구조/미공개 재질은 별도 메모.
       비교 근거와 불확실성: Docs/Ballistic_Reference_Notes.md -->

  <ThingCategoryDef>
    <defName>HD_ArmorPlates</defName>
    <label>armor plates</label>
    <parent>Manufactured</parent>
  </ThingCategoryDef>

  <ThingDef Name="HD_ArmorPlateBase" Abstract="True">
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <techLevel>Industrial</techLevel>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <altitudeLayer>Item</altitudeLayer>
    <stackLimit>1</stackLimit>
    <drawGUIOverlay>true</drawGUIOverlay>
    <healthAffectsPrice>true</healthAffectsPrice>
    <soundInteract>Standard_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <thingCategories><li>HD_ArmorPlates</li></thingCategories>
    <comps>
      <li Class="Helodrace.ModernWar.CompProperties_ArmorPlateSet">
        <material>Ceramic</material>
      </li>
    </comps>
    <recipeMaker>
      <workSkill>Crafting</workSkill>
      <skillRequirements><Crafting>8</Crafting></skillRequirements>
      <researchPrerequisite>FlakArmor</researchPrerequisite>
      <recipeUsers><li>TableMachining</li></recipeUsers>
    </recipeMaker>
  </ThingDef>

  <ThingDef ParentName="HD_ArmorPlateBase">
    <defName>HD_ArmorPlate_SAPI</defName>
    <!-- 방탄 참고: NIJ 0101.07 위협등급 rf1-rf2; 소재: 세라믹 + 방탄섬유 백킹(아라미드/UHMWPE, 모델별 확인); 정확한 섬유 백킹은 제조사/리비전별 확인; 연질 방탄복 병용 기준 추정, 군용 규격은 NIJ 인증과 별개. 세라믹 및 섬유의 세부 등급은 미지정. -->
    <label>SAPI plate set</label>
    <comps Inherit="False">
      <li Class="Helodrace.ModernWar.CompProperties_ArmorPlateSet">
        <material>Ceramic</material>
      </li>
    </comps>
    <description>A two-plate ceramic ballistic set. Plate 1 and plate 2 retain damage independently.</description>
    <graphicData>
      <texPath>Items/Plates/HD_SAPI</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.72,0.72)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>32</MaxHitPoints>
      <MarketValue>480</MarketValue>
      <Mass>2.0</Mass>
      <Flammability>0.05</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
      <WorkToMake>9000</WorkToMake>
    </statBases>
    <costList><Steel>18</Steel><Plasteel>18</Plasteel><ComponentIndustrial>1</ComponentIndustrial></costList>
  </ThingDef>

  <ThingDef ParentName="HD_ArmorPlateBase">
    <defName>HD_ArmorPlate_ESAPI</defName>
    <!-- 방탄 참고: NIJ 0101.07 위협등급 rf2-rf3; 소재: 세라믹 + 방탄섬유 백킹(아라미드/UHMWPE, 모델별 확인); APM2 위협 대응을 참고한 추정, 지정 연질 백킹/리비전 확인 필요. 세라믹 및 섬유의 세부 등급은 미지정. -->
    <label>ESAPI plate set</label>
    <comps Inherit="False">
      <li Class="Helodrace.ModernWar.CompProperties_ArmorPlateSet">
        <material>Ceramic</material>
      </li>
    </comps>
    <description>A two-plate enhanced ceramic ballistic set with independent durability for plate 1 and plate 2.</description>
    <graphicData>
      <texPath>Items/Plates/HD_ESAPI</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.72,0.72)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>40</MaxHitPoints>
      <MarketValue>760</MarketValue>
      <Mass>2.25</Mass>
      <Flammability>0.05</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
      <WorkToMake>13000</WorkToMake>
    </statBases>
    <costList><Steel>16</Steel><Plasteel>28</Plasteel><ComponentIndustrial>2</ComponentIndustrial></costList>
  </ThingDef>

  <ThingDef ParentName="HD_ArmorPlateBase">
    <defName>HD_ArmorPlate_SSAPI</defName>
    <!-- 방탄 참고: NIJ 0101.07 위협등급 rf1-rf2; 소재: 세라믹 + 방탄섬유 백킹(아라미드/UHMWPE, 모델별 확인); Side SAPI 기준 추정. SSAPI는 XSAPI가 아니며 기존 게임 수치로 등급을 역산하지 않음. 세라믹 및 섬유의 세부 등급은 미지정. -->
    <label>SSAPI side plate set</label>
    <comps Inherit="False">
      <li Class="Helodrace.ModernWar.CompProperties_ArmorPlateSet">
        <material>Ceramic</material>
      </li>
    </comps>
    <description>A two-plate compact side protection set. Plate 1 and plate 2 retain damage independently.</description>
    <graphicData>
      <texPath>Items/Plates/HD_SSAPI</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.72,0.72)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>24</MaxHitPoints>
      <MarketValue>1080</MarketValue>
      <Mass>2.5</Mass>
      <Flammability>0.04</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
      <WorkToMake>18000</WorkToMake>
    </statBases>
    <costList><Steel>12</Steel><Plasteel>40</Plasteel><ComponentIndustrial>3</ComponentIndustrial></costList>
  </ThingDef>

  <ThingDef ParentName="HD_ArmorPlateBase">
    <defName>HD_ArmorPlate_ESBI</defName>
    <!-- 방탄 참고: NIJ 0101.07 위협등급 rf2-rf3; 소재: 세라믹 + 방탄섬유 백킹(아라미드/UHMWPE, 모델별 확인); enhanced side insert 기준 추정, 지정 연질 백킹/리비전 확인 필요. 세라믹 및 섬유의 세부 등급은 미지정. -->
    <label>ESBI side plate set</label>
    <comps Inherit="False">
      <li Class="Helodrace.ModernWar.CompProperties_ArmorPlateSet">
        <material>Ceramic</material>
      </li>
    </comps>
    <description>A two-plate enhanced side ballistic insert set. Plate 1 and plate 2 retain damage independently.</description>
    <graphicData>
      <texPath>Items/Plates/HD_ESBI</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.72,0.72)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>30</MaxHitPoints>
      <MarketValue>1220</MarketValue>
      <Mass>2.7</Mass>
      <Flammability>0.04</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
      <WorkToMake>20000</WorkToMake>
    </statBases>
    <costList><Steel>10</Steel><Plasteel>44</Plasteel><ComponentIndustrial>3</ComponentIndustrial></costList>
  </ThingDef>

  <ThingDef ParentName="HD_ArmorPlateBase">
    <defName>HD_ArmorPlate_RAMPART4800</defName>
    <!-- 방탄 참고: NIJ 0101.07 위협등급 rf2-rf3; 소재: 세라믹 + UHMWPE(Spectra); 실제품: HESCO 4800. 제조사 자료의 세라믹/Spectra 조합; 세라믹 세부 종류는 미공개. -->
    <label>RAMPART 4800 plate set</label>
    <!-- Simplified gameplay material from the development memo. -->
    <comps Inherit="False">
      <li Class="Helodrace.ModernWar.CompProperties_ArmorPlateSet">
        <material>UHMWPE</material>
      </li>
    </comps>
    <description>A two-plate heavy premium ballistic set engineered for maximum rifle and repeated-impact resistance.</description>
    <graphicData>
      <texPath>Items/Plates/HD_RAMPART4800</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.72,0.72)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>56</MaxHitPoints>
      <MarketValue>1420</MarketValue>
      <Mass>3.0</Mass>
      <Flammability>0.03</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
      <WorkToMake>24000</WorkToMake>
    </statBases>
    <costList><Uranium>10</Uranium><Plasteel>48</Plasteel><ComponentIndustrial>4</ComponentIndustrial></costList>
  </ThingDef>
</Defs>
