      <li><verbClass>Helodrace.ModernWar.Verb_ShootModularUnderbarrel</verbClass><hasStandardCommand>false</hasStandardCommand><defaultProjectile>HD_40mmM381HE_Proj</defaultProjectile><warmupTime>1.15</warmupTime><range>27.9</range><minRange>2.9</minRange><forcedMissRadius>1.2</forcedMissRadius><burstShotCount>1</burstShotCount><ticksBetweenBurstShots>0</ticksBetweenBurstShots><targetParams><canTargetLocations>true</canTargetLocations></targetParams><soundCast>Shot_IncendiaryLauncher</soundCast><soundCastTail>GunTail_Heavy</soundCastTail><muzzleFlashScale>5</muzzleFlashScale></li>
    </verbs>
    <comps>
      <li Class="Helodrace.ModernWar.CompProperties_ModularWeaponNode">
        <isAssemblyRoot>true</isAssemblyRoot>
        <spawnPreset>HD_WeaponPreset_ModularM16A1_Default</spawnPreset>
        <realisticRoundsPerMinute>750</realisticRoundsPerMinute>
        <baseFireDelayFactor>1.2</baseFireDelayFactor>
        <internalStats>
          <massKg>0.78</massKg>
          <recoilImpulse>4.3</recoilImpulse>
          <ergonomics>58</ergonomics>
          <muzzleRise>3.3</muzzleRise>
          <operatingReliability>0.96</operatingReliability>
          <gasFlow>0.98</gasFlow>
          <momentOfInertia>0.034</momentOfInertia>
          <targetAcquisition>54</targetAcquisition>
          <aimingPrecision>55</aimingPrecision>
          <identificationDistanceMeters>240</identificationDistanceMeters>
        </internalStats>
        <sockets>
          <li><id>upper_receiver</id><label>upper receiver interface</label><tags><li>upper_receiver</li></tags><transform><position>(-0.094,0,-0.018)</position></transform></li>
          <li><id>pistol_grip</id><label>pistol grip interface</label><tags><li>ar15_pistol_grip</li></tags><transform><position>(-0.161,0,-0.051)</position></transform></li>
          <li><id>buffer_tube</id><label>buffer tube interface</label><tags><li>ar15_buffer</li></tags><transform><position>(-0.21,0,-0.006)</position></transform></li>
          <li><id>magazine</id><label>STANAG magazine well</label><tags><li>stanag_magazine</li></tags><transform><position>(-0.075,0,-0.019)</position></transform></li>
          <li><id>trigger</id><label>trigger group</label><tags><li>ar15_trigger</li></tags><required>true</required><transform><position>(-0.139,0,-0.051)</position></transform></li>
        </sockets>
        <defaultAttachments>
          <li><socketId>upper_receiver</socketId><part>HD_ModularPart_UpperReceiver_M16A1_Part</part></li>
          <li><socketId>pistol_grip</socketId><part>HD_ModularPart_PistolGrip_IronFangA2_Part</part></li>
          <li><socketId>buffer_tube</socketId><part>HD_ModularPart_BufferTube_ColtA2_Part</part></li>
          <li><socketId>magazine</socketId><part>HD_ModularPart_Magazine_STANAG20_Part</part></li>
          <li><socketId>trigger</socketId><part>HD_ModularPart_Trigger_AR15_Part</part></li>
        </defaultAttachments>
      </li>
    </comps>
  </ThingDef>

