          <li><socketId>bolt</socketId><part>HD_ModularPart_Bolt_AR15</part></li>
        </defaultAttachments>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="HD_ModularWeaponPartBase">
    <defName>HD_ModularPart_Handguard_M16A2UP</defName>
    <label>M16A2 upper handguard</label>
    <description>The upper half of a two-piece M16A2 handguard.</description>
    <graphicData><texPath>Weapons/Modular/Handguards/HD_HandGuard_M16a2UP</texPath></graphicData>
    <comps>
      <li Class="Helodrace.ModernWar.CompProperties_ModularWeaponNode">
        <graphicLayer>2</graphicLayer>
        <mounts><li><id>handguard_mount</id><socketTags><li>ar15_handguard</li></socketTags><transform><position>(-0.029,0,-0.005)</position></transform></li></mounts>
        <sockets><li><id>lower_extension</id><label>M16A2 lower handguard interface</label><tags><li>m16a2_handguard_lower</li></tags><transform><position>(-0.011,0,-0.006)</position></transform></li></sockets>
        <defaultAttachments><li><socketId>lower_extension</socketId><part>HD_ModularPart_HandguardExt_M16A2DOWN</part></li></defaultAttachments>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="HD_ModularWeaponPartBase">
    <defName>HD_ModularPart_HandguardExt_M16A2DOWN</defName>
    <label>M16A2 lower handguard</label>
    <description>The removable lower half of a two-piece M16A2 handguard.</description>
    <graphicData><texPath>Weapons/Modular/Handguards/HD_HandGuardExt_M16a2DOWN</texPath></graphicData>
    <comps>
      <li Class="Helodrace.ModernWar.CompProperties_ModularWeaponNode">
        <graphicLayer>1.5</graphicLayer>
        <mounts><li><id>lower_handguard_mount</id><socketTags><li>m16a2_handguard_lower</li></socketTags><transform><position>(-0.011,0,-0.007)</position></transform></li></mounts>
