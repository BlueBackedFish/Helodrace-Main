  <ThingDef ParentName="HD_ModularWeaponPartBase">
    <defName>HD_ModularPart_Barrel_AR1520Pencil</defName>
    <label>20 inch AR-15 pencil barrel</label>
    <description>A lightweight 20-inch pencil-profile AR-15 barrel.</description>
    <graphicData><texPath>Weapons/Modular/Barrels/HD_Barrel_AR1520Pencil</texPath></graphicData>
    <comps>
      <li Class="Helodrace.ModernWar.CompProperties_ModularWeaponNode">
        <graphicLayer>-3</graphicLayer>
        <chamberCaliber>556x45</chamberCaliber>
        <ceAmmoSetDefName>AmmoSet_556x45mmNATO</ceAmmoSetDefName>
        <boreDiameterMm>5.7</boreDiameterMm>
        <mounts><li><id>barrel_mount</id><socketTags><li>ar15_barrel</li></socketTags><transform><position>(-0.039,0,-0.005)</position></transform></li></mounts>
        <sockets>
          <li><id>gas_block</id><label>gas block journal</label><tags><li>ar15_gas_block</li></tags><transform><position>(0.282,0,-0.009)</position></transform></li>
          <li><id>muzzle</id><label>muzzle thread</label><tags><li>muzzle_556</li></tags><transform><position>(0.417,0,-0.008)</position></transform></li>
        </sockets>
        <defaultAttachments>
          <li><socketId>gas_block</socketId><part>HD_ModularPart_GasBlock_AR15</part></li>
          <li><socketId>muzzle</socketId><part>HD_ModularPart_Muzzle_M16A1</part></li>
        </defaultAttachments>
      </li>
    </comps>
  </ThingDef>

<ThingDef ParentName="HD_ModularWeaponPartBase">
    <defName>HD_ModularPart_Muzzle_M16A1</defName>
    <label>M16A1 flash suppressor</label>
    <description>An M16A1 birdcage flash suppressor for a 5.56 mm muzzle thread.</description>
    <graphicData><texPath>Weapons/Modular/MuzzleDevices/HD_Muzzle_M16a1</texPath></graphicData>
    <comps>
      <li Class="Helodrace.ModernWar.CompProperties_ModularWeaponNode">
        <muzzleEffectKind>FlashHider</muzzleEffectKind>
        <graphicOffset>(0,0,0)</graphicOffset>
        <graphicLayer>-2</graphicLayer>
        <mounts><li><id>thread_mount</id><socketTags><li>muzzle_556</li></socketTags><transform><position>(0.417,0,-0.007)</position></transform></li></mounts>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="HD_ModularWeaponPartBase">
    <defName>HD_ModularPart_Magazine_STANAG20</defName>
    <label>20-round STANAG magazine</label>
    <description>A compact twenty-round STANAG-pattern rifle magazine.</description>
    <graphicData><texPath>Weapons/Modular/Magazines/HD_Magazine_Stanag20</texPath></graphicData>
    <comps>
      <li Class="Helodrace.ModernWar.CompProperties_ModularWeaponNode">
        <graphicLayer>-1</graphicLayer>
        <magazineCapacity>20</magazineCapacity>
        <mounts><li><id>magazine_mount</id><socketTags><li>stanag_magazine</li></socketTags><transform><position>(-0.075,0,-0.026)</position></transform></li></mounts>
        <sockets><li><id>ammunition</id><label>loaded ammunition</label><tags><li>stanag_ammunition</li></tags><required>true</required><transform><position>(-0.075,0,-0.090)</position></transform></li></sockets>
        <defaultAttachments><li><socketId>ammunition</socketId><part>HD_Ammunition_556M855A1</part></li></defaultAttachments>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="HD_M16FamilyBase">
    <defName>HD_Gun_ModularM16A1_Test_Weapon</defName>
    <label>modular M16A1 development rifle</label>
    <description>A development rifle for authoring the modular M16A1 part set.</description>
    <thingClass>Helodrace.ModernWar.ModularWeaponThing</thingClass>
    <uiIconPath>Weapons/ColdWar/HD_M16A1</uiIconPath>
    <graphicData><texPath>Weapons/Modular/Receivers/HD_LowerReceiver_M16A1</texPath><graphicClass>Helodrace.ModernWar.Graphic_ModularWeaponAssembly</graphicClass><drawSize>(1,1)</drawSize></graphicData>
    <equippedAngleOffset>0</equippedAngleOffset>
    <statBases><RangedWeapon_Cooldown>0.1</RangedWeapon_Cooldown></statBases>
    <comps>
      <li Class="Helodrace.ModernWar.CompProperties_ModularWeaponNode">
        <isAssemblyRoot>true</isAssemblyRoot>
        <realisticRoundsPerMinute>750</realisticRoundsPerMinute>
        <baseFireDelayFactor>1.2</baseFireDelayFactor>
        <internalStats>
          <massKg>0.78</massKg>
          <recoilImpulse>4.3</recoilImpulse>
          <ergonomics>58</ergonomics>
          <muzzleRise>3.3</muzzleRise>
          <operatingReliability>0.96</operatingReliability>
          <gasFlow>0.98</gasFlow>
          <momentOfInertia>0.034</momentOfInertia>
          <targetAcquisition>54</targetAcquisition>
          <aimingPrecision>55</aimingPrecision>
          <identificationDistanceMeters>240</identificationDistanceMeters>
        </internalStats>
        <sockets>
          <li><id>upper_receiver</id><label>upper receiver interface</label><tags><li>upper_receiver</li></tags><transform><position>(-0.094,0,-0.018)</position></transform></li>
          <li><id>pistol_grip</id><label>pistol grip interface</label><tags><li>ar15_pistol_grip</li></tags><transform><position>(-0.161,0,-0.051)</position></transform></li>
          <li><id>buffer_tube</id><label>buffer tube interface</label><tags><li>ar15_buffer</li></tags><transform><position>(-0.21,0,-0.006)</position></transform></li>
          <li><id>magazine</id><label>STANAG magazine well</label><tags><li>stanag_magazine</li></tags><transform><position>(-0.075,0,-0.019)</position></transform></li>
          <li><id>trigger</id><label>trigger group</label><tags><li>ar15_trigger</li></tags><required>true</required><transform><position>(-0.139,0,-0.051)</position></transform></li>
        </sockets>
        <defaultAttachments>
          <li><socketId>upper_receiver</socketId><part>HD_ModularPart_UpperReceiver_M16A1</part></li>
          <li><socketId>pistol_grip</socketId><part>HD_ModularPart_PistolGrip_IronFangA2</part></li>
          <li><socketId>buffer_tube</socketId><part>HD_ModularPart_BufferTube_ColtA2</part></li>
          <li><socketId>magazine</socketId><part>HD_ModularPart_Magazine_STANAG20</part></li>
          <li><socketId>trigger</socketId><part>HD_ModularPart_Trigger_AR15</part></li>
        </defaultAttachments>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="HD_M16FamilyBase">
    <defName>HD_Gun_ModularM16A2_Test_Weapon</defName>
