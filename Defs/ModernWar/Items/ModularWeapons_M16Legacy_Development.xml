    <statBases><MarketValue>1025</MarketValue><RangedWeapon_Cooldown>0.1</RangedWeapon_Cooldown></statBases>
    <recipeMaker><researchPrerequisite>HelodLowAutomaticRifle</researchPrerequisite><recipeUsers Inherit="False"><li>HD_BasicWorkbench</li></recipeUsers></recipeMaker>
    <verbs Inherit="False">
      <li><verbClass>Verb_Shoot</verbClass><hasStandardCommand>true</hasStandardCommand><defaultProjectile>HD_Bullet_M16A4_Proj</defaultProjectile><warmupTime>0.9</warmupTime><range>29.9</range><burstShotCount>6</burstShotCount><ticksBetweenBurstShots>5</ticksBetweenBurstShots><soundCast>Shot_AssaultRifle</soundCast><soundCastTail>GunTail_Medium</soundCastTail><muzzleFlashScale>9</muzzleFlashScale></li>
