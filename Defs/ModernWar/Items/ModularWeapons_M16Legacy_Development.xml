    <description>M16A1 upper receiver supports the action, barrel, and compatible attachments.</description>
    <graphicData><texPath>Weapons/Modular/Receivers/HD_UpperReceiver_M16a1</texPath></graphicData>
    <comps>
      <li Class="Helodrace.ModernWar.CompProperties_ModularWeaponNode"><craftCost><Steel>8</Steel><ComponentIndustrial>1</ComponentIndustrial></craftCost><requiredResearch><li>HelodLowAutomaticRifle</li></requiredResearch>
