<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef Name="HD_LaserDesignatorBase" ParentName="ApparelNoQualityBase" Abstract="True">
    <techLevel>Industrial</techLevel>
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <apparel>
      <bodyPartGroups>
        <li>Arms</li>
      </bodyPartGroups>
      <useWornGraphicMask>false</useWornGraphicMask>
      <parentTagDef>ApparelBody</parentTagDef>
      <layers>
        <li>Belt</li>
      </layers>
      <tags>
        <li>HD_Apparel</li>
        <li>Soldier</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <recipeMaker>
      <workSkill>Crafting</workSkill>
      <skillRequirements>
        <Crafting>10</Crafting>
      </skillRequirements>
      <researchPrerequisite>HelodLaserTargetDesignators</researchPrerequisite>
      <recipeUsers>
        <li>HD_BasicWorkbench</li>
      </recipeUsers>
    </recipeMaker>
  </ThingDef>

  <ThingDef ParentName="HD_LaserDesignatorBase">
    <defName>HD_Apparel_ANPEQ1C</defName>
    <label>AN/PEQ-1C SOFLAM</label>
    <description>A tripod-capable laser target designator that maintains a comparatively stable mark in poor weather.</description>
    <graphicData>
      <texPath>Weapons/ModernWar/ANPEQ1C/HD_ANPEQ1C_item</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.9,0.9)</drawSize>
    </graphicData>
    <uiIconPath>Weapons/ModernWar/ANPEQ1C/HD_ANPEQ1C</uiIconPath>
    <statBases>
      <WorkToMake>30000</WorkToMake>
      <Mass>5.2</Mass>
      <MarketValue>3200</MarketValue>
      <MaxHitPoints>120</MaxHitPoints>
      <Flammability>0.25</Flammability>
      <EquipDelay>1.8</EquipDelay>
    </statBases>
    <costList>
      <Steel>60</Steel>
      <HD_ElectronicComponent>12</HD_ElectronicComponent>
    </costList>
    <modExtensions>
      <li Class="Helodrace.HelodCasLaserDesignatorExtension">
        <baseGuidanceChance>0.97</baseGuidanceChance>
        <weatherPenaltyFactor>0.55</weatherPenaltyFactor>
        <adjustsGbu54Scatter>true</adjustsGbu54Scatter>
        <usesPilotSignalVisual>false</usesPilotSignalVisual>
        <guidanceGraphicPath>Weapons/ModernWar/ANPEQ1C/HD_ANPEQ1C</guidanceGraphicPath>
        <guidanceGraphicSize>1.1</guidanceGraphicSize>
        <guidanceGraphicRotationOffset>0</guidanceGraphicRotationOffset>
        <guidanceGraphicForwardOffset>0.12</guidanceGraphicForwardOffset>
        <guidanceGraphicLateralOffset>0.75</guidanceGraphicLateralOffset>
        <fixedGuidanceGraphicPosition>true</fixedGuidanceGraphicPosition>
      </li>
    </modExtensions>
    <recipeMaker>
      <defaultIngredientFilter>
        <thingDefs>
          <li>Steel</li>
          <li>HD_ElectronicComponent</li>
        </thingDefs>
      </defaultIngredientFilter>
      <recipeUsers Inherit="False"><li>HD_BasicWorkbench</li><li>HD_GunSmithTable</li></recipeUsers>
    </recipeMaker>
  </ThingDef>

  <ThingDef ParentName="HD_LaserDesignatorBase">
    <defName>HD_Apparel_IZLIDUltra</defName>
