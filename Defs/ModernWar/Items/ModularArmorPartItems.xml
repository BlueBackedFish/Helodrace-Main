<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 방탄 참고 주석은 추후 개발용 추정/목표값이며 현재 게임 스탯이나 NIJ 인증을 뜻하지 않음.
       NIJ 0101.07이 참조하는 0123.00 위협등급: hg1, hg2, rf1, rf2, rf3; 미달: -hg1.
       비교 근거와 불확실성: Docs/Ballistic_Reference_Notes.md -->

  <ThingCategoryDef>
    <defName>HD_ModularArmorParts</defName>
    <label>modular armor parts</label>
    <parent>Manufactured</parent>
  </ThingCategoryDef>

  <ThingDef Name="HD_ModularArmorPartItemBase" Abstract="True">
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <techLevel>Industrial</techLevel>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <altitudeLayer>Item</altitudeLayer>
    <stackLimit>1</stackLimit>
    <drawGUIOverlay>true</drawGUIOverlay>
    <soundInteract>Standard_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <thingCategories><li>HD_ModularArmorParts</li></thingCategories>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Flammability>0.10</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
    </statBases>
    <recipeMaker>
      <defaultIngredientFilter><categories><li>Root</li></categories></defaultIngredientFilter>
      <workSkill>Crafting</workSkill>
      <skillRequirements><Crafting>6</Crafting></skillRequirements>
      <researchPrerequisite>HelodPASGT</researchPrerequisite>
      <recipeUsers><li>TableMachining</li></recipeUsers>
    </recipeMaker>
  </ThingDef>

  <ThingDef ParentName="HD_ModularArmorPartItemBase">
    <defName>HD_ModularPart_GPNVG18_Part</defName>
    <label>GPNVG-18 helmet module</label>
    <description>A panoramic night-vision module made for the FAST MT helmet mount.</description>
    <graphicData>
      <texPath>Helod/Apparel/HelmetPart/HD_GPNVG18/HD_GPNVG18_south</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.75,0.75)</drawSize>
    </graphicData>
    <statBases><MarketValue>1800</MarketValue><Mass>0.76</Mass><WorkToMake>18000</WorkToMake></statBases>
    <costList>
      <Plasteel>18</Plasteel>
      <HD_ElectronicComponent>8</HD_ElectronicComponent>
    </costList>
    <recipeMaker>
      <defaultIngredientFilter>
        <thingDefs>
          <li>Plasteel</li>
          <li>HD_ElectronicComponent</li>
        </thingDefs>
      </defaultIngredientFilter><researchPrerequisites><li>HelodAdvancedWeaponOptics</li></researchPrerequisites>  <recipeUsers Inherit="False"><li>HD_ClothingBench</li></recipeUsers>
    </recipeMaker>
  </ThingDef>

