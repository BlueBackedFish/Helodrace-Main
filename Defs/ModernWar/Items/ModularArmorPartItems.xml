<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingCategoryDef>
    <defName>HD_ModularArmorParts</defName>
    <label>modular armor parts</label>
    <parent>Manufactured</parent>
  </ThingCategoryDef>

  <ThingDef Name="HD_ModularArmorPartItemBase" Abstract="True">
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <techLevel>Industrial</techLevel>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <altitudeLayer>Item</altitudeLayer>
    <stackLimit>1</stackLimit>
    <drawGUIOverlay>true</drawGUIOverlay>
    <soundInteract>Standard_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <thingCategories><li>HD_ModularArmorParts</li></thingCategories>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Flammability>0.10</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
    </statBases>
    <recipeMaker>
      <workSkill>Crafting</workSkill>
      <skillRequirements><Crafting>6</Crafting></skillRequirements>
      <researchPrerequisite>FlakArmor</researchPrerequisite>
      <recipeUsers><li>TableMachining</li></recipeUsers>
    </recipeMaker>
  </ThingDef>

  <ThingDef ParentName="HD_ModularArmorPartItemBase">
    <defName>HD_ModularPart_GPNVG18</defName>
    <label>GPNVG-18 helmet module</label>
    <description>A panoramic night-vision module made for the FAST MT helmet mount.</description>
    <graphicData>
      <texPath>Helod/Apparel/HelmetPart/HD_GPNVG18/HD_GPNVG18_south</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.75,0.75)</drawSize>
    </graphicData>
    <statBases><MarketValue>1800</MarketValue><Mass>0.76</Mass><WorkToMake>18000</WorkToMake></statBases>
    <costList><Plasteel>18</Plasteel><ComponentIndustrial>6</ComponentIndustrial><ComponentSpacer>1</ComponentSpacer></costList>
  </ThingDef>

  <ThingDef ParentName="HD_ModularArmorPartItemBase">
    <defName>HD_ModularPart_MultiHitVisor</defName>
    <label>multi-hit ballistic visor module</label>
    <description>A transparent multi-hit ballistic visor made for the FAST MT helmet.</description>
    <graphicData>
      <texPath>Helod/Apparel/HelmetPart/HD_MultiHitVisor/HD_MultiHitVisor_south</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.75,0.75)</drawSize>
      <shaderType>Transparent</shaderType>
    </graphicData>
    <statBases><MarketValue>520</MarketValue><Mass>1.10</Mass><WorkToMake>9000</WorkToMake></statBases>
    <costList><Plasteel>24</Plasteel><ComponentIndustrial>2</ComponentIndustrial></costList>
  </ThingDef>

