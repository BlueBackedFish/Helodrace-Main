          <li><id>rail_top_front</id><label>top rail front</label><tags><li>picatinny</li><li>top_rail</li></tags><isRail>true</isRail><railLength>0.263</railLength><railSurface>Top</railSurface><transform><position>(0.124,0,0.018)</position></transform></li>
