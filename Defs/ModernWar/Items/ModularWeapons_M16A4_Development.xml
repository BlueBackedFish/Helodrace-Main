  <!-- A complete second test tree that exercises all fourteen new physical part Defs. -->
  <ThingDef ParentName="HD_M16FamilyBase">
    <defName>HD_Gun_ModularM16A4_Test_Weapon</defName>
    <label>modular M16A4 development rifle</label>
    <description>A development rifle for authoring the expanded modular part set.</description>
    <thingClass>Helodrace.ModernWar.ModularWeaponThing</thingClass>
    <uiIconPath>Weapons/ModernWar/HD_M16A4</uiIconPath>
    <graphicData>
      <texPath>Weapons/Modular/Receivers/HD_LowerReceiver_M16A2,3</texPath>
      <graphicClass>Helodrace.ModernWar.Graphic_ModularWeaponAssembly</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <equippedAngleOffset>0</equippedAngleOffset>
    <statBases>
      <RangedWeapon_Cooldown>0.09</RangedWeapon_Cooldown>
    </statBases>
    <comps>
      <li Class="Helodrace.ModernWar.CompProperties_ModularWeaponNode">
        <isAssemblyRoot>true</isAssemblyRoot>
        <realisticRoundsPerMinute>800</realisticRoundsPerMinute>
        <baseFireDelayFactor>1.2</baseFireDelayFactor>
        <internalStats>
          <massKg>0.86</massKg>
          <recoilImpulse>4.2</recoilImpulse>
          <ergonomics>50</ergonomics>
          <muzzleRise>3</muzzleRise>
          <operatingReliability>0.975</operatingReliability>
          <gasFlow>1</gasFlow>
          <momentOfInertia>0.04</momentOfInertia>
          <targetAcquisition>50</targetAcquisition>
          <aimingPrecision>60</aimingPrecision>
          <identificationDistanceMeters>300</identificationDistanceMeters>
        </internalStats>
        <graphicOffset>(0,0,0)</graphicOffset>
        <sockets>
          <li><id>upper_receiver</id><label>upper receiver interface</label><tags><li>upper_receiver</li></tags><transform><position>(-0.094,0,-0.018)</position></transform></li>
          <li><id>pistol_grip</id><label>pistol grip interface</label><tags><li>ar15_pistol_grip</li></tags><transform><position>(-0.161,0,-0.051)</position></transform></li>
          <li><id>buffer_tube</id><label>buffer tube interface</label><tags><li>ar15_buffer</li></tags><transform><position>(-0.219,0,-0.006)</position></transform></li>
          <li><id>magazine</id><label>STANAG magazine well</label><tags><li>stanag_magazine</li></tags><transform><position>(-0.075,0,-0.019)</position></transform></li>
          <li><id>trigger</id><label>trigger group</label><tags><li>ar15_trigger</li></tags><required>true</required><transform><position>(-0.139,0,-0.051)</position></transform></li>
        </sockets>
        <defaultAttachments>
          <li><socketId>upper_receiver</socketId><part>HD_ModularPart_UpperReceiver_M16A4</part></li>
          <li><socketId>pistol_grip</socketId><part>HD_ModularPart_PistolGrip_IronFangA2</part></li>
          <li><socketId>buffer_tube</socketId><part>HD_ModularPart_BufferTube_ColtA2</part></li>
          <li><socketId>magazine</socketId><part>HD_ModularPart_Magazine_STANAG</part></li>
          <li><socketId>trigger</socketId><part>HD_ModularPart_Trigger_AR15</part></li>
        </defaultAttachments>
      </li>
    </comps>
  </ThingDef>

</Defs>
