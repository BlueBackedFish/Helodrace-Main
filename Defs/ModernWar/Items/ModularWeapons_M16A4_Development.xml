  <ThingDef ParentName="HD_ModularWeaponPartBase">
    <defName>HD_ModularPart_HandguardExt_HACURXDOWN</defName>
    <label>HAC URX lower handguard</label>
    <description>The removable lower section of a HAC URX rail handguard.</description>
    <graphicData><texPath>Weapons/Modular/Handguards/HD_HandGuardExt_HACURXDOWN</texPath></graphicData>
    <comps>
      <li Class="Helodrace.ModernWar.CompProperties_ModularWeaponNode">
        <graphicLayer>1.5</graphicLayer>
        <mounts><li><id>lower_handguard_mount</id><socketTags><li>hac_urx_lower</li></socketTags><transform><position>(-0.012,0,-0.014)</position></transform></li></mounts>
        <sockets>
          <!-- The former grip/panel sockets are one continuous lower rail. The obsolete mid/side rail was removed. -->
          <li><id>rail_bottom</id><label>continuous bottom rail</label><tags><li>picatinny</li><li>bottom_rail</li></tags><isRail>true</isRail><railLength>0.263</railLength><railSurface>Bottom</railSurface><transform><position>(0.124,0,-0.024)</position></transform></li>
        </sockets>
        <defaultAttachments>
          <li><socketId>rail_bottom</socketId><part>HD_ModularPart_Grip_HACVFG</part><railOffset>-0.036</railOffset></li>
          <li><socketId>rail_bottom</socketId><part>HD_ModularPart_RailPanel_HACURXLow</part><railOffset>0.059</railOffset></li>
        </defaultAttachments>
      </li>
    </comps>
  </ThingDef>

