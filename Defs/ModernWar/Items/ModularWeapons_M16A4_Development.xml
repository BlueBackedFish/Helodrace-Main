  <ThingDef ParentName="HD_ModularWeaponPartBase">
    <defName>HD_ModularPart_Handguard_HACURXUP</defName>
    <label>HAC URX upper handguard</label>
    <description>The upper section of a two-piece HAC URX rail handguard.</description>
    <graphicData><texPath>Weapons/Modular/Handguards/HD_HandGuard_HACURXUP</texPath></graphicData>
    <comps>
      <li Class="Helodrace.ModernWar.CompProperties_ModularWeaponNode">
        <graphicLayer>2</graphicLayer>
        <mounts><li><id>handguard_mount</id><socketTags><li>ar15_handguard</li></socketTags><transform><position>(-0.006,0,-0.004)</position></transform></li></mounts>
        <sockets>
          <li><id>lower_extension</id><label>URX lower handguard interface</label><tags><li>hac_urx_lower</li></tags><transform><position>(-0.013,0,-0.014)</position></transform></li>
          <li><id>rail_top_front</id><label>top rail front</label><tags><li>picatinny</li><li>top_rail</li></tags><isRail>true</isRail><railLength>0.18</railLength><transform><position>(0.189,0,0.018)</position></transform></li>
          <li><id>rail_side_upper</id><label>upper side rail</label><tags><li>picatinny</li><li>side_rail</li></tags><isRail>true</isRail><railLength>0.16</railLength><transform><position>(0.167,0,-0.005)</position></transform></li>
        </sockets>
        <defaultAttachments>
          <li><socketId>lower_extension</socketId><part>HD_ModularPart_HandguardExt_HACURXDOWN</part></li>
        </defaultAttachments>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="HD_ModularWeaponPartBase">
