<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Second authoring set. Shared lower/upper interfaces use the same authored offsets
       as the M4 development tree; M16A4-specific descendants remain ready for tuning. -->

  <ThingDef ParentName="HD_ModularWeaponPartBase">
    <defName>HD_ModularPart_UpperReceiver_M16A4</defName>
    <label>M16A4 upper receiver</label>
    <selectable>true</selectable>
    <alwaysHaulable>true</alwaysHaulable>
    <thingCategories><li>HD_ModularWeaponParts</li></thingCategories>
    <description>A flat-top M16A4 upper receiver for the modular AR assembly.</description>
    <graphicData><texPath>Weapons/Modular/Receivers/HD_UpperReceiver_M16a4</texPath></graphicData>
    <comps>
      <li Class="Helodrace.ModernWar.CompProperties_ModularWeaponNode">
        <storageMode>IndependentThing</storageMode>
        <graphicOffset>(0,0,0)</graphicOffset>
        <graphicLayer>1</graphicLayer>
        <outlinePriority>100</outlinePriority>
        <casingPort><offset>(-0.096,0,0)</offset><ejectionAngleOffset>90</ejectionAngleOffset><speedMin>1.7</speedMin><speedMax>2.4</speedMax><scale>0.75</scale><ejectionCycleFraction>0.28</ejectionCycleFraction><feedStartCycleFraction>0.55</feedStartCycleFraction><feedEndCycleFraction>0.92</feedEndCycleFraction><feedStartOffset>(-0.076,0,-0.01)</feedStartOffset><feedEndOffset>(-0.023,0,-0.004)</feedEndOffset><feedingRoundDrawSize>0.12</feedingRoundDrawSize></casingPort>
        <mounts><li><id>receiver_mount</id><socketTags><li>upper_receiver</li></socketTags><transform><position>(-0.095,0,-0.017)</position></transform></li></mounts>
        <sockets>
          <li><id>barrel</id><label>barrel extension</label><tags><li>ar15_barrel</li></tags><transform><position>(-0.023,0,-0.005)</position></transform></li>
          <li><id>handguard</id><label>handguard mount</label><tags><li>ar15_handguard</li></tags><transform><position>(-0.023,0,-0.005)</position></transform></li>
          <li><id>bolt</id><label>bolt carrier group</label><tags><li>ar15_bolt</li></tags><required>true</required><transform><position>(-0.044,0,-0.002)</position></transform></li>
          <li><id>rail_receiver_top</id><label>upper receiver top rail</label><tags><li>picatinny</li><li>top_rail</li><li>receiver_rail</li></tags><isRail>true</isRail><railLength>0.152</railLength><railSurface>Top</railSurface><transform><position>(-0.114,0,0.017)</position></transform></li>
        </sockets>
        <defaultAttachments>
          <li><socketId>barrel</socketId><part>HD_ModularPart_Barrel_AR1520</part></li>
          <li><socketId>handguard</socketId><part>HD_ModularPart_Handguard_HACURXUP</part></li>
          <li><socketId>bolt</socketId><part>HD_ModularPart_Bolt_AR15</part></li>
          <li><socketId>rail_receiver_top</socketId><part>HD_ModularPart_OpticMount_LumiconTA51</part><railOffset>-0.022</railOffset></li>
        </defaultAttachments>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="HD_ModularWeaponPartBase">
