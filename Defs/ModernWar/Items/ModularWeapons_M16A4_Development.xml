        <mounts><li><id>lower_handguard_mount</id><socketTags><li>hac_urx_lower</li></socketTags><transform><position>(-0.012,0,-0.014)</position></transform></li></mounts>
        <sockets>
          <li><id>rail_bottom_grip</id><label>bottom rail grip position</label><tags><li>picatinny</li><li>bottom_rail</li></tags><isRail>true</isRail><railLength>0.16</railLength><transform><position>(0.076,0,-0.024)</position></transform></li>
          <li><id>rail_bottom_panel</id><label>bottom rail panel position</label><tags><li>picatinny</li><li>bottom_rail</li></tags><isRail>true</isRail><railLength>0.16</railLength><transform><position>(0.119,0,-0.024)</position></transform></li>
          <li><id>rail_side_panel</id><label>side rail panel position</label><tags><li>picatinny</li><li>side_rail</li></tags><isRail>true</isRail><railLength>0.16</railLength><transform><position>(0.007,0,-0.007)</position></transform></li>
        </sockets>
        <defaultAttachments>
          <li><socketId>rail_bottom_grip</socketId><part>HD_ModularPart_Grip_HACVFG</part></li>
          <li><socketId>rail_bottom_panel</socketId><part>HD_ModularPart_RailPanel_HACURXLow</part></li>
          <li><socketId>rail_side_panel</socketId><part>HD_ModularPart_RailPanel_HACURXMid</part></li>
        </defaultAttachments>
      </li>
    </comps>
  </ThingDef>

