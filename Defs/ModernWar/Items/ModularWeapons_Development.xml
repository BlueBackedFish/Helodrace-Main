<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingCategoryDef>
    <defName>HD_ModularWeaponParts</defName>
    <label>modular weapon parts</label>
    <parent>Manufactured</parent>
  </ThingCategoryDef>

  <!-- Development-only physical parts. Every attached child remains a real Thing and owns
       its own children, so detaching a handguard can preserve the complete rail subtree.
       The modular Thing/Graphic classes also let any loose part render its child assembly. -->
  <ThingDef Name="HD_ModularWeaponPartBase" Abstract="True">
    <thingClass>Helodrace.ModernWar.ModularWeaponThing</thingClass>
    <category>Item</category>
    <techLevel>Industrial</techLevel>
    <drawerType>MapMeshOnly</drawerType>
    <selectable>true</selectable>
    <alwaysHaulable>true</alwaysHaulable>
    <useHitPoints>true</useHitPoints>
    <stackLimit>1</stackLimit>
    <altitudeLayer>Item</altitudeLayer>
    <drawGUIOverlay>true</drawGUIOverlay>
    <soundInteract>Standard_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <thingCategories><li>HD_ModularWeaponParts</li></thingCategories>
    <graphicData>
      <graphicClass>Helodrace.ModernWar.Graphic_ModularWeaponAssembly</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>0.2</Mass>
      <MarketValue>50</MarketValue>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="HD_ModularWeaponPartBase">
    <defName>HD_ModularPart_UpperReceiver_M4A1</defName>
    <label>M4A1 upper receiver</label>
    <graphicData><texPath>Weapons/Modular/Receivers/HD_UpperReceiver_M4a1</texPath></graphicData>
    <comps>
      <li Class="Helodrace.ModernWar.CompProperties_ModularWeaponNode">
        <graphicOffset>(0,0,0)</graphicOffset>
        <graphicLayer>1</graphicLayer>
        <mounts>
          <li><id>receiver_mount</id><socketTags><li>upper_receiver</li></socketTags><transform><position>(-0.095,0,-0.017)</position></transform></li>
        </mounts>
        <sockets>
          <li><id>barrel</id><label>barrel extension</label><tags><li>ar15_barrel</li></tags><transform><position>(-0.023,0,-0.005)</position></transform></li>
          <li><id>handguard</id><label>handguard mount</label><tags><li>ar15_handguard</li></tags><transform><position>(-0.023,0,-0.005)</position></transform></li>
          <!-- One continuous receiver rail. Its front edge preserves the former holographic-sight rail extent. -->
          <li><id>rail_receiver_top</id><label>upper receiver top rail</label><tags><li>picatinny</li><li>top_rail</li><li>receiver_rail</li></tags><isRail>true</isRail><railLength>0.123</railLength><transform><position>(-0.1335,0,0.017)</position></transform></li>
        </sockets>
        <defaultAttachments>
          <li><socketId>barrel</socketId><part>HD_ModularPart_Barrel_AR15103</part></li>
          <li><socketId>handguard</socketId><part>HD_ModularPart_Handguard_HACRISFDE</part></li>
          <li><socketId>rail_receiver_top</socketId><part>HD_ModularPart_Magnifier_VOTechG33</part><railOffset>-0.0215</railOffset></li>
          <li><socketId>rail_receiver_top</socketId><part>HD_ModularPart_Optic_VOTechEXPS</part><railOffset>0.0215</railOffset></li>
        </defaultAttachments>
      </li>
    </comps>
  </ThingDef>

