<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingCategoryDef>
    <defName>HD_ModularWeaponParts</defName>
    <label>modular weapon parts</label>
    <parent>Manufactured</parent>
  </ThingCategoryDef>

  <!-- Internal representation shared by installed parts. Small parts are deliberately not
       selectable or haulable as loose world objects; outside a weapon they live as counts
       in a linked weapon-parts box. Independently valuable assemblies opt back in below. -->
  <ThingDef Name="HD_ModularWeaponPartBase" Abstract="True">
    <thingClass>Helodrace.ModernWar.ModularWeaponThing</thingClass>
    <category>Item</category>
    <techLevel>Industrial</techLevel>
    <drawerType>MapMeshOnly</drawerType>
    <selectable>false</selectable>
    <alwaysHaulable>false</alwaysHaulable>
    <useHitPoints>true</useHitPoints>
    <stackLimit>1</stackLimit>
    <altitudeLayer>Item</altitudeLayer>
    <drawGUIOverlay>true</drawGUIOverlay>
    <soundInteract>Standard_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <graphicData>
      <graphicClass>Helodrace.ModernWar.Graphic_ModularWeaponAssembly</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>0.2</Mass>
      <MarketValue>50</MarketValue>
    </statBases>
  </ThingDef>

  <!-- Full-canvas internal AR-15 parts. Their zero-point mounts preserve the
       receiver texture alignment while the renderer applies firing animation. -->
  <ThingDef ParentName="HD_ModularWeaponPartBase">
    <defName>HD_ModularPart_Bolt_AR15</defName>
    <label>AR-15 bolt carrier group</label>
    <description>An internal AR-15 bolt carrier group animated through the firing cycle.</description>
    <graphicData><texPath>Weapons/Modular/Actions/HD_Bolt_AR15</texPath></graphicData>
    <comps>
      <li Class="Helodrace.ModernWar.CompProperties_ModularWeaponNode">
        <graphicLayer>0.5</graphicLayer>
        <animatedPart>Bolt</animatedPart>
        <animationTravel>(-0.078,0,0)</animationTravel>
        <mounts><li><id>bolt_mount</id><socketTags><li>ar15_bolt</li></socketTags><transform><position>(-0.044,0,-0.002)</position></transform></li></mounts>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="HD_ModularWeaponPartBase">
    <defName>HD_ModularPart_Trigger_AR15</defName>
    <label>AR-15 trigger</label>
    <description>An internal AR-15 trigger animated when the weapon fires.</description>
    <graphicData><texPath>Weapons/Modular/Actions/HD_Trigger_AR15</texPath></graphicData>
    <comps>
      <li Class="Helodrace.ModernWar.CompProperties_ModularWeaponNode">
        <graphicLayer>0.5</graphicLayer>
        <animatedPart>Trigger</animatedPart>
        <animationPivot>(-0.135,0,-0.02)</animationPivot>
        <animationAngle>-14</animationAngle>
        <mounts><li><id>trigger_mount</id><socketTags><li>ar15_trigger</li></socketTags><transform><position>(-0.138,0,-0.052)</position><layer>1</layer></transform></li></mounts>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="HD_ModularWeaponPartBase">
    <defName>HD_ModularPart_UpperReceiver_M4A1</defName>
    <label>M4A1 upper receiver</label>
    <selectable>true</selectable>
    <alwaysHaulable>true</alwaysHaulable>
    <thingCategories><li>HD_ModularWeaponParts</li></thingCategories>
    <graphicData><texPath>Weapons/Modular/Receivers/HD_UpperReceiver_M16a4</texPath></graphicData>
    <comps>
      <li Class="Helodrace.ModernWar.CompProperties_ModularWeaponNode">
        <storageMode>IndependentThing</storageMode>
        <graphicOffset>(0,0,0)</graphicOffset>
        <graphicLayer>1</graphicLayer>
        <outlinePriority>100</outlinePriority>
        <casingPort><offset>(-0.096,0,0)</offset><ejectionAngleOffset>90</ejectionAngleOffset><speedMin>1.7</speedMin><speedMax>2.4</speedMax><scale>0.75</scale><ejectionCycleFraction>0.28</ejectionCycleFraction><feedStartCycleFraction>0.55</feedStartCycleFraction><feedEndCycleFraction>0.92</feedEndCycleFraction><feedStartOffset>(-0.076,0,-0.01)</feedStartOffset><feedEndOffset>(-0.023,0,-0.004)</feedEndOffset><feedingRoundDrawSize>0.12</feedingRoundDrawSize></casingPort>
        <mounts>
          <li><id>receiver_mount</id><socketTags><li>upper_receiver</li></socketTags><transform><position>(-0.095,0,-0.017)</position></transform></li>
        </mounts>
        <sockets>
          <li><id>barrel</id><label>barrel extension</label><tags><li>ar15_barrel</li></tags><transform><position>(-0.023,0,-0.005)</position></transform></li>
          <li><id>handguard</id><label>handguard mount</label><tags><li>ar15_handguard</li></tags><transform><position>(-0.023,0,-0.005)</position></transform></li>
          <li><id>bolt</id><label>bolt carrier group</label><tags><li>ar15_bolt</li></tags><required>true</required><transform><position>(-0.044,0,-0.002)</position></transform></li>
          <!-- One continuous receiver rail authored from the latest M4 placement export. -->
          <li><id>rail_receiver_top</id><label>upper receiver top rail</label><tags><li>picatinny</li><li>top_rail</li><li>receiver_rail</li></tags><isRail>true</isRail><railLength>0.152</railLength><railSurface>Top</railSurface><transform><position>(-0.114,0,0.017)</position></transform></li>
        </sockets>
        <defaultAttachments>
          <li><socketId>barrel</socketId><part>HD_ModularPart_Barrel_AR15103</part></li>
          <li><socketId>handguard</socketId><part>HD_ModularPart_Handguard_HACRISFDE</part></li>
          <li><socketId>bolt</socketId><part>HD_ModularPart_Bolt_AR15</part></li>
          <li><socketId>rail_receiver_top</socketId><part>HD_ModularPart_Magnifier_VOTechG33</part><railOffset>-0.034</railOffset></li>
          <li><socketId>rail_receiver_top</socketId><part>HD_ModularPart_Optic_VOTechEXPS</part><railOffset>0.036</railOffset></li>
        </defaultAttachments>
      </li>
    </comps>
  </ThingDef>

