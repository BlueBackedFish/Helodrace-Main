  <ThingDef ParentName="HD_M16FamilyBase">
    <defName>HD_Gun_M16A4_Weapon</defName>
    <label>M16A4</label>
    <description>A modern service rifle chambered for a small-caliber, high-velocity cartridge. It fires a controlled three-round burst, while a Helod sharpshooter can trade eight tiles of effective range for near-instant target acquisition.</description>
    <recipeMaker>
      <researchPrerequisite>HelodHighAutomaticRifle</researchPrerequisite>
      <recipeUsers Inherit="False"><li>HD_BasicWorkbench</li></recipeUsers>
    </recipeMaker>
  </ThingDef>

