    <graphicData><texPath>Weapons/Modular/Tactical/HD_PicatinnyLOW_TLR7X</texPath></graphicData>
    <comps><li Class="Helodrace.ModernWar.CompProperties_ModularWeaponNode">
      <craftCost><Steel>2</Steel><ComponentIndustrial>1</ComponentIndustrial></craftCost>
      <requiredResearch><li>HelodAdvancedWeaponOptics</li></requiredResearch>
      <graphicLayer>5</graphicLayer><verticalOccupancy>0.031</verticalOccupancy><verticalOccupancyOffset>0.01</verticalOccupancyOffset>
      <flashlight><emitterOffset>(0.145,0,0.025)</emitterOffset><color>(1,0.95,0.75,0.24)</color><nearWidth>0.25</nearWidth><farWidth>1.2</farWidth><circleRadius>0.6</circleRadius><closeRange>3.5</closeRange><maxRange>20</maxRange><hediff>HD_WeaponFlashlightDazzle</hediff></flashlight>
      <internalStats><massKg>0.075</massKg><ergonomics>-1</ergonomics><targetAcquisition>2</targetAcquisition></internalStats>
      <mounts><li><id>rail_mount</id><socketTags><li>picatinny</li></socketTags><railOccupancy>0.055</railOccupancy><railContactLength>0.035</railContactLength><physicalLength>0.065</physicalLength><railSurface>Bottom</railSurface><transform><position>(0.1,0,0.04)</position></transform></li></mounts>
    </li></comps>
  </ThingDef>

</Defs>
