  </Helodrace.ModernWar.ModularArmorPartDef>
  <Helodrace.ModernWar.ModularArmorPartDef>
    <defName>HD_IOTVPart_FrontRear_SAPI</defName>
    <!-- 방탄 참고: NIJ 0101.07 위협등급 rf1-rf2; 소재: 세라믹 + 방탄섬유 백킹(아라미드/UHMWPE, 모델별 확인); 정확한 섬유 백킹은 제조사/리비전별 확인; 연질 방탄복 병용 기준 추정, 군용 규격은 NIJ 인증과 별개. 실제 아이템 기준: HD_ArmorPlate_SAPI. 세라믹 및 섬유의 세부 등급은 미지정. -->
