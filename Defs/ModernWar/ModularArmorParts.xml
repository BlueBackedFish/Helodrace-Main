  <!-- Fixed parts have an authored installation location. -->
  <Helodrace.ModernWar.ModularArmorPartDef>
    <defName>HD_IOTVPart_FrontRearPlates</defName>
    <!-- 방탄 참고: NIJ 0101.07 위협등급 rf1-rf3; 소재: 세라믹; 이전 저장용 일반 방탄판의 넓은 임시 범위. 실제 모델/시험자료 미지정. 타격면/섬유 백킹의 세부 소재 미지정. -->
    <label>IBTV front/rear plate set</label>
    <slot>HD_MA_Slot_FrontRearPlates</slot>
    <installMode>Fixed</installMode>
    <fixedPosition>HD_MA_Pos_FrontRearTorso</fixedPosition>
    <compatibleArmorTags><li>HD_IOTVGen4</li></compatibleArmorTags>
    <armorRatingSharp>1.20</armorRatingSharp>
    <armorRatingBlunt>0.50</armorRatingBlunt>
    <armorRatingHeat>0.30</armorRatingHeat>
    <ergonomics>-2</ergonomics>
    <ventilation>-2</ventilation>
    <loadDistribution>2</loadDistribution>
    <playerSelectable>false</playerSelectable>
  </Helodrace.ModernWar.ModularArmorPartDef>
  <Helodrace.ModernWar.ModularArmorPartDef>
    <defName>HD_IOTVPart_SidePlates</defName>
    <!-- 방탄 참고: NIJ 0101.07 위협등급 rf1-rf3; 소재: 세라믹; 이전 저장용 일반 방탄판의 넓은 임시 범위. 실제 모델/시험자료 미지정. 타격면/섬유 백킹의 세부 소재 미지정. -->
