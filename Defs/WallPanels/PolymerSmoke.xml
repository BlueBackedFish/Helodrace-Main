<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <Helodrace.HelodGasDef>
    <defName>HD_PolymerFireSmoke</defName>
    <label>polymer fire smoke</label>
    <description>Dense toxic smoke released by burning polystyrene foam.</description>
    <color>(0.25,0.24,0.22,0.65)</color>
    <dissipationRate>3</dissipationRate>
    <diffusionThreshold>10</diffusionThreshold>
    <diffusionTransferDivisor>2</diffusionTransferDivisor>
    <minDensityForEffect>8</minDensityForEffect>
    <severityPerTickAtFullDensity>0.00008</severityPerTickAtFullDensity>
    <accuracyFactor>.75</accuracyFactor>
    <workerClass>Helodrace.Panels.HelodGasWorker_PolymerSmoke</workerClass>
  </Helodrace.HelodGasDef>
</Defs>
