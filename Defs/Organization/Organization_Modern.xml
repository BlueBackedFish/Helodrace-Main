<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- USMC-style billets share one PawnKind and override weapon presets by slot. -->
  <Helodrace.Squads.RoleDef ParentName="HD_CombatRoleBase">
    <defName>HD_Role_Grenadier</defName><label>grenadier</label><combatFunction>Grenadier</combatFunction>
    <successionPriority>20</successionPriority>
  </Helodrace.Squads.RoleDef>
  <Helodrace.Squads.RoleDef ParentName="HD_CombatRoleBase">
    <defName>HD_Role_AssistantAutomaticRifleman</defName><label>assistant automatic rifleman</label><combatFunction>Rifle</combatFunction>
    <successionPriority>35</successionPriority>
  </Helodrace.Squads.RoleDef>

  <Helodrace.Squads.FormationDef>
    <defName>HD_Formation_MW_Fireteam</defName><label>modern fireteam</label><unitLevel>Team</unitLevel>
    <minimumPersonnel>4</minimumPersonnel><idealPersonnel>4</idealPersonnel><maximumPersonnel>4</maximumPersonnel>
    <commanderRole>HD_Role_TeamLeader</commanderRole><doctrine>HD_Doctrine_Modern</doctrine>
    <requiredRoles>
      <!-- Team leader operates the M203A2; the automatic rifleman carries the M249. -->
      <li><pawnKind>HD_MW_HelodRifleman</pawnKind><combatRole>HD_Role_Grenadier</combatRole><weaponPreset>HD_WeaponPreset_M16A4_UBGL</weaponPreset><inventoryLoadout><li>HD_MilitaryTablet</li><li>HD_40mmM381HE_Round</li><li>HD_40mmM381HE_Round</li><li>HD_40mmM381HE_Round</li><li>HD_40mmM381HE_Round</li><li>HD_40mmM381HE_Round</li><li>HD_40mmM381HE_Round</li></inventoryLoadout><commandRole>HD_Role_TeamLeader</commandRole><commandQualifications><li>HD_Role_SquadLeader</li></commandQualifications><explicitSuccessionOrder>0</explicitSuccessionOrder><equipmentPointCost>40</equipmentPointCost><apparelLoadout><li>HD_Apparel_ZaperX26_Device</li></apparelLoadout><grenadeLoadout><li>HD_Grenade_M84_Item</li></grenadeLoadout></li>
      <li><pawnKind>HD_MW_HelodRifleman</pawnKind><combatRole>HD_Role_AutomaticRifleman</combatRole><weaponPreset>HD_WeaponPreset_M249_USMC</weaponPreset><explicitSuccessionOrder>1</explicitSuccessionOrder><grenadeLoadout><li>HD_Grenade_M8_Item</li></grenadeLoadout></li>
      <li><pawnKind>HD_MW_HelodRifleman</pawnKind><combatRole>HD_Role_AssistantAutomaticRifleman</combatRole><apparelLoadout><li>HD_Apparel_GW_Sledgehammer</li></apparelLoadout><explicitSuccessionOrder>2</explicitSuccessionOrder><grenadeLoadout><li>HD_Grenade_M67_Item</li></grenadeLoadout></li>
      <li><pawnKind>HD_MW_HelodRifleman</pawnKind><combatRole>HD_Role_Rifleman</combatRole><explicitSuccessionOrder>3</explicitSuccessionOrder><grenadeLoadout><li>HD_Grenade_M67_Item</li></grenadeLoadout></li>
    </requiredRoles>
  </Helodrace.Squads.FormationDef>

  <Helodrace.Squads.FormationDef>
    <defName>HD_Formation_MW_RifleSquad</defName><label>modern rifle squad</label><unitLevel>Squad</unitLevel>
    <minimumPersonnel>13</minimumPersonnel><idealPersonnel>13</idealPersonnel><maximumPersonnel>13</maximumPersonnel>
    <selectionPriority>100</selectionPriority><commanderRole>HD_Role_SquadLeader</commanderRole><doctrine>HD_Doctrine_Modern</doctrine>
    <requiredRoles>
      <li><pawnKind>HD_MW_HelodRifleman</pawnKind><combatRole>HD_Role_Rifleman</combatRole><inventoryLoadout><li>HD_MilitaryTablet</li></inventoryLoadout><commandRole>HD_Role_SquadLeader</commandRole><commandQualifications><li>HD_Role_PlatoonLeader</li></commandQualifications><explicitSuccessionOrder>0</explicitSuccessionOrder><equipmentPointCost>140</equipmentPointCost><apparelLoadout><li>HD_Apparel_ZaperX26_Device</li></apparelLoadout><grenadeLoadout><li>HD_Grenade_M7A2_Item</li><li>HD_C4_Charge</li><li>HD_C4_Charge</li><li>HD_C4_Charge</li><li>HD_M81Igniter</li></grenadeLoadout></li>
    </requiredRoles>
    <childFormations>
      <li><formation>HD_Formation_MW_Fireteam</formation><count>3</count><successionPriority>0</successionPriority></li>
    </childFormations>
  </Helodrace.Squads.FormationDef>

  <Helodrace.Squads.FormationDef>
    <defName>HD_Formation_MW_RiflePlatoon</defName><label>modern rifle platoon</label><unitLevel>Platoon</unitLevel>
    <minimumPersonnel>43</minimumPersonnel><idealPersonnel>43</idealPersonnel><maximumPersonnel>43</maximumPersonnel>
    <selectionPriority>200</selectionPriority><commanderRole>HD_Role_PlatoonLeader</commanderRole><doctrine>HD_Doctrine_Modern</doctrine>
    <requiredRoles>
      <li><pawnKind>HD_MW_HelodRifleman</pawnKind><combatRole>HD_Role_Rifleman</combatRole><inventoryLoadout><li>HD_MilitaryTablet</li></inventoryLoadout><commandRole>HD_Role_PlatoonLeader</commandRole><explicitSuccessionOrder>0</explicitSuccessionOrder><grenadeLoadout><li>HD_Grenade_M84_Item</li></grenadeLoadout></li>
      <li><pawnKind>HD_MW_HelodRifleman</pawnKind><combatRole>HD_Role_Rifleman</combatRole><commandRole>HD_Role_PlatoonSergeant</commandRole><explicitSuccessionOrder>1</explicitSuccessionOrder><grenadeLoadout><li>HD_Grenade_M8_Item</li></grenadeLoadout></li>
      <li><pawnKind>HD_MW_HelodRifleman</pawnKind><combatRole>HD_Role_Rifleman</combatRole><commandQualifications><li>HD_Role_PlatoonLeader</li></commandQualifications><explicitSuccessionOrder>2</explicitSuccessionOrder><grenadeLoadout><li>HD_Grenade_M67_Item</li></grenadeLoadout></li>
      <li><pawnKind>HD_MW_HelodRifleman</pawnKind><combatRole>HD_Role_Rifleman</combatRole><explicitSuccessionOrder>3</explicitSuccessionOrder><grenadeLoadout><li>HD_Grenade_M67_Item</li></grenadeLoadout></li>
    </requiredRoles>
    <childFormations>
      <li><formation>HD_Formation_MW_RifleSquad</formation><count>3</count><successionPriority>0</successionPriority></li>
    </childFormations>
  </Helodrace.Squads.FormationDef>

  <Helodrace.Squads.DoctrineDef>
    <defName>HD_Doctrine_Modern</defName><label>modern combined-arms doctrine</label>
    <formationPointTolerance>0.10</formationPointTolerance>
    <commandLossDelayTicks>45</commandLossDelayTicks><commandRecoveryTicks>180</commandRecoveryTicks>
    <actingCommandEfficiency>0.85</actingCommandEfficiency>
    <tacticalRadio>true</tacticalRadio>
    <directControl>0.5</directControl><fireteamIndependence>0.8</fireteamIndependence>
    <squadCohesion>0.8</squadCohesion><distributedLeadership>0.8</distributedLeadership>
    <availableFormations>
      <li>HD_Formation_MW_RiflePlatoon</li><li>HD_Formation_MW_RifleSquad</li>
    </availableFormations>
  </Helodrace.Squads.DoctrineDef>
</Defs>
