      <li><pawnKind>HD_MW_HelodRifleman</pawnKind><combatRole>HD_Role_Rifleman</combatRole><commandRole>HD_Role_TeamLeader</commandRole><commandQualifications><li>HD_Role_SquadLeader</li></commandQualifications><explicitSuccessionOrder>0</explicitSuccessionOrder><grenadeLoadout><li>HD_Grenade_M84_Item</li></grenadeLoadout></li>
