  <!-- 4. Eastern Helod (동부 늑대) -->
  <XenotypeDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>HD_EasternHelod</defName>
    <label>eastern helod</label>
    <description>An urban Helod lineage experienced in commerce and precise work. They excel at social tasks, research, and crafting, but have frail bodies and sensitive minds.</description>
    <descriptionShort>An intellectual, highly social 내정-focused monopolist helod.</descriptionShort>
    <iconPath>Icons/HD_Helod</iconPath>
    <inheritable>true</inheritable>
    <nameMaker>HD_NamerPersonHelod</nameMaker>
    <nameMakerFemale>HD_NamerPersonHelod</nameMakerFemale>
    <chanceToUseNameMaker>1</chanceToUseNameMaker>
    <genes>
