<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <XenotypeDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>HD_MackenzieValleyHelod</defName>
    <label>Mackenzie Valley helod</label>
    <description>Composed commanders and field medics. Strong social and medical aptitudes and reduced pain help them protect a group, at the cost of slow movement, demanding nutrition, pride and weaker research aptitude.</description>
    <descriptionShort>Commanders and field medics; slow, proud and hungry.</descriptionShort>
    <iconPath>Icons/HD_HelodRace</iconPath>
    <inheritable>true</inheritable>
    <nameMaker>HD_NamerPersonHelod</nameMaker>
    <nameMakerFemale>HD_NamerPersonHelod</nameMakerFemale>
    <chanceToUseNameMaker>1</chanceToUseNameMaker>
    <genes>
      <li MayRequire="Ludeon.RimWorld.Biotech">HD_Gene_BTXDependency</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">HD_Gene_Sharpshooter</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">Hair_DarkBlack</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">MoveSpeed_Slow</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">Beauty_Pretty</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">Pain_Reduced</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">HD_Gene_ArrogantLeader</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">AptitudeStrong_Medicine</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">AptitudePoor_Intellectual</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">AptitudeStrong_Shooting</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">AptitudeRemarkable_Social</li>
    </genes>
  </XenotypeDef>
  <XenotypeDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>HD_TexasHelod</defName>
    <label>Texas helod</label>
    <description>Hot-country trackers who support a frontier camp through farming, animal handling and hunting. Quick movement and heat tolerance come with fragile bodies, poor social aptitude and vulnerability to cold.</description>
    <descriptionShort>Farmers, handlers and hunters; quick but fragile and cold-sensitive.</descriptionShort>
    <iconPath>Icons/HD_HelodRace</iconPath>
    <inheritable>true</inheritable>
    <nameMaker>HD_NamerPersonHelod</nameMaker>
    <nameMakerFemale>HD_NamerPersonHelod</nameMakerFemale>
    <chanceToUseNameMaker>1</chanceToUseNameMaker>
    <genes>
      <li MayRequire="Ludeon.RimWorld.Biotech">HD_Gene_BTXDependency</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">HD_Gene_Sharpshooter</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">Hair_SandyBlonde</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">MoveSpeed_Quick</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">MaxTemp_LargeIncrease</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">MinTemp_SmallIncrease</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">Delicate</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">AptitudeStrong_Plants</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">AptitudeStrong_Animals</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">AptitudeStrong_Shooting</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">AptitudePoor_Social</li>
    </genes>
  </XenotypeDef>
  <XenotypeDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>HD_ArcticHelod</defName>
    <label>arctic helod</label>
    <description>Cold-country scouts with exceptional shooting aptitude. Unroofed positions at 10 C or colder shorten aiming time by 15%. Heat, disease, farming, social work and general work speed are weaknesses.</description>
    <descriptionShort>Polar scouts and marksmen; cold-field focus, weak immunity and heat sensitivity.</descriptionShort>
    <iconPath>Icons/HD_HelodRace</iconPath>
    <inheritable>true</inheritable>
    <nameMaker>HD_NamerPersonHelod</nameMaker>
    <nameMakerFemale>HD_NamerPersonHelod</nameMakerFemale>
    <chanceToUseNameMaker>1</chanceToUseNameMaker>
    <genes>
      <li MayRequire="Ludeon.RimWorld.Biotech">HD_Gene_BTXDependency</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">HD_Gene_Sharpshooter</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">Hair_SnowWhite</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">MoveSpeed_Quick</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">MinTemp_LargeDecrease</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">MaxTemp_SmallDecrease</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">HD_Gene_PolarPrecision</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">AptitudePoor_Plants</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">AptitudeRemarkable_Shooting</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">AptitudePoor_Social</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">Immunity_Weak</li>
    </genes>
  </XenotypeDef>
  <XenotypeDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>HD_EasternHelod</defName>
    <label>eastern helod</label>
    <description>Urban researchers and precision crafters with useful trading skills. Research and crafting each receive a small speed bonus, while fragile bodies and slow wound healing make front-line combat costly.</description>
    <descriptionShort>Researchers and precision crafters; useful traders, fragile and slow to heal.</descriptionShort>
    <iconPath>Icons/HD_HelodRace</iconPath>
    <inheritable>true</inheritable>
    <nameMaker>HD_NamerPersonHelod</nameMaker>
    <nameMakerFemale>HD_NamerPersonHelod</nameMakerFemale>
    <chanceToUseNameMaker>1</chanceToUseNameMaker>
    <genes>
      <li MayRequire="Ludeon.RimWorld.Biotech">HD_Gene_BTXDependency</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">HD_Gene_Sharpshooter</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">Hair_Gray</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">Delicate</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">WoundHealing_Slow</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">HD_Gene_Monopolist</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">AptitudeStrong_Intellectual</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">AptitudeStrong_Crafting</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">AptitudeStrong_Social</li>
    </genes>
  </XenotypeDef>
  <XenotypeDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>HD_MexicanHelod</defName>
    <label>Mexican helod</label>
    <description>Mobile mercenaries with strong shooting and melee aptitudes, toughness and fast healing. A healthy allied Helod within eight cells improves composure and evasion. Maintaining BTX and amphetamine supplies is essential.</description>
    <descriptionShort>Mobile mercenaries; resilient with comrades, dependent on two supply chains.</descriptionShort>
    <iconPath>Icons/HD_HelodRace</iconPath>
    <inheritable>true</inheritable>
    <nameMaker>HD_NamerPersonHelod</nameMaker>
    <nameMakerFemale>HD_NamerPersonHelod</nameMakerFemale>
    <chanceToUseNameMaker>1</chanceToUseNameMaker>
    <genes>
      <li MayRequire="Ludeon.RimWorld.Biotech">HD_Gene_BTXDependency</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">HD_Gene_Sharpshooter</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">Hair_DarkBrown</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">MoveSpeed_Quick</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">Robust</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">WoundHealing_Fast</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">KindInstinct</li>
      <li MayRequire="BlueBackedFish.Helod.BlancasDrugs">HD_Gene_AmphetamineDependency</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">HD_Gene_MercenaryCohesion</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">AptitudePoor_Plants</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">AptitudeStrong_Shooting</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">AptitudeStrong_Melee</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">AptitudePoor_Social</li>
    </genes>
  </XenotypeDef>
