    </genes>
  </XenotypeDef>

  <!-- 3. Arctic Helod (북극늑대) -->
  <XenotypeDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>HD_ArcticHelod</defName>
    <label>arctic helod</label>
    <description>A Helod lineage adapted to cold-weather scouting and long-range shooting. They tolerate severe cold but struggle with heat, illness, and close company.</description>
    <descriptionShort>An elite polar sniper and lone wolf helod.</descriptionShort>
    <iconPath>Icons/HD_Helod</iconPath>
    <inheritable>true</inheritable>
    <nameMaker>HD_NamerPersonHelod</nameMaker>
    <nameMakerFemale>HD_NamerPersonHelod</nameMakerFemale>
    <chanceToUseNameMaker>1</chanceToUseNameMaker>
    <genes>
