<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>HD_Gene_BTXDependency</defName>
    <label>BTX dependency</label>
    <description>Carriers of this gene permanently develop BTX addiction. The addiction creates a BTX need which must be replenished with benzene, toluene, or xylene compounds to prevent dangerous withdrawal.</description>
    <geneClass>Helodrace.Gene_BTXAddiction</geneClass>
    <chemical>BTX</chemical>
    <labelShortAdj>BTX-dependent</labelShortAdj>
    <iconPath>Icons/HD_Aromatic</iconPath>
    <displayCategory>Drugs</displayCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>3</biostatMet>
    <exclusionTags>
      <li>AddictionBTX</li>
    </exclusionTags>
  </GeneDef>
  <GeneDef MayRequire="BlueBackedFish.Helod.BlancasDrugs">
    <defName>HD_Gene_AmphetamineDependency</defName>
    <label>amphetamine dependency</label>
    <description>Carriers of this gene need to ingest amphetamines on a regular basis to survive. After 5 days without amphetamines, carriers suffer from amphetamine deficiency. After 30 days, they fall into a coma. After 60 days, they die.</description>
    <geneClass>Gene_ChemicalDependency</geneClass>
    <chemical>BD_Amphetamines</chemical>
    <labelShortAdj>amphetamine-dependent</labelShortAdj>
    <iconPath>Icons/HD_Amphetamine</iconPath>
    <displayCategory>Drugs</displayCategory>
    <addictionChanceFactor>0</addictionChanceFactor>
    <minAgeActive>13</minAgeActive>
    <biostatCpx>1</biostatCpx>
    <biostatMet>4</biostatMet>
    <exclusionTags>
      <li>AddictionBD_Amphetamines</li>
    </exclusionTags>
  </GeneDef>
  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>HD_Gene_Sharpshooter</defName>
    <label>sharpshooter</label>
    <description>A knack for handling firearms, enough to use their special techniques.</description>
    <iconPath>Icons/HD_Sharpshooter</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biostatCpx>0</biostatCpx>
    <biostatMet>0</biostatMet>
    <biostatArc>0</biostatArc>
    <statOffsets>
      <ShootingAccuracyPawn>1.5</ShootingAccuracyPawn>
    </statOffsets>
    <statFactors>
      <RangedWeapon_Cooldown>0.9</RangedWeapon_Cooldown>
    </statFactors>
  </GeneDef>
  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>HD_Gene_ArrogantLeader</defName>
    <label>arrogant leader</label>
    <description>A commanding presence improves social impact by 15%, but pride raises mental break threshold by 4% and lowers learning speed by 10%.</description>
    <iconPath>Icons/HD_Helod</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-2</biostatMet>
    <statOffsets>
      <SocialImpact>0.15</SocialImpact>
      <MentalBreakThreshold>0.04</MentalBreakThreshold>
      <GlobalLearningFactor>-0.1</GlobalLearningFactor>
    </statOffsets>
  </GeneDef>
  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>HD_Gene_PolarPrecision</defName>
    <label>polar precision</label>
    <description>In an unroofed position at 10 C or colder, aiming time is 85% of normal. General work speed is reduced by 5%.</description>
    <iconPath>Icons/HD_Sharpshooter</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-1</biostatMet>
    <conditionalStatAffecters>
      <li Class="Helodrace.ConditionalStatAffecter_PolarField">
        <statFactors>
          <AimingDelayFactor>0.85</AimingDelayFactor>
        </statFactors>
      </li>
    </conditionalStatAffecters>
    <statOffsets>
      <WorkSpeedGlobal>-0.05</WorkSpeedGlobal>
    </statOffsets>
  </GeneDef>
  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>HD_Gene_Monopolist</defName>
    <label>urban precision</label>
    <description>Urban experience improves research speed and general labor speed by 5%, trade price improvement by 8%, and negotiation ability by 10%.</description>
    <iconPath>Icons/HD_Helod</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-3</biostatMet>
    <statOffsets>
      <TradePriceImprovement>0.08</TradePriceImprovement>
      <NegotiationAbility>0.1</NegotiationAbility>
    </statOffsets>
    <statFactors>
      <ResearchSpeed>1.05</ResearchSpeed>
      <GeneralLaborSpeed>1.05</GeneralLaborSpeed>
    </statFactors>
  </GeneDef>
  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>HD_Gene_MercenaryCohesion</defName>
    <label>mercenary cohesion</label>
    <description>With a healthy allied Helod within eight cells, pain shock threshold increases by 10% and melee dodging improves. The effect requires an allied Helod who is not downed.</description>
    <iconPath>Icons/HD_Sharpshooter</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biostatCpx>3</biostatCpx>
    <biostatMet>-2</biostatMet>
    <conditionalStatAffecters>
      <li Class="Helodrace.ConditionalStatAffecter_HelodComrades">
        <statOffsets>
          <PainShockThreshold>0.10</PainShockThreshold>
          <MeleeDodgeChance>5</MeleeDodgeChance>
        </statOffsets>
      </li>
    </conditionalStatAffecters>
  </GeneDef>
</Defs>