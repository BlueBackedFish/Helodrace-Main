    <defName>HD_HelodRaceSettings</defName>
    <drawScale>0.8</drawScale>
    <!-- Head-anchor Z offsets are additive and scaled by the square root of
         bodySizeFactor unless absolute is true. Teenagers and adults share
         the same final Z position, regardless of life-stage body size.
         Greatest minAge <= biological age wins. Missing entries keep vanilla Z.
         Restart the game after editing. -->
    <headOffsets>
      <li><minAge>0</minAge><female>-0.5</female><male>-0.07</male></li>
      <li><minAge>3</minAge><female>-0.125</female><male>-1.2</male></li>
      <li><minAge>13</minAge><female>0.265</female><male>0.265</male><absolute>true</absolute></li>
    </headOffsets>
