<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>HD_HelodCoveredEars</defName>
    <label>covered ears</label>
    <description>The apparel presses down on the Helod's large ears and muffles the surrounding world.</description>
    <defaultLabelColor>(0.82,0.68,0.45)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <isBad>true</isBad>
    <stages>
      <li>
        <label>covered ears</label>
        <painOffset>0.35</painOffset>
        <capMods>
          <li>
            <capacity>Hearing</capacity>
            <offset>-0.50</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <ThoughtDef>
    <defName>HD_HelodCoveredEarsMood</defName>
    <thoughtClass>Thought_Situational</thoughtClass>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>HD_HelodCoveredEars</hediff>
    <stages>
      <li>
        <label>ears uncomfortably covered</label>
        <description>My ears are pinned down and every sound is muffled. I hate being cut off from my surroundings like this.</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
