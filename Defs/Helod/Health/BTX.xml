<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef>
    <defName>HD_BTXHigh</defName>
    <label>BTX stabilization</label>
    <labelNoun>BTX stabilization</labelNoun>
    <description>BTX compounds are circulating through the bloodstream, temporarily stabilizing BTX-dependent biochemical pathways.</description>
    <hediffClass>Hediff_High</hediffClass>
    <defaultLabelColor>(0.35,0.85,0.95)</defaultLabelColor>
    <scenarioCanAdd>true</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1.0</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
    <stages>
      <li />
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>HD_BTXToxicity</defName>
    <label>BTX poisoning</label>
    <labelNoun>BTX poisoning</labelNoun>
    <description>BTX compounds are irritating and poisoning this body. Helod biochemistry can metabolize these compounds, but other species suffer petroleum-like toxic effects.</description>
    <hediffClass>Helodrace.Hediff_BTXToxicity</hediffClass>
    <defaultLabelColor>(0.8,0.85,0.45)</defaultLabelColor>
    <scenarioCanAdd>true</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <isBad>true</isBad>
    <stages>
      <li>
        <label>mild</label>
        <painOffset>0.08</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.45</minSeverity>
        <label>sick</label>
        <painOffset>0.18</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.12</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.10</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.08</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.75</minSeverity>
        <label>severe</label>
        <lifeThreatening>true</lifeThreatening>
        <painOffset>0.35</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.25</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.20</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>HD_BTXDeficiency</defName>
    <label>BTX deficiency</label>
    <labelNoun>BTX deficiency</labelNoun>
    <description>A legacy BTX deficiency state. It will clear automatically now that BTX dependency is managed by the genetic chemical-dependency system.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9,0.35,0.25)</defaultLabelColor>
    <scenarioCanAdd>true</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <lethalSeverity>1.0</lethalSeverity>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>minor</label>
        <painOffset>0.05</painOffset>
      </li>
      <li>
        <minSeverity>0.25</minSeverity>
        <label>deficiency</label>
        <painOffset>0.12</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.08</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.08</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.60</minSeverity>
        <label>critical</label>
        <painOffset>0.25</painOffset>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.25</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.20</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>HD_PlainDogChewHigh</defName>
    <label>chewing plain dog chew</label>
    <labelNoun>plain dog chew effect</labelNoun>
    <description>Chewing</description>
    <hediffClass>Hediff_High</hediffClass>
    <defaultLabelColor>(0.55,0.75,0.65)</defaultLabelColor>
    <scenarioCanAdd>true</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-3.0</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.3</offset>
          </li>
          <li>
            <capacity>Eating</capacity>
            <offset>-0.3</offset>
          </li>
          <li>
            <capacity>Talking</capacity>
            <offset>-0.7</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.1</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <ChemicalDef>
    <defName>BTX</defName>
    <label>BTX</label>
    <addictionHediff>HD_BTXAddiction</addictionHediff>
    <canBeAddicted>false</canBeAddicted>
    <generateAddictionGenes>false</generateAddictionGenes>
    <canBinge>false</canBinge>
    <geneOverdoseChanceFactorResist>0.5</geneOverdoseChanceFactorResist>
    <geneOverdoseChanceFactorImmune>0</geneOverdoseChanceFactorImmune>
  </ChemicalDef>

  <NeedDef ParentName="DrugAddictionNeedBase">
    <defName>Chemical_BTX</defName>
    <needClass>Need_Chemical</needClass>
    <label>BTX</label>
    <description>Because of a BTX addiction, this person needs to regularly consume benzene, toluene, or xylene compounds to avoid withdrawal symptoms.</description>
    <fallPerDay>0.333</fallPerDay>
    <listPriority>46</listPriority>
  </NeedDef>

  <HediffDef ParentName="AddictionBase">
    <defName>HD_BTXAddiction</defName>
    <label>BTX addiction</label>
    <description>A permanent biochemical addiction to benzene, toluene, and xylene compounds caused by the BTX dependency gene. This addiction creates and controls the BTX need.</description>
    <hediffClass>Hediff_Addiction</hediffClass>
    <chemicalNeed>Chemical_BTX</chemicalNeed>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li />
      <li>
        <label>withdrawal</label>
        <painOffset>0.25</painOffset>
        <lifeThreatening>true</lifeThreatening>
        <deathMtbDays>10</deathMtbDays>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.25</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.20</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
