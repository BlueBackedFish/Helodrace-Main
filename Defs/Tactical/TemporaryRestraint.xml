<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>HD_TemporaryRestraint</defName>
    <label>temporary restraint</label>
    <description>Bound so that, even after recovering, this person cannot move or attack on their own. Someone else can untie the restraint.</description>
    <hediffClass>Hediff</hediffClass>
    <isBad>true</isBad>
    <tendable>false</tendable>
    <stages>
      <li>
        <capMods>
          <li><capacity>Moving</capacity><setMax>0</setMax></li>
          <li><capacity>Manipulation</capacity><setMax>0</setMax></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
  <JobDef>
    <defName>HD_TemporaryRestrain</defName>
    <driverClass>Helodrace.Tactical.JobDriver_TemporaryRestrain</driverClass>
    <reportString>handling TargetA's restraint.</reportString>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>
</Defs>
