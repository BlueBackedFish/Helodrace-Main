<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Docs/Ballistic_Protection_System.md section 6.1. Offsets are the torso/head yaw relative to the aim direction
    (positive = clockwise, so a right-handed shooter in a bladed stance turns the chest to the right of the
    target). They apply only while the pawn is engaged (aiming a ranged or melee attack; player pawns must be
    drafted); otherwise the vanilla four-way facing is used. Turns are not rate limited. All values are game values [game] chosen from the general
    tendency of each weapon family, not measured shooter data.
    weaponDefs overrides the heuristic family of the listed weapons.
  -->
  <Helodrace.Ballistics.StanceProfileDef>
    <defName>HD_Stance_Unarmed</defName>
    <label>unarmed and melee</label>
    <family>Unarmed</family>
  </Helodrace.Ballistics.StanceProfileDef>

  <Helodrace.Ballistics.StanceProfileDef>
    <defName>HD_Stance_Pistol</defName>
    <label>pistol</label>
    <family>Pistol</family>
    <torsoOffsetDegrees>0</torsoOffsetDegrees>
  </Helodrace.Ballistics.StanceProfileDef>

  <Helodrace.Ballistics.StanceProfileDef>
    <defName>HD_Stance_Shotgun</defName>
    <label>shotgun</label>
    <family>Shotgun</family>
    <torsoOffsetDegrees>25</torsoOffsetDegrees>
  </Helodrace.Ballistics.StanceProfileDef>

  <Helodrace.Ballistics.StanceProfileDef>
    <defName>HD_Stance_Rifle</defName>
    <label>rifle</label>
    <family>Rifle</family>
    <torsoOffsetDegrees>20</torsoOffsetDegrees>
  </Helodrace.Ballistics.StanceProfileDef>

  <Helodrace.Ballistics.StanceProfileDef>
    <defName>HD_Stance_Sniper</defName>
    <label>precision rifle</label>
    <family>Sniper</family>
    <torsoOffsetDegrees>25</torsoOffsetDegrees>
  </Helodrace.Ballistics.StanceProfileDef>

  <Helodrace.Ballistics.StanceProfileDef>
    <defName>HD_Stance_MachineGun</defName>
    <label>machine gun</label>
    <family>MachineGun</family>
    <torsoOffsetDegrees>15</torsoOffsetDegrees>
  </Helodrace.Ballistics.StanceProfileDef>

  <Helodrace.Ballistics.StanceProfileDef>
    <defName>HD_Stance_Launcher</defName>
    <label>launcher</label>
    <family>Launcher</family>
    <torsoOffsetDegrees>30</torsoOffsetDegrees>
    <!-- Its guided missile is not a Projectile_Explosive subclass, so the heuristic would call it a rifle. -->
    <weaponDefs><li>HD_Gun_M47_Dragon</li></weaponDefs>
  </Helodrace.Ballistics.StanceProfileDef>
</Defs>
