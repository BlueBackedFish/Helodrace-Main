<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Crazed visor (Docs/Ballistic_Protection_System.md 6.5, phase 11): sight loss 0.35 x severity. [game] -->
  <HediffDef>
    <defName>HD_VisorCrazed</defName>
    <label>crazed visor</label>
    <description>The transparent face protection is starred and cracked where rounds struck it, clouding the wearer's view. It clears when the visor is taken off.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.7, 0.8, 0.9)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <initialSeverity>0.001</initialSeverity>
    <comps>
      <li Class="Helodrace.Ballistics.HediffCompProperties_VisorCrazed" />
    </comps>
    <stages>
      <li>
        <label>starred</label>
        <capMods><li><capacity>Sight</capacity><offset>-0.05</offset></li></capMods>
      </li>
      <li>
        <minSeverity>0.25</minSeverity>
        <label>cracked</label>
        <capMods><li><capacity>Sight</capacity><offset>-0.09</offset></li></capMods>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>clouded</label>
        <capMods><li><capacity>Sight</capacity><offset>-0.18</offset></li></capMods>
      </li>
      <li>
        <minSeverity>0.75</minSeverity>
        <label>opaque in places</label>
        <capMods><li><capacity>Sight</capacity><offset>-0.26</offset></li></capMods>
      </li>
      <li>
        <minSeverity>1</minSeverity>
        <label>shattered</label>
        <capMods><li><capacity>Sight</capacity><offset>-0.35</offset></li></capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
