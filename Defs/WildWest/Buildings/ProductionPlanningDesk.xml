<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>HD_ProductionPlanningDesk</defName>
    <label>production planning desk</label>
    <description>A planning desk for setting shared target stocks of Helod resources and intermediate parts and charting how each one is made. It adds production bills to the appropriate existing machines. It needs no operator or power; workers still make and haul every item.</description>
    <thingClass>Helodrace.Building_ProductionPlanningDesk</thingClass>
    <graphicData><texPath>Buildings/HD_ProductionPlanningDesk</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>(3,3)</drawSize>
      <drawOffset>(0,0,-0.182008177)</drawOffset><shaderType>CutoutComplex</shaderType></graphicData>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories><li>BuildingsProduction</li></thingCategories>
    <altitudeLayer>Building</altitudeLayer><passability>PassThroughOnly</passability><fillPercent>0.5</fillPercent><pathCost>50</pathCost>
    <statBases><MaxHitPoints>150</MaxHitPoints><WorkToBuild>1200</WorkToBuild><Mass>25</Mass><Flammability>1.0</Flammability></statBases>
    <stuffCategories><li>Woody</li><li>Metallic</li></stuffCategories><costStuffCount>50</costStuffCount>
    <size>(2,1)</size><rotatable>true</rotatable><surfaceType>Item</surfaceType>
    <designationCategory>HD_HelodTechnology_Build</designationCategory><uiOrder>1951</uiOrder><constructionSkillPrerequisite>2</constructionSkillPrerequisite>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded><researchPrerequisites><li>HelodFrontierSpirit</li></researchPrerequisites>
  </ThingDef>
</Defs>
