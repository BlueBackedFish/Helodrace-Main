<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>HD_Radio</defName>
    <label>radio</label>
    <description>A wireless terminal for LOW Helod company services and HAM frequencies, used for company contacts, radio conversations and broadcast listening.</description>
    <thingClass>Helodrace.Building_Radio</thingClass>
    <graphicData>
      <texPath>Buildings/HD_Radio</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <!-- Compensate camera headroom and center the desktop surface. -->
      <drawSize>(1.5,1.5)</drawSize>
      <drawOffset>(0,0,-0.074457139)</drawOffset>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <size>(1,1)</size>
    <specialDisplayRadius>4</specialDisplayRadius>
    <rotatable>true</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <fillPercent>0.4</fillPercent>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <socialPropernessMatters>true</socialPropernessMatters>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>3000</WorkToBuild>
      <Mass>12</Mass>
      <Flammability>0.5</Flammability>
      <JoyGainFactor>1.1</JoyGainFactor>
    </statBases>
    <costList>
      <Steel>40</Steel>
      <HD_BasicElectronicComponents>4</HD_BasicElectronicComponents>
    </costList>
    <comps>
      <li Class="Helodrace.CompProperties_TelegraphTable">
        <wireless>true</wireless>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>80</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
    </comps>
    <building>
      <joyKind>Television</joyKind>
    </building>
    <designationCategory>HD_HelodTechnology_Build</designationCategory>
    <uiOrder>2460</uiOrder>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <researchPrerequisites>
      <li>HelodWireless</li>
    </researchPrerequisites>
    <modExtensions><li Class="Helodrace.ContentUsageExtension"><helpKey>HD_ContentUsage_HD_Radio</helpKey></li></modExtensions>
  </ThingDef>
</Defs>
