<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>HD_Radio</defName>
    <label>radio</label>
    <description>An upgraded wireless terminal for all LOW Helod company services, including caravan requests, loans, forward-base contracts and security. Power replaces wired installation and primary cells, with frequencies available around the clock. Colonists can also chat with LOW and HIGH HAM operators or listen to broadcasts during recreation.</description>
    <thingClass>Helodrace.Building_Radio</thingClass>
    <graphicData>
      <texPath>Buildings/HD_Radio</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <!-- Half the milling machine's 3x3 graphic, with its default zero offset. -->
      <drawSize>(1.5,1.5)</drawSize>
      <drawOffset>(0,0,0)</drawOffset>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <size>(1,1)</size>
    <specialDisplayRadius>4</specialDisplayRadius>
    <rotatable>true</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <fillPercent>0.4</fillPercent>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <socialPropernessMatters>true</socialPropernessMatters>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>3000</WorkToBuild>
      <Mass>12</Mass>
      <Flammability>0.5</Flammability>
      <JoyGainFactor>1.1</JoyGainFactor>
    </statBases>
    <costList>
      <Steel>40</Steel>
      <HD_BasicElectricalComponents>4</HD_BasicElectricalComponents>
    </costList>
    <comps>
      <li Class="Helodrace.CompProperties_TelegraphTable">
        <wireless>true</wireless>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>80</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
    </comps>
    <building>
      <joyKind>Television</joyKind>
    </building>
    <designationCategory>Joy</designationCategory>
    <uiOrder>2460</uiOrder>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <researchPrerequisites>
      <li>HelodWireless</li>
    </researchPrerequisites>
  </ThingDef>
</Defs>
