<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BaseMeleeWeapon_Blunt">
    <defName>HD_WoodenBaseballBat</defName>
    <label>wooden baseball bat</label>
    <description>A carefully shaped wooden bat made for baseball. Its balance makes it quick to swing, and its heavy barrel makes it an effective improvised weapon.</description>
    <graphicData>
      <texPath>Items/HD_WoodenBat</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <uiIconScale>1.1</uiIconScale>
    <techLevel>Industrial</techLevel>
    <costStuffCount>30</costStuffCount>
    <statBases>
      <WorkToMake>1800</WorkToMake>
      <Mass>0.95</Mass>
    </statBases>
    <equippedAngleOffset>0</equippedAngleOffset>
    <stuffCategories>
      <li>Woody</li>
    </stuffCategories>
    <comps>
      <li>
        <compClass>CompQuality</compClass>
      </li>
      <li Class="CompProperties_Art">
        <nameMaker>NamerArtWeaponMelee</nameMaker>
        <descriptionMaker>ArtDescription_WeaponMelee</descriptionMaker>
        <minQualityForArtistic>Excellent</minQualityForArtistic>
      </li>
    </comps>
    <recipeMaker>
      <researchPrerequisite>HelodGreatWarTech</researchPrerequisite>
      <recipeUsers>
        <li>HD_TreadleLathe</li>
        <li>HD_LineShaftTurretLathe</li>
      </recipeUsers>
      <displayPriority>310</displayPriority>
    </recipeMaker>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>7</power>
        <cooldownTime>1.7</cooldownTime>
      </li>
      <li>
        <label>striking surface</label>
        <labelUsedInLogging>false</labelUsedInLogging>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>14</power>
        <cooldownTime>1.8</cooldownTime>
      </li>
    </tools>
  </ThingDef>

  <ThingDef ParentName="BaseMeleeWeapon_Blunt_Quality">
    <defName>HD_MetalBaseballBat</defName>
    <label>metal baseball bat</label>
    <description>A hollow metal baseball bat with a wrapped grip. It is slightly heavier and hits harder than its wooden counterpart without becoming unwieldy.</description>
    <graphicData>
      <texPath>Items/HD_MetalBat</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <uiIconScale>1.1</uiIconScale>
    <techLevel>Industrial</techLevel>
    <costStuffCount>35</costStuffCount>
    <statBases>
      <WorkToMake>3600</WorkToMake>
      <Mass>1.1</Mass>
    </statBases>
    <equippedAngleOffset>0</equippedAngleOffset>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <recipeMaker>
      <recipeUsers>
        <li>HD_LineShaftRollingMachine</li>
      </recipeUsers>
      <researchPrerequisite>HelodGreatWarTech</researchPrerequisite>
      <skillRequirements>
        <Crafting>3</Crafting>
      </skillRequirements>
      <displayPriority>410</displayPriority>
    </recipeMaker>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>1.7</cooldownTime>
      </li>
      <li>
        <label>striking surface</label>
        <labelUsedInLogging>false</labelUsedInLogging>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>16</power>
        <cooldownTime>1.85</cooldownTime>
      </li>
    </tools>
  </ThingDef>

</Defs>
