<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Either complete path satisfies the link. Every entry within a side is required.
       FinishProject also completes prerequisites; see Docs/LinkedResearch.md. -->

  <!-- Vanilla electricity starts at thermionic electronics, machining at numerical
       control, and microelectronics at transistors. Descendant links retain these
       milestones so FinishProject cannot complete a later prerequisite too early. -->

  <!-- Foundations and industrial infrastructure. -->
  <Helodrace.ResearchLinkDef>
    <defName>HD_Link_FrontierFoundations</defName>
    <leftProjects>
      <li>ComplexFurniture</li>
      <li>Smithing</li>
      <li>ComplexClothing</li>
    </leftProjects>
    <rightProjects><li>HelodFrontierSpirit</li></rightProjects>
  </Helodrace.ResearchLinkDef>

  <Helodrace.ResearchLinkDef>
    <defName>HD_Link_Electricity</defName>
    <leftProjects><li>Electricity</li></leftProjects>
    <rightProjects>
      <li>HelodHighElectronics</li>
    </rightProjects>
  </Helodrace.ResearchLinkDef>

  <Helodrace.ResearchLinkDef>
    <defName>HD_Link_Machining</defName>
    <leftProjects><li>Machining</li></leftProjects>
    <rightProjects>
      <li>HelodNumericalControl</li>
    </rightProjects>
  </Helodrace.ResearchLinkDef>

  <Helodrace.ResearchLinkDef>
    <defName>HD_Link_AirConditioning</defName>
    <leftProjects><li>AirConditioning</li></leftProjects>
    <rightProjects>
      <li>HelodHeatPump</li>
      <li>HelodHighElectronics</li>
    </rightProjects>
  </Helodrace.ResearchLinkDef>

  <Helodrace.ResearchLinkDef>
    <defName>HD_Link_Microelectronics</defName>
    <leftProjects><li>MicroelectronicsBasics</li></leftProjects>
    <rightProjects><li>HelodTransistor</li></rightProjects>
  </Helodrace.ResearchLinkDef>

  <Helodrace.ResearchLinkDef>
    <defName>HD_Link_TubeTelevision</defName>
    <leftProjects><li>TubeTelevision</li></leftProjects>
    <rightProjects><li>HelodWireless</li></rightProjects>
  </Helodrace.ResearchLinkDef>

  <!-- Deep drilling follows microelectronics, so the transistor milestone stays on the Helod side. -->
  <Helodrace.ResearchLinkDef>
    <defName>HD_Link_DeepDrilling</defName>
    <leftProjects><li>DeepDrilling</li></leftProjects>
    <rightProjects>
      <li>HelodHighOilDevelopment</li>
      <li>HelodTransistor</li>
    </rightProjects>
  </Helodrace.ResearchLinkDef>

  <!-- Chemistry and medicine. -->
  <Helodrace.ResearchLinkDef>
    <defName>HD_Link_DrugProduction</defName>
    <leftProjects><li>DrugProduction</li></leftProjects>
    <rightProjects><li>HelodIngredientExtraction</li></rightProjects>
  </Helodrace.ResearchLinkDef>

  <Helodrace.ResearchLinkDef>
    <defName>HD_Link_MedicineProduction</defName>
    <leftProjects><li>MedicineProduction</li></leftProjects>
    <rightProjects>
      <li>HelodTotalSynthesisMedicine</li>
      <li>HelodTransistor</li>
    </rightProjects>
  </Helodrace.ResearchLinkDef>

  <Helodrace.ResearchLinkDef>
    <defName>HD_Link_SterileMaterials</defName>
    <leftProjects><li>SterileMaterials</li></leftProjects>
    <rightProjects>
      <li>HelodFirstAid</li>
      <li>HelodHighElectronics</li>
    </rightProjects>
  </Helodrace.ResearchLinkDef>

  <!-- Biotech only. The whole link is skipped without Biotech, so neither side is left empty. -->
  <Helodrace.ResearchLinkDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>HD_Link_ToxGas</defName>
    <leftProjects><li>ToxGas</li></leftProjects>
    <rightProjects>
      <li>HelodChokingAgent</li>
      <li>HelodNumericalControl</li>
    </rightProjects>
  </Helodrace.ResearchLinkDef>

  <!-- Infantry weapons, artillery and protection. -->
  <Helodrace.ResearchLinkDef>
    <defName>HD_Link_Gunsmithing</defName>
    <leftProjects><li>Gunsmithing</li></leftProjects>
    <rightProjects>
      <li>HelodBoltAction</li>
      <li>HelodNumericalControl</li>
    </rightProjects>
  </Helodrace.ResearchLinkDef>

  <Helodrace.ResearchLinkDef>
    <defName>HD_Link_BlowbackOperation</defName>
    <leftProjects><li>BlowbackOperation</li></leftProjects>
    <rightProjects>
      <li>HelodSamiAutomaticPistol</li>
      <li>HelodNumericalControl</li>
    </rightProjects>
  </Helodrace.ResearchLinkDef>

  <Helodrace.ResearchLinkDef>
    <defName>HD_Link_GasOperation</defName>
    <leftProjects><li>GasOperation</li></leftProjects>
    <rightProjects>
      <li>HelodBasicModernRifle</li>
      <li>HelodHighMachineGun</li>
      <li>HelodNumericalControl</li>
    </rightProjects>
  </Helodrace.ResearchLinkDef>

  <Helodrace.ResearchLinkDef>
    <defName>HD_Link_PrecisionRifling</defName>
    <leftProjects><li>PrecisionRifling</li></leftProjects>
    <rightProjects>
      <li>HelodSniperRifle</li>
      <li>HelodLowAutomaticRifle</li>
      <li>HelodNumericalControl</li>
      <li>HelodTransistor</li>
    </rightProjects>
  </Helodrace.ResearchLinkDef>

  <Helodrace.ResearchLinkDef>
    <defName>HD_Link_Mortars</defName>
    <leftProjects><li>Mortars</li></leftProjects>
    <rightProjects>
      <li>HelodLowLightArtillery</li>
      <li>HelodNumericalControl</li>
    </rightProjects>
  </Helodrace.ResearchLinkDef>

  <Helodrace.ResearchLinkDef>
    <defName>HD_Link_FlakArmor</defName>
    <leftProjects><li>FlakArmor</li></leftProjects>
    <rightProjects>
      <li>HelodFlakJacket</li>
      <li>HelodNumericalControl</li>
    </rightProjects>
  </Helodrace.ResearchLinkDef>

  <Helodrace.ResearchLinkDef>
    <defName>HD_Link_MultibarrelWeapons</defName>
    <leftProjects><li>MultibarrelWeapons</li></leftProjects>
    <rightProjects>
      <li>HelodAntiAirMachineGun</li>
      <li>HelodTransistor</li>
    </rightProjects>
  </Helodrace.ResearchLinkDef>

</Defs>
