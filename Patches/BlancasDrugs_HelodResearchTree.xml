<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Helod race - Blanca's Drugs</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- Cola: Frontier Spirit -->
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="BD_Cola"]/recipeMaker/researchPrerequisite</xpath>
          <value>
            <researchPrerequisite>HelodFrontierSpirit</researchPrerequisite>
          </value>
        </li>

        <!-- Cocaine cola and laudanum: Ingredient Extraction -->
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="BD_CocaineCola"]/recipeMaker/researchPrerequisite</xpath>
          <value>
            <researchPrerequisite>HelodIngredientExtraction</researchPrerequisite>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="BD_Laudanum"]/recipeMaker/researchPrerequisite</xpath>
          <value>
            <researchPrerequisite>HelodIngredientExtraction</researchPrerequisite>
          </value>
        </li>

        <!-- Remaining drugs except MKultra, morphine, fentanyl, modafinil, and sonata: Total Synthesis Medicine -->
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="BD_Desoxyn"]/recipeMaker/researchPrerequisite</xpath>
          <value>
            <researchPrerequisite>HelodTotalSynthesisMedicine</researchPrerequisite>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="BD_Benzedrine"]/recipeMaker/researchPrerequisite</xpath>
          <value>
            <researchPrerequisite>HelodTotalSynthesisMedicine</researchPrerequisite>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="BD_Dexedrine"]/recipeMaker/researchPrerequisite</xpath>
          <value>
            <researchPrerequisite>HelodTotalSynthesisMedicine</researchPrerequisite>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="BD_Ketamine"]/recipeMaker/researchPrerequisite</xpath>
          <value>
            <researchPrerequisite>HelodTotalSynthesisMedicine</researchPrerequisite>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="BD_Ambien"]/recipeMaker/researchPrerequisite</xpath>
          <value>
            <researchPrerequisite>HelodTotalSynthesisMedicine</researchPrerequisite>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="BD_Restoril"]/recipeMaker/researchPrerequisite</xpath>
          <value>
            <researchPrerequisite>HelodTotalSynthesisMedicine</researchPrerequisite>
          </value>
        </li>

        <!-- Total-synthesis drugs use aromatic base oil instead of neutroamine. -->
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="BD_Desoxyn"]/costList/Neutroamine</xpath>
          <value>
            <HD_AromaticBaseOil>2</HD_AromaticBaseOil>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="BD_Benzedrine"]/costList/Neutroamine</xpath>
          <value>
            <HD_AromaticBaseOil>2</HD_AromaticBaseOil>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="BD_Dexedrine"]/costList/Neutroamine</xpath>
          <value>
            <HD_AromaticBaseOil>2</HD_AromaticBaseOil>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="BD_Ketamine"]/costList/Neutroamine</xpath>
          <value>
            <HD_AromaticBaseOil>4</HD_AromaticBaseOil>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="BD_Ambien"]/costList/Neutroamine</xpath>
          <value>
            <HD_AromaticBaseOil>2</HD_AromaticBaseOil>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="BD_Restoril"]/costList/Neutroamine</xpath>
          <value>
            <HD_AromaticBaseOil>3</HD_AromaticBaseOil>
          </value>
        </li>

        <!-- Total-synthesis drugs are produced exclusively in the stirred-tank reactor. -->
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="BD_Desoxyn"]/recipeMaker/recipeUsers</xpath>
          <value>
            <recipeUsers>
              <li>HD_StirredTankReactor</li>
            </recipeUsers>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="BD_Benzedrine"]/recipeMaker/recipeUsers</xpath>
          <value>
            <recipeUsers>
              <li>HD_StirredTankReactor</li>
            </recipeUsers>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="BD_Dexedrine"]/recipeMaker/recipeUsers</xpath>
          <value>
            <recipeUsers>
              <li>HD_StirredTankReactor</li>
            </recipeUsers>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="BD_Ketamine"]/recipeMaker/recipeUsers</xpath>
          <value>
            <recipeUsers>
              <li>HD_StirredTankReactor</li>
            </recipeUsers>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="BD_Ambien"]/recipeMaker/recipeUsers</xpath>
          <value>
            <recipeUsers>
              <li>HD_StirredTankReactor</li>
            </recipeUsers>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="BD_Restoril"]/recipeMaker/recipeUsers</xpath>
          <value>
            <recipeUsers>
              <li>HD_StirredTankReactor</li>
            </recipeUsers>
          </value>
        </li>

        <!-- Assign the generated recipes to the crafting work type. -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="BD_Desoxyn"]/recipeMaker</xpath>
          <value>
            <requiredGiverWorkType>Crafting</requiredGiverWorkType>
          </value>
        </li>

        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="BD_Benzedrine"]/recipeMaker</xpath>
          <value>
            <requiredGiverWorkType>Crafting</requiredGiverWorkType>
          </value>
        </li>

        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="BD_Dexedrine"]/recipeMaker</xpath>
          <value>
            <requiredGiverWorkType>Crafting</requiredGiverWorkType>
          </value>
        </li>

        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="BD_Ketamine"]/recipeMaker</xpath>
          <value>
            <requiredGiverWorkType>Crafting</requiredGiverWorkType>
          </value>
        </li>

        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="BD_Ambien"]/recipeMaker</xpath>
          <value>
            <requiredGiverWorkType>Crafting</requiredGiverWorkType>
          </value>
        </li>

        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="BD_Restoril"]/recipeMaker</xpath>
          <value>
            <requiredGiverWorkType>Crafting</requiredGiverWorkType>
          </value>
        </li>

        <!-- Align Blanca's optional branch with the medicine and chemistry lanes. -->
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ResearchProjectDef[defName="BD_HelodBlancaEarlyNarcotics"]/researchViewX</xpath>
          <value>
            <researchViewX>14.62</researchViewX>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ResearchProjectDef[defName="BD_HelodBlancaEarlyNarcotics"]/researchViewY</xpath>
          <value>
            <researchViewY>3.68</researchViewY>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ResearchProjectDef[defName="BD_HelodBlancaAdvancedPainkillers"]/researchViewX</xpath>
          <value>
            <researchViewX>15.48</researchViewX>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ResearchProjectDef[defName="BD_HelodBlancaAdvancedPainkillers"]/researchViewY</xpath>
          <value>
            <researchViewY>2.96</researchViewY>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ResearchProjectDef[defName="BD_HelodBlancaAdvancedStimulants"]/researchViewX</xpath>
          <value>
            <researchViewX>15.48</researchViewX>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ResearchProjectDef[defName="BD_HelodBlancaAdvancedStimulants"]/researchViewY</xpath>
          <value>
            <researchViewY>3.68</researchViewY>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ResearchProjectDef[defName="BD_HelodBlancaAdvancedSomnifacients"]/researchViewX</xpath>
          <value>
            <researchViewX>15.48</researchViewX>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ResearchProjectDef[defName="BD_HelodBlancaAdvancedSomnifacients"]/researchViewY</xpath>
          <value>
            <researchViewY>4.4</researchViewY>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ResearchProjectDef[defName="BD_HelodBlancaMKultraProject"]/researchViewX</xpath>
          <value>
            <researchViewX>16.34</researchViewX>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ResearchProjectDef[defName="BD_HelodBlancaMKultraProject"]/researchViewY</xpath>
          <value>
            <researchViewY>3.68</researchViewY>
          </value>
        </li>
      </operations>
    </match>
  </Operation>

</Patch>
