              <painFactor>1.03</painFactor>
              <vomitMtbDays>5</vomitMtbDays>
              <socialFightChanceFactor>1.3</socialFightChanceFactor>
              <hungerRateFactorOffset>0.12</hungerRateFactorOffset>
              <statOffsets><RestFallRateFactor>0.6</RestFallRateFactor><MentalBreakThreshold>0.03</MentalBreakThreshold></statOffsets>
              <capMods><li><capacity>Consciousness</capacity><offset>-0.03</offset></li><li><capacity>Sight</capacity><offset>-0.02</offset></li><li><capacity>Moving</capacity><offset>-0.02</offset></li><li><capacity>Manipulation</capacity><offset>-0.02</offset></li></capMods>
            </li>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/HediffDef[defName="BD_CocaineColaCrash"]/comps/li[@Class="HediffCompProperties_RemoveIfOtherHediff"]/stages</xpath>
