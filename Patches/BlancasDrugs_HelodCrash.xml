<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Helod metabolize a stimulant crash through BTX: the crash hediff switches to its added
       stage 1 for the Helod race (weak penalties, matching crash thought stage) and drains the
       BTX need while it lasts. Other pawns never use stage 1. Deep sleep still ends both stages. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Helod race - Blanca's Drugs</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- Desoxyn: Helod crash keeps 20% of the penalties and burns BTX instead. -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/HediffDef[defName="BD_DesoxynCrash"]/stages</xpath>
          <value>
            <li>
              <label>BTX burn</label>
              <!-- Only for vanilla stage ordering; Blancas never selects this stage by severity. -->
              <minSeverity>1</minSeverity>
              <painFactor>1.1</painFactor>
              <vomitMtbDays>3.75</vomitMtbDays>
              <socialFightChanceFactor>1.8</socialFightChanceFactor>
              <hungerRateFactorOffset>0.2</hungerRateFactorOffset>
              <statOffsets><RestFallRateFactor>0.8</RestFallRateFactor><MentalBreakThreshold>0.08</MentalBreakThreshold></statOffsets>
              <capMods><li><capacity>Consciousness</capacity><offset>-0.06</offset></li><li><capacity>Sight</capacity><offset>-0.04</offset></li><li><capacity>Moving</capacity><offset>-0.04</offset></li><li><capacity>Manipulation</capacity><offset>-0.04</offset></li></capMods>
            </li>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/HediffDef[defName="BD_DesoxynCrash"]/comps/li[@Class="HediffCompProperties_RemoveIfOtherHediff"]/stages</xpath>
          <value><stages>0~1</stages></value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>/Defs/HediffDef[defName="BD_DesoxynCrash"]</xpath>
          <value>
            <li Class="HelodBlancasDrug.DrugCrashVariants">
              <variants>
                <li>
                  <races><li>Helod</li></races>
                  <stage>1</stage>
                  <need>Chemical_BTX</need>
                  <needFallPerDay>0.3125</needFallPerDay>
                  <descriptionKey>HD_BlancasCrash_HelodNote</descriptionKey>
                </li>
              </variants>
            </li>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThoughtDef[defName="BD_DesoxynCrashThought"]/stages</xpath>
          <value>
            <li>
              <label>BTX burn after Desoxyn</label>
              <description>The Desoxyn is wearing off, but my body is burning through BTX instead of crashing. I need a refill soon.</description>
              <baseMoodEffect>-6</baseMoodEffect>
            </li>
          </value>
        </li>
        <!-- Benzedrine: Helod crash keeps 20% of the penalties and burns BTX instead. -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/HediffDef[defName="BD_BenzedrineCrash"]/stages</xpath>
          <value>
            <li>
              <label>BTX burn</label>
              <!-- Only for vanilla stage ordering; Blancas never selects this stage by severity. -->
              <minSeverity>1</minSeverity>
              <painFactor>1.04</painFactor>
              <vomitMtbDays>5</vomitMtbDays>
              <socialFightChanceFactor>1.4</socialFightChanceFactor>
              <hungerRateFactorOffset>0.14</hungerRateFactorOffset>
              <statOffsets><RestFallRateFactor>0.6</RestFallRateFactor><MentalBreakThreshold>0.04</MentalBreakThreshold></statOffsets>
              <capMods><li><capacity>Consciousness</capacity><offset>-0.03</offset></li><li><capacity>Sight</capacity><offset>-0.03</offset></li><li><capacity>Moving</capacity><offset>-0.03</offset></li><li><capacity>Manipulation</capacity><offset>-0.03</offset></li></capMods>
            </li>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/HediffDef[defName="BD_BenzedrineCrash"]/comps/li[@Class="HediffCompProperties_RemoveIfOtherHediff"]/stages</xpath>
          <value><stages>0~1</stages></value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>/Defs/HediffDef[defName="BD_BenzedrineCrash"]</xpath>
          <value>
            <li Class="HelodBlancasDrug.DrugCrashVariants">
              <variants>
                <li>
                  <races><li>Helod</li></races>
                  <stage>1</stage>
                  <need>Chemical_BTX</need>
                  <needFallPerDay>0.375</needFallPerDay>
                  <descriptionKey>HD_BlancasCrash_HelodNote</descriptionKey>
                </li>
              </variants>
            </li>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThoughtDef[defName="BD_BenzedrineCrashThought"]/stages</xpath>
          <value>
            <li>
              <label>BTX burn after Benzedrine</label>
