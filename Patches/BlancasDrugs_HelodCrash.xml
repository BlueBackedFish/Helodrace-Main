              <hungerRateFactorOffset>0.14</hungerRateFactorOffset>
              <statOffsets><RestFallRateFactor>0.6</RestFallRateFactor><MentalBreakThreshold>0.01</MentalBreakThreshold></statOffsets>
              <capMods><li><capacity>Consciousness</capacity><offset>-0.02</offset></li><li><capacity>Sight</capacity><offset>-0.03</offset></li><li><capacity>Moving</capacity><offset>-0.03</offset></li><li><capacity>Manipulation</capacity><offset>-0.03</offset></li></capMods>
            </li>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/HediffDef[defName="BD_DexedrineCrash"]/comps/li[@Class="HediffCompProperties_RemoveIfOtherHediff"]/stages</xpath>
          <value><stages>0~1</stages></value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>/Defs/HediffDef[defName="BD_DexedrineCrash"]</xpath>
          <value>
            <li Class="HelodBlancasDrug.DrugCrashVariants">
