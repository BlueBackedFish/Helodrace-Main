        <li Class="PatchOperationAddModExtension">
          <xpath>/Defs/HediffDef[defName="BD_CocaineColaCrash"]</xpath>
          <value>
            <li Class="HelodBlancasDrug.DrugCrashVariants">
              <variants>
                <li>
                  <races><li>Helod</li></races>
                  <stage>1</stage>
                  <need>Chemical_BTX</need>
                  <needFallPerDay>0.375</needFallPerDay>
                  <descriptionKey>HD_BlancasCrash_HelodNote</descriptionKey>
                </li>
              </variants>
            </li>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThoughtDef[defName="BD_CocaineColaCrashThought"]/stages</xpath>
          <value>
            <li>
              <label>BTX burn after cocaine cola</label>
              <description>The cocaine cola is wearing off, but my body is burning through BTX instead of crashing. I need a refill soon.</description>
              <baseMoodEffect>-1</baseMoodEffect>
            </li>
          </value>
        </li>
        <!-- Modafinil: Helod crash keeps 20% of the penalties and burns BTX instead. -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/HediffDef[defName="BD_ModafinilCrash"]/stages</xpath>
          <value>
            <li>
              <label>BTX burn</label>
              <!-- Only for vanilla stage ordering; Blancas never selects this stage by severity. -->
              <minSeverity>1</minSeverity>
              <painFactor>1.01</painFactor>
              <vomitMtbDays>10</vomitMtbDays>
              <hungerRateFactorOffset>0.01</hungerRateFactorOffset>
              <statOffsets><RestFallRateFactor>0.3</RestFallRateFactor></statOffsets>
              <capMods><li><capacity>Consciousness</capacity><offset>-0.01</offset></li><li><capacity>Sight</capacity><offset>-0.02</offset></li><li><capacity>Moving</capacity><offset>-0.02</offset></li><li><capacity>Manipulation</capacity><offset>-0.02</offset></li></capMods>
            </li>
